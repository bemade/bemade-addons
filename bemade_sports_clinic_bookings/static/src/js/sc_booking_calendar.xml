<?xml version="1.0" encoding="UTF-8"?>
<!-- Task 1737 — see sc_booking_calendar.js. Cancel, then the pencil, then
     the details' close button. -->
<templates xml:space="preserve">
    <t t-inherit="bemade_sports_clinic.ScCalendar" t-inherit-mode="extension">
        <xpath expr="//div[@data-sc-calendar-detail='1']/div[hasclass('o_sc_card_head')]/button" position="before">
            <span t-if="state.selected.editUrl or state.selected.cancelUrl" class="o_sc_booking_detail_actions">
                <a t-if="state.selected.cancelUrl" t-att-href="state.selected.cancelUrl" class="o_sc_icon_btn"
                   data-sc-action="booking.cancel" t-att-aria-label="scBookingCancelLabel" t-att-title="scBookingCancelLabel">
                    <svg viewBox="0 0 24 24" class="o_sc_icon" aria-hidden="true" focusable="false"><path d="M21 8v13H3V8"/><path d="M1 3h22v5H1z"/><path d="M10 12h4"/></svg>
                </a>
                <a t-if="state.selected.editUrl" t-att-href="state.selected.editUrl" class="o_sc_icon_btn"
                   data-sc-action="booking.edit" t-att-aria-label="scBookingEditLabel" t-att-title="scBookingEditLabel">
                    <svg viewBox="0 0 24 24" class="o_sc_icon" aria-hidden="true" focusable="false"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
                </a>
            </span>
        </xpath>
    </t>
</templates>
