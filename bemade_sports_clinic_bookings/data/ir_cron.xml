<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Task 1734: the daily booking summary. Runs every 30 min; each staff
         member in « Daily summary » mode gets it once a day, from 06:30 in
         their own time zone (DST-proof). -->
    <record id="ir_cron_sc_booking_digest" model="ir.cron">
        <field name="name">Bookings: daily summary to staff</field>
        <field name="model_id" ref="base.model_res_users"/>
        <field name="state">code</field>
        <field name="code">model._sc_booking_digest_cron()</field>
        <field name="interval_number">30</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
