<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Catégorie de sécurité pour les commandes vendeur -->
        <record id="module_category_vendor_orders" model="ir.module.category">
            <field name="name">Commandes Vendeur</field>
            <field name="description">Gestion des commandes pour les vendeurs</field>
            <field name="sequence">20</field>
        </record>

        <!-- Groupe pour les utilisateurs vendeur -->
        <record id="group_vendor_order_user" model="res.groups">
            <field name="name">Utilisateur</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Groupe pour les gestionnaires des commandes vendeur -->
        <record id="group_vendor_order_manager" model="res.groups">
            <field name="name">Gestionnaire</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
