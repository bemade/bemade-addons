<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- This template adds the preamble as a cover page before the main document.
         It is printed in every state: once an order is confirmed the preamble is
         the scope of work the customer agreed to, so it stays part of the record. -->
    <template
    id="report_saleorder_document_preamble"
    inherit_id="sale.report_saleorder_document"
  >
        <xpath expr="//t[@t-call='web.external_layout']" position="before">
            <t t-if="not is_html_empty(doc.preamble)">
                <div class="article" style="page-break-after: always;">
                    <div class="mt-4 mb-4">
                        <span t-field="doc.preamble" />
                    </div>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
