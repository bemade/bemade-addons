<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Tâche planifiée pour traiter la file d'attente de synchronisation -->
        <record id="ir_cron_process_sync_queue" model="ir.cron">
            <field name="name">Bemade: Traiter la file d'attente de synchronisation</field>
            <field name="model_id" ref="model_odoo_to_bemade_sync_queue"/>
            <field name="state">code</field>
            <field name="code">model.process_queue(limit=100)</field>
            <field name="interval_number">10</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
        </record>

        <!-- Tâche planifiée pour nettoyer les journaux de synchronisation -->
        <record id="ir_cron_clean_sync_logs" model="ir.cron">
            <field name="name">Bemade: Nettoyer les anciens journaux de synchronisation</field>
            <field name="model_id" ref="model_odoo_to_bemade_sync_log"/>
            <field name="state">code</field>
            <field name="code">model.clean_old_logs(days=30)</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
        </record>

        <!-- Tâche planifiée pour vérifier les connexions aux instances -->
        <record id="ir_cron_check_instance_connections" model="ir.cron">
            <field name="name">Bemade: Vérifier les connexions aux instances</field>
            <field name="model_id" ref="model_odoo_to_bemade_instance"/>
            <field name="state">code</field>
            <field name="code">model.check_all_connections()</field>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
        </record>

        <!-- Tâche planifiée pour synchroniser les données critiques -->
        <record id="ir_cron_sync_critical_data" model="ir.cron">
            <field name="name">Bemade: Synchroniser les données critiques</field>
            <field name="model_id" ref="model_odoo_to_bemade_sync_model"/>
            <field name="state">code</field>
            <field name="code">model.sync_critical_models()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
