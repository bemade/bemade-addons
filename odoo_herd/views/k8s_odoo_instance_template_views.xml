<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- list View -->
    <record id="view_k8s_odoo_instance_template_list" model="ir.ui.view">
        <field name="name">k8s.odoo.instance.template.list</field>
        <field name="model">k8s.odoo.instance.template</field>
        <field name="arch" type="xml">
            <list string="Odoo Instance Templates">
                <field name="name"/>
                <field name="image"/>
                <field name="replicas"/>
                <field name="filestore_size"/>
                <field name="cluster_issuer"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_k8s_odoo_instance_template_form" model="ir.ui.view">
        <field name="name">k8s.odoo.instance.template.form</field>
        <field name="model">k8s.odoo.instance.template</field>
        <field name="arch" type="xml">
            <form string="Odoo Instance Template">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="description"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Container" name="container">
                            <group>
                                <group string="Image">
                                    <field name="image"/>
                                    <field name="image_pull_secret"/>
                                </group>
                                <group string="Scaling">
                                    <field name="replicas"/>
                                </group>
                            </group>
                            <group>
                                <group string="Deployment Strategy">
                                    <field name="deployment_strategy_type" widget="radio"/>
                                </group>
                                <group string="Rolling Update Options" invisible="deployment_strategy_type != 'RollingUpdate'">
                                    <field name="rolling_update_max_unavailable" placeholder="e.g., 0, 25%"/>
                                    <field name="rolling_update_max_surge" placeholder="e.g., 1, 100%"/>
                                </group>
                            </group>
                        </page>
                        
                        <page string="Network" name="network">
                            <group>
                                <group>
                                    <field name="cluster_issuer"/>
                                </group>
                            </group>
                        </page>
                        
                        <page string="Database" name="database">
                            <group>
                                <group string="PostgreSQL Cluster">
                                    <field name="database_cluster" placeholder="Leave empty for default cluster"/>
                                </group>
                            </group>
                            <div class="text-muted small">
                                <i class="fa fa-info-circle"/> Name of the PostgreSQL cluster from the operator's postgres-clusters secret. Leave empty to use the default cluster.
                            </div>
                        </page>
                        
                        <page string="Storage" name="storage">
                            <group>
                                <group>
                                    <field name="filestore_size"/>
                                    <field name="filestore_storage_class"/>
                                </group>
                            </group>
                        </page>
                        
                        <page string="Resources" name="resources">
                            <group>
                                <group string="Requests">
                                    <field name="cpu_request"/>
                                    <field name="memory_request"/>
                                </group>
                                <group string="Limits">
                                    <field name="cpu_limit"/>
                                    <field name="memory_limit"/>
                                </group>
                            </group>
                        </page>
                        
                        <page string="Odoo Configuration" name="odoo_config">
                            <group>
                                <group>
                                    <field name="default_initialization_mode"/>
                                    <field name="default_install_demo_data"/>
                                </group>
                            </group>
                            <separator string="Additional Config Options (JSON)"/>
                            <field name="config_options" widget="code" options="{'mode': 'javascript'}" nolabel="1" placeholder='{"workers": 4, "max_cron_threads": 2}'/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_k8s_odoo_instance_template" model="ir.actions.act_window">
        <field name="name">Instance Templates</field>
        <field name="res_model">k8s.odoo.instance.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Odoo Instance Template
            </p>
            <p>
                Templates allow you to define reusable configurations for creating Odoo instances.
                Set default values for image, resources, storage, and more.
            </p>
        </field>
    </record>

</odoo>
