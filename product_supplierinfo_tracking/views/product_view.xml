<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Modification de la vue produit pour utiliser notre vue personnalisée -->
    <record id="product_supplierinfo_tree_view2_inherit" model="ir.ui.view">
        <field name="name">product.supplierinfo.tree.view2.inherit</field>
        <field name="inherit_id" ref="purchase.product_supplierinfo_tree_view2" />
        <field name="model">product.supplierinfo</field>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="open_form_view">True</attribute>
            </xpath>
        </field>
    </record>
</odoo>