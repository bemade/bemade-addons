<odoo>
    <record id="res_config_settings_view_form_phone_list" model="ir.ui.view">
        <field name="name">res.config.settings.form.phone.list</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <block name="contacts_setting_container" position="inside">
                <setting
          id="partner_phone_list_store_international"
          help="Format every number written to a contact (other apps, imports, scripts), e.g. 5145550101 becomes +1 514-555-0101. Forms always format on input."
        >
                    <field name="partner_phone_list_store_international" />
                </setting>
            </block>
        </field>
    </record>
</odoo>
