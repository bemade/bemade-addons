<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View for unifi.dns.config -->
    <record id="view_unifi_dns_config_list" model="ir.ui.view">
        <field name="name">unifi.dns.config.list</field>
        <field name="model">unifi.dns.config</field>
        <field name="arch" type="xml">
            <list string="DNS Configurations">
                <field name="site_id"/>
                <field name="enabled"/>
                <field name="filters_enabled"/>
                <field name="forwarding_enabled"/>
                <field name="mdns_enabled"/>
                <field name="custom_dns"/>
                <field name="last_sync"/>
            </list>
        </field>
    </record>

    <!-- Form View for unifi.dns.config -->
    <record id="view_unifi_dns_config_form" model="ir.ui.view">
        <field name="name">unifi.dns.config.form</field>
        <field name="model">unifi.dns.config</field>
        <field name="arch" type="xml">
            <form string="DNS Configuration">
                <header>
                    <button name="sync_from_unifi" string="Sync from UniFi" type="object" class="oe_highlight"/>
                    <button name="push_to_unifi" string="Push to UniFi" type="object" class="oe_highlight"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="site_id" placeholder="Site"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="enabled"/>
                            <field name="filters_enabled"/>
                            <field name="forwarding_enabled"/>
                            <field name="mdns_enabled"/>
                        </group>
                        <group>
                            <field name="custom_dns"/>
                            <field name="unifi_id"/>
                            <field name="last_sync"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Raw Data" groups="base.group_system">
                            <field name="raw_data"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View for unifi.dns.config -->
    <record id="view_unifi_dns_config_search" model="ir.ui.view">
        <field name="name">unifi.dns.config.search</field>
        <field name="model">unifi.dns.config</field>
        <field name="arch" type="xml">
            <search string="Search DNS Configurations">
                <field name="site_id"/>
                <filter string="Enabled" name="enabled" domain="[('enabled', '=', True)]"/>
                <filter string="Disabled" name="disabled" domain="[('enabled', '=', False)]"/>
                <separator/>
                <filter string="Content Filtering Enabled" name="filters_enabled" domain="[('filters_enabled', '=', True)]"/>
                <filter string="Forwarding Enabled" name="forwarding_enabled" domain="[('forwarding_enabled', '=', True)]"/>
                <filter string="mDNS Enabled" name="mdns_enabled" domain="[('mdns_enabled', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter string="Site" name="group_by_site" domain="[]" context="{'group_by': 'site_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action and menu moved to unifi_actions.xml and unifi_menu_views.xml -->
</odoo>
