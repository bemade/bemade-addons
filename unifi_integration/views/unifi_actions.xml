<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============ SITES ============ -->
    <!-- Action pour afficher la liste des sites UniFi -->
    <record id="action_unifi_site" model="ir.actions.act_window">
        <field name="name">UniFi Sites</field>
        <field name="res_model">unifi.site</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No UniFi sites found
            </p>
            <p>
                Add a new UniFi site to monitor and manage your UniFi network.
            </p>
        </field>
    </record>

    <!-- Action pour importer un site UniFi -->
    <record id="action_import_unifi_site" model="ir.actions.act_window">
        <field name="name">Import UniFi Site</field>
        <field name="res_model">unifi.site.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{}</field>
    </record>

