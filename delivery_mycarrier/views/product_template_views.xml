<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_form_view_mycarrier" model="ir.ui.view">
        <field name="name">product.template.form.mycarrier</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='inventory']" position="inside">
                <group string="MyCarrier (LTL)">
                    <field name="mycarrier_commodity_class"/>
                    <field name="mycarrier_nmfc_code"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
