#: model:ir.model.fields,field_description:bemade_cron_failure_alert.field_ir_cron__failure_alert_mode
msgid "Failure alert"
msgstr "Alerte d'échec"

#. module: bemade_cron_failure_alert
#: model:ir.model.fields,field_description:bemade_cron_failure_alert.field_ir_cron__id
#: model:ir.model.fields,field_description:bemade_cron_failure_alert.field_res_config_settings__id
msgid "ID"
