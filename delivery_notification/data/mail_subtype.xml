<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Custom message subtype for tracking number notifications -->
    <record id="mt_tracking_number_set" model="mail.message.subtype">
        <field name="name">Tracking Number Set</field>
        <field name="description">Tracking number has been added to the delivery</field>
        <field name="res_model">sale.order</field>
        <field name="default" eval="True"/>
        <field name="internal" eval="False"/>
    </record>
</odoo>
