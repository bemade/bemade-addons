<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Règle de sécurité pour les utilisateurs du portail -->
        <record id="planning_slot_portal_rule" model="ir.rule">
            <field name="name">Planning Slot: portal users can only see their own planning</field>
            <field name="model_id" ref="planning.model_planning_slot"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        
        <!-- Règle de sécurité pour les demandes de planning des utilisateurs du portail -->
        <record id="portal_planning_request_rule" model="ir.rule">
            <field name="name">Planning Request: portal users can only see their own requests</field>
            <field name="model_id" ref="portal_planning.model_portal_planning_request"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        
        <!-- Règle de sécurité pour les demandes de planning des utilisateurs internes -->
        <record id="portal_planning_request_user_rule" model="ir.rule">
            <field name="name">Planning Request: internal users can see all requests</field>
            <field name="model_id" ref="portal_planning.model_portal_planning_request"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('planning.group_planning_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
    </data>
</odoo>
