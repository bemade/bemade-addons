<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Paramètres par défaut pour le module portal_planning -->
        <record id="portal_planning_settings" model="ir.config_parameter">
            <field name="key">portal_planning.auto_approve_modification</field>
            <field name="value">False</field>
        </record>
        
        <record id="portal_planning_settings_timesheet" model="ir.config_parameter">
            <field name="key">portal_planning.auto_create_timesheet</field>
            <field name="value">True</field>
        </record>
        
        <record id="portal_planning_settings_notification" model="ir.config_parameter">
            <field name="key">portal_planning.send_email_notification</field>
            <field name="value">True</field>
        </record>
        
        <record id="portal_planning_settings_exchange" model="ir.config_parameter">
            <field name="key">portal_planning.allow_exchange</field>
            <field name="value">True</field>
        </record>
        
        <record id="portal_planning_settings_min_hours" model="ir.config_parameter">
            <field name="key">portal_planning.min_hours_before_modification</field>
            <field name="value">24</field>
        </record>
    </data>
</odoo>
