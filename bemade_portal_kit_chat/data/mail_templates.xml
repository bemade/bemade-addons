<?xml version="1.0" encoding="utf-8"?>
<!-- Task 5516: the chat e-mails' bodies (wrapped in mail.mail_notification_light).
     Values: user; each: title, messages [{author, text, reply_to}], url;
     digest: rows [{title, count, author, excerpt, url}], url. -->
<odoo>

    <template id="pk_chat_mail_button" name="Portal kit chat: e-mail button">
        <p style="margin: 24px 0 8px 0;">
            <a t-att-href="url" style="background-color: #1f6feb; padding: 10px 18px; text-decoration: none; color: #fff; border-radius: 6px; font-size: 14px; display: inline-block;" t-out="label"/>
        </p>
    </template>

    <template id="pk_chat_mail_each" name="Portal kit chat: new messages e-mail">
        <div>
            <t t-set="pk_hello">Hello %s,</t>
            <t t-set="pk_intro">New messages in « %s »:</t>
            <p t-out="pk_hello % user.name"/>
            <p t-out="pk_intro % title"/>
            <div t-foreach="messages" t-as="msg" style="margin: 0 0 12px 0; padding: 8px 12px; border-left: 3px solid #d0d7de;">
                <strong t-out="msg['author']"/>
                <t t-set="pk_reply_to">(in reply to %s)</t>
                <span t-if="msg['reply_to']" style="color: #6e7781;" t-out="' ' + pk_reply_to % msg['reply_to']"/>
                <div style="white-space: pre-line;" t-out="msg['text']"/>
            </div>
            <t t-call="bemade_portal_kit_chat.pk_chat_mail_button">
                <t t-set="label">Open the conversation</t>
            </t>
            <p style="color: #6e7781; font-size: 12px;">You choose these e-mails in the app: Settings › Notifications.</p>
        </div>
    </template>

    <template id="pk_chat_mail_digest" name="Portal kit chat: daily digest e-mail">
        <div>
            <t t-set="pk_hello">Hello %s,</t>
            <p t-out="pk_hello % user.name"/>
            <p>You have unread conversations:</p>
            <div t-foreach="rows" t-as="row" style="margin: 0 0 12px 0; padding: 8px 12px; border-left: 3px solid #d0d7de;">
                <a t-att-href="row['url']" style="font-weight: bold;" t-out="row['title']"/>
                <span style="color: #6e7781;"> · <t t-out="row['count']"/></span>
                <div style="color: #444;"><t t-out="row['author']"/>: <t t-out="row['excerpt']"/></div>
            </div>
            <t t-call="bemade_portal_kit_chat.pk_chat_mail_button">
                <t t-set="label">Open my conversations</t>
            </t>
            <p style="color: #6e7781; font-size: 12px;">You choose these e-mails in the app: Settings › Notifications.</p>
        </div>
    </template>

</odoo>
