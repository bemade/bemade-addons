<?xml version="1.0" encoding="utf-8"?>
<!--
    Task 5516: the portal chat's templates.

    * pk_app_layout_chat  the bubble in the app bar (after pk_appbar_actions)
                          and the ONE floating window next to the toast host,
                          while the chat is on (portal.kit._pk_chat_active);
    * pk_chat_texts       the client's texts (translated here);
    * pk_conversation     the inline block: t-call with channel_id (or
                          partner_id: the direct chat with that contact);
    * pk_chat_page_list / pk_chat_page_conversation  /my/app/conversations[/<id>].
-->
<odoo>

    <template id="pk_icon_chat" name="Portal kit chat: icons" inherit_id="bemade_portal_kit.pk_icon_extra">
        <xpath expr="//t[@t-else='']" position="before">
            <t t-elif="icon == 'pk_chat'"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></t>
        </xpath>
    </template>

    <template id="pk_chat_texts" name="Portal kit chat: client texts">
        <t t-set="pk_chat_t_reply">Reply</t>
        <t t-set="pk_chat_t_send">Send</t>
        <t t-set="pk_chat_t_placeholder">Write a message…</t>
        <t t-set="pk_chat_t_replying">Replying to %s</t>
        <t t-set="pk_chat_t_cancel">Cancel</t>
        <t t-set="pk_chat_t_hint">Reply to a message to answer.</t>
        <t t-set="pk_chat_t_members">Members</t>
        <t t-set="pk_chat_t_poster">Poster</t>
        <t t-set="pk_chat_t_reader">Reader</t>
        <t t-set="pk_chat_t_empty">No messages yet.</t>
        <t t-set="pk_chat_t_error">The message could not be sent.</t>
        <t t-set="pk_chat_t_older">Older messages</t>
        <span hidden="hidden" data-pk-chat-texts="1"
              t-att-data-pk-chat-reply="pk_chat_t_reply" t-att-data-pk-chat-send="pk_chat_t_send"
              t-att-data-pk-chat-placeholder="pk_chat_t_placeholder" t-att-data-pk-chat-replying-to="pk_chat_t_replying"
              t-att-data-pk-chat-cancel="pk_chat_t_cancel" t-att-data-pk-chat-reader-hint="pk_chat_t_hint"
              t-att-data-pk-chat-members="pk_chat_t_members" t-att-data-pk-chat-poster="pk_chat_t_poster"
              t-att-data-pk-chat-reader="pk_chat_t_reader" t-att-data-pk-chat-empty="pk_chat_t_empty"
              t-att-data-pk-chat-error="pk_chat_t_error" t-att-data-pk-chat-older="pk_chat_t_older"/>
        <!-- Task 5546: the one-time phone prompt (pk_chat_push_prompt.js),
             while phone notifications can be sent and the user never
             answered it. -->
        <t t-if="request.env['portal.kit']._pk_push_available() and not request.env.user.pk_push_prompted">
            <t t-set="pk_chat_t_push_ask">Get notified on this phone?</t>
            <t t-set="pk_chat_t_push_on">Turn on</t>
            <t t-set="pk_chat_t_push_later">Later</t>
            <t t-set="pk_chat_t_push_ios">To get notified on this iPhone, add the app to your home screen (Share, then « Add to Home Screen »).</t>
            <t t-set="pk_chat_t_push_ok">OK</t>
            <span hidden="hidden" data-pk-chat-push-prompt="1"
                  t-att-data-pk-chat-push-ask="pk_chat_t_push_ask" t-att-data-pk-chat-push-on="pk_chat_t_push_on"
                  t-att-data-pk-chat-push-later="pk_chat_t_push_later" t-att-data-pk-chat-push-ios="pk_chat_t_push_ios"
                  t-att-data-pk-chat-push-ok="pk_chat_t_push_ok"/>
        </t>
    </template>

    <template id="pk_chat_bubble" name="Portal kit chat: bubble">
        <t t-set="pk_chat_label">Conversations</t>
        <t t-set="pk_chat_none">No conversation yet.</t>
        <t t-set="pk_chat_pick">Choose a person</t>
        <div class="o_pk_chat_bubble" data-pk-chat-bubble="1" t-att-data-pk-chat-empty="pk_chat_none"
             t-att-data-pk-chat-pick-label="pk_chat_pick">
            <button type="button" class="o_pk_icon_btn o_pk_chat_toggle" data-pk-chat-toggle="1"
                    aria-haspopup="menu" aria-expanded="false" t-att-aria-label="pk_chat_label" t-att-title="pk_chat_label">
                <t t-call="bemade_portal_kit.pk_icon"><t t-set="icon" t-value="'pk_chat'"/></t>
                <span class="o_pk_chat_badge o_pk_chat_badge_dot" data-pk-chat-badge="1" hidden="hidden"/>
            </button>
            <div class="o_pk_chat_menu" data-pk-chat-menu="1" data-pk-keep-in-view="1" hidden="hidden">
                <div class="o_pk_chat_menu_head">
                    <strong t-out="pk_chat_label"/>
                    <button type="button" class="o_pk_btn o_pk_btn_ghost" data-pk-chat-new="1">New conversation</button>
                </div>
                <div class="o_pk_chat_picker" data-pk-chat-picker="1" data-pk-picker-scope="1" hidden="hidden"/>
                <div class="o_pk_chat_list" data-pk-chat-list="1"/>
                <a class="o_pk_chat_all" href="/my/app/conversations">All conversations</a>
            </div>
        </div>
    </template>

    <template id="pk_chat_window" name="Portal kit chat: floating window">
        <t t-set="pk_chat_back">All conversations</t>
        <t t-set="pk_chat_min">Minimise</t>
        <t t-set="pk_chat_close">Close</t>
        <section class="o_pk_chat_window" data-pk-chat-window="1" hidden="hidden" aria-label="Conversation">
            <header class="o_pk_chat_window_head" data-pk-chat-head="1">
                <button type="button" class="o_pk_icon_btn" data-pk-chat-back="1" t-att-aria-label="pk_chat_back" t-att-title="pk_chat_back">
                    <t t-call="bemade_portal_kit.pk_icon"><t t-set="icon" t-value="'back'"/></t>
                </button>
                <strong class="o_pk_chat_window_title" data-pk-chat-title="1"/>
                <button type="button" class="o_pk_icon_btn o_pk_chat_min" data-pk-chat-min="1" t-att-aria-label="pk_chat_min" t-att-title="pk_chat_min">
                    <t t-call="bemade_portal_kit.pk_icon"><t t-set="icon" t-value="'down'"/></t>
                </button>
                <button type="button" class="o_pk_icon_btn" data-pk-chat-close="1" t-att-aria-label="pk_chat_close" t-att-title="pk_chat_close">
                    <t t-call="bemade_portal_kit.pk_icon"><t t-set="icon" t-value="'close'"/></t>
                </button>
            </header>
            <div class="o_pk_chat_thread_host" data-pk-chat-thread-host="1"/>
        </section>
    </template>

    <template id="pk_app_layout_chat" name="Portal kit chat: in the app layout"
              inherit_id="bemade_portal_kit.pk_app_layout">
        <xpath expr="//t[@t-out='pk_appbar_actions']" position="after">
            <t t-if="request.env['portal.kit']._pk_chat_active() and not request.env.user._is_public()">
                <t t-call="bemade_portal_kit_chat.pk_chat_bubble"/>
            </t>
        </xpath>
        <xpath expr="//t[@t-call='bemade_portal_kit.pk_toast_host']" position="after">
            <t t-if="request.env['portal.kit']._pk_chat_active() and not request.env.user._is_public()">
                <t t-call="bemade_portal_kit_chat.pk_chat_window"/>
                <t t-call="bemade_portal_kit_chat.pk_chat_texts"/>
            </t>
        </xpath>
    </template>

    <!-- The inline block: the same thread and composer on any kit page.
         Values: channel_id (a conversation of the viewer), or partner_id
         (the direct chat with that contact, created after the contacts
         check). Nothing when neither resolves. -->
    <template id="pk_conversation" name="Portal kit chat: conversation block">
        <t t-set="pk_chat_block_id" t-value="request.env['portal.kit'].pk_chat_block_channel(
            channel_id=channel_id if channel_id else None, partner_id=partner_id if partner_id else None)"/>
        <div t-if="pk_chat_block_id" class="o_pk_chat_block o_pk_card" t-att-data-pk-chat-block="pk_chat_block_id"/>
    </template>

    <template id="pk_chat_page_list" name="Portal kit chat: conversations">
        <t t-call="{{ pk_layout }}">
            <t t-set="pk_title">Conversations</t>
            <t t-set="pk_active_nav" t-value="False"/>
            <div class="o_pk_list" data-pk-section="chat.conversations">
                <t t-if="not pk_chat_rows">
                    <t t-set="message">No conversation yet.</t>
                    <t t-call="bemade_portal_kit.pk_empty_state"/>
                </t>
                <t t-foreach="pk_chat_rows" t-as="pk_chat_row">
                    <a class="o_pk_chat_row" t-att-href="'/my/app/conversations/%s' % pk_chat_row['id']"
                       t-att-data-pk-chat-row="pk_chat_row['id']">
                        <img class="o_pk_chat_avatar" alt="" loading="lazy" t-att-src="pk_chat_row['avatar_url']"/>
                        <span class="o_pk_chat_row_text">
                            <strong class="o_pk_chat_row_title" t-out="pk_chat_row['title']"/>
                            <span class="o_pk_chat_row_preview" t-out="pk_chat_row['preview']"/>
                        </span>
                        <span class="o_pk_chat_row_meta">
                            <time t-out="pk_chat_row['when']"/>
                            <span t-if="pk_chat_row['unread']" class="o_pk_chat_badge" t-out="pk_chat_row['unread']"/>
                        </span>
                    </a>
                </t>
            </div>
        </t>
    </template>

    <template id="pk_chat_page_conversation" name="Portal kit chat: conversation">
        <t t-call="{{ pk_layout }}">
            <t t-set="pk_title" t-value="pk_chat_title"/>
            <t t-set="pk_active_nav" t-value="False"/>
            <t t-call="bemade_portal_kit_chat.pk_conversation">
                <t t-set="channel_id" t-value="pk_chat_channel_id"/>
            </t>
        </t>
    </template>

</odoo>
