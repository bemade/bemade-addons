<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-inherit="mail.Composer" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o-mail-Composer-footer')]" position="before">
            <div
        t-if="showMailSignaturePreview"
        class="o_bemade_mail_signature_preview o-mail-Composer-signaturePreview text-muted small border-top mt-1 pt-1 px-2"
      >
                <t t-if="props.composer.emailAddSignature">
                    <div
            class="o_bemade_mail_signature_block o-mail-Composer-signatureBlock"
            t-out="mailSignature.block"
          />
                    <button
            type="button"
            class="o_bemade_mail_signature_edit btn btn-link btn-sm p-0"
            title="Edit the message and its signature in the full composer"
            t-on-click="onClickMailSignatureEdit"
          >Edit</button>
                    <button
            type="button"
            class="o_bemade_mail_signature_remove o-mail-Composer-signatureRemove btn btn-link btn-sm p-0 ms-2"
            t-on-click="onClickMailSignatureRemove"
          >Remove signature</button>
                </t>
                <t t-else="">
                    <span>Signature removed for this message</span>
                    <button
            type="button"
            class="o_bemade_mail_signature_restore o-mail-Composer-signatureRestore btn btn-link btn-sm p-0 ms-1"
            t-on-click="onClickMailSignatureRestore"
          >Add signature</button>
                </t>
            </div>
        </xpath>
    </t>
</templates>
