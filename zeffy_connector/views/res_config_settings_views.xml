<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.zeffy.connector</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@name='integration']" position="inside">
                <setting
          id="zeffy_connector_setting"
          string="Zeffy"
          company_dependent="1"
          groups="base.group_system"
          help="Synchronize campaigns, contacts and payments from Zeffy (read-only). The API key is generated by the Zeffy organization owner in Settings > Integrations."
        >
                    <div class="content-group">
                        <div class="row mt16">
                            <label
                for="zeffy_api_key"
                string="API key"
                class="col-lg-3 o_light_label"
              />
                            <field
                name="zeffy_api_key"
                password="True"
                class="col-lg-9"
              />
                        </div>
                        <div class="row" invisible="not zeffy_last_sync">
                            <label
                for="zeffy_last_sync"
                string="Last synchronization"
                class="col-lg-3 o_light_label"
              />
                            <field name="zeffy_last_sync" class="col-lg-9" />
                        </div>
                        <div class="row" invisible="not zeffy_last_sync_error">
                            <label
                for="zeffy_last_sync_error"
                string="Last error"
                class="col-lg-3 o_light_label"
              />
                            <field
                name="zeffy_last_sync_error"
                class="col-lg-9 text-danger"
              />
                        </div>
                        <div class="mt8">
                            <button
                name="action_zeffy_test_connection"
                type="object"
                string="Test connection"
                icon="oi-arrow-right"
                class="btn-link"
              />
                            <button
                name="action_zeffy_sync_now"
                type="object"
                string="Synchronize now"
                icon="oi-arrow-right"
                class="btn-link"
                invisible="not zeffy_api_key"
              />
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
