<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_groups_privilege_zeffy" model="res.groups.privilege">
        <field name="name">Zeffy</field>
        <field name="sequence">50</field>
        <field name="category_id" ref="base.module_category_sales" />
    </record>

    <record id="group_zeffy_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_zeffy" />
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]" />
        <field
      name="comment"
    >Consults the campaigns, contacts and payments synchronized from Zeffy.</field>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('group_zeffy_user'))]" />
    </record>

    <record id="zeffy_campaign_rule_company" model="ir.rule">
        <field name="name">Zeffy campaign: multi-company</field>
        <field name="model_id" ref="model_zeffy_campaign" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="zeffy_contact_rule_company" model="ir.rule">
        <field name="name">Zeffy contact: multi-company</field>
        <field name="model_id" ref="model_zeffy_contact" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="zeffy_payment_rule_company" model="ir.rule">
        <field name="name">Zeffy payment: multi-company</field>
        <field name="model_id" ref="model_zeffy_payment" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
