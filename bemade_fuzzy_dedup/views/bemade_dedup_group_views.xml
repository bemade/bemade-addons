<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="bemade_dedup_group_view_list" model="ir.ui.view">
        <field name="name">bemade.dedup.group.list</field>
        <field name="model">bemade.dedup.group</field>
        <field name="arch" type="xml">
            <list>
                <field name="target_id" />
                <field name="model_name" />
                <field name="record_count" />
                <field
          name="state"
          widget="badge"
          decoration-info="state == 'pending'"
          decoration-success="state == 'merged'"
          decoration-warning="state == 'stale'"
        />
            </list>
        </field>
    </record>

    <record id="bemade_dedup_group_view_form" model="ir.ui.view">
        <field name="name">bemade.dedup.group.form</field>
        <field name="model">bemade.dedup.group</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
            name="action_merge"
            type="object"
            string="Merge"
            class="btn-primary"
            invisible="state != 'pending'"
            confirm="Merge these records into the master? This cannot be undone."
          />
                    <button
            name="action_discard"
            type="object"
            string="Not Duplicates"
            invisible="state != 'pending'"
          />
                    <field
            name="state"
            widget="statusbar"
            statusbar_visible="pending,merged"
          />
                </header>
                <sheet>
                    <group>
                        <field name="target_id" readonly="1" />
                        <field name="model_name" readonly="1" />
                    </group>
                    <field name="record_ids" readonly="state != 'pending'">
                        <list editable="bottom" create="0" delete="0">
                            <field name="is_master" widget="boolean_toggle" />
                            <field name="record_name" readonly="1" />
                            <field name="res_id" readonly="1" />
                        </list>
                    </field>
                    <div class="text-muted">
                        The master is the record the others are merged into.
                        Change it before merging if the elected one is wrong.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="bemade_dedup_group_action" model="ir.actions.act_window">
        <field name="name">Duplicate Groups</field>
        <field name="res_model">bemade.dedup.group</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'pending')]</field>
        <field name="context">{'search_default_target_id': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No duplicates to review</p>
            <p>Run a scan from a deduplication target to propose groups.</p>
        </field>
    </record>
</odoo>
