<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_expected_ship_date" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.expected.ship.date</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list//field[@name='customer_lead']" position="after">
                <field name="expected_ship_date"/>
            </xpath>
        </field>
    </record>
</odoo>
