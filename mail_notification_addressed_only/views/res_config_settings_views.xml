<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.addressed.only</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mail.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@id='discuss']" position="inside">
                <setting
          id="addressed_only_setting"
          string="Email Only When Addressed"
          help="On the record types listed here, internal followers only receive an email for messages addressed to them (recipient, mention, Cc/Bcc). Other messages reach them in their Odoo inbox. Customers and other external followers are not affected."
        >
                    <div class="content-group">
                        <div class="mt8">
                            <field
                name="addressed_only_model_ids"
                widget="many2many_tags"
              />
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
