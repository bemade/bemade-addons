<?xml version="1.0" encoding="utf-8"?>
<!-- Task 5516 (kit 1.17): a user reads and writes only their own
     notification preferences; system administrators every row. -->
<odoo noupdate="1">

    <record id="rule_pk_notification_pref_own" model="ir.rule">
        <field name="name">Portal kit notification pref: own rows</field>
        <field name="model_id" ref="model_portal_kit_notification_pref"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('base.group_portal')), Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="rule_pk_notification_pref_system" model="ir.rule">
        <field name="name">Portal kit notification pref: system administrators</field>
        <field name="model_id" ref="model_portal_kit_notification_pref"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('base.group_system'))]"/>
    </record>

</odoo>
