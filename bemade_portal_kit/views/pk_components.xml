<?xml version="1.0" encoding="utf-8"?>
<!--
    Task 5369 (kit P3c1): the kit's icon and its first components, adopted
    from the first consumer (bemade_sports_clinic). The records kept their
    ir.ui.view ids: tools/adopt.py renamed their external ids from the
    consumer's sc_* names before this file was loaded (pre-migrations of the
    kit 19.0.1.5.0 and of the clinic 19.0.1.139.0). Task 5370 (P4b) adopted
    two more the same way: pk_status_pill_select and pk_form_guard_slots
    (kit 19.0.1.7.0, clinic 19.0.1.141.0).

    Styled by static/src/scss/pk_components.scss, scoped under .o_pk_app.
    Calling convention: set the documented variables in the t-call body;
    ``0`` (the t-call body) is the content where noted.
-->
<odoo>

    <!-- The icon's extension point: what pk_icon renders for a name it does
         not know. A consumer adds its own glyphs with an xpath BEFORE the
         t-else, each as a t-elif (several consumers can do so):
             <xpath expr="//t[@t-else]" position="before">
                 <t t-elif="icon == 'my_icon'">...</t>
             </xpath>
         The fallback is three dots. The whitespace before the first t-if is
         the glyph's indent in the rendered SVG (as for pk_icon's own). -->
    <template id="pk_icon_extra" name="Portal kit: icon extension point">
            <t t-if="not icon"><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/></t><t t-else=""><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/></t></template>

    <!-- Inline SVG icons, 24 x 24, stroke = currentColor (.o_pk_icon).
         Variable: icon, the glyph's name; an unknown name goes to
         pk_icon_extra (a consumer's glyphs, else the fallback).
         Generic UI actions and objects only: a consumer's domain vocabulary
         stays in the consumer (pk_icon_extra).
         Glyphs from or drawn after Feather Icons 4.29 (https://feathericons.com),
         MIT License, (c) 2013-2017 Cole Bemis: static/src/icons/LICENSE-feather.txt. -->
    <template id="pk_icon" name="Portal kit: icon">
        <svg viewBox="0 0 24 24" class="o_pk_icon" aria-hidden="true" focusable="false">
            <t t-if="icon == 'star'"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></t>
            <t t-elif="icon == 'activities'"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></t>
            <t t-elif="icon == 'calendar'"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></t>
            <t t-elif="icon == 'note'"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M8 13h8M8 17h5"/></t>
            <t t-elif="icon == 'clock'"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></t>
            <t t-elif="icon == 'summary'"><path d="M4 19V5M4 19h16M8 15v-4M12 15V8M16 15v-6"/></t>
            <t t-elif="icon == 'account'"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></t>
            <t t-elif="icon == 'security'"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></t>
            <t t-elif="icon == 'settings'"><path d="M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M1 14h6M9 8h6M17 16h6"/></t>
            <t t-elif="icon == 'documents'"><path d="M3 7h18v13H3zM8 7V4h8v3"/></t>
            <t t-elif="icon == 'backend'"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></t>
            <t t-elif="icon == 'logout'"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/></t>
            <t t-elif="icon == 'back'"><path d="M15 18l-6-6 6-6"/></t>
            <t t-elif="icon == 'chevron'"><path d="M9 18l6-6-6-6"/></t>
            <t t-elif="icon == 'search'"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></t>
            <t t-elif="icon == 'help'"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><path d="M12 17h.01"/></t>
            <t t-elif="icon == 'moon'"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></t>
            <t t-elif="icon == 'sun'"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></t>
            <t t-elif="icon == 'up'"><path d="M18 15l-6-6-6 6"/></t>
            <t t-elif="icon == 'down'"><path d="M6 9l6 6 6-6"/></t>
            <t t-elif="icon == 'install'"><rect x="6" y="2" width="12" height="20" rx="2"/><path d="M12 7v7M9 11l3 3 3-3M10 18h4"/></t>
            <t t-elif="icon == 'history'"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5M12 7v5l3 2"/></t>
            <t t-elif="icon == 'megaphone'"><path d="M3 11v2a1 1 0 0 0 1 1h2l5 4V6L6 10H4a1 1 0 0 0-1 1zM15 9a3 3 0 0 1 0 6M18 6a7 7 0 0 1 0 12"/></t>
            <t t-elif="icon == 'plus'"><path d="M12 5v14M5 12h14"/></t>
            <t t-elif="icon == 'close'"><path d="M18 6L6 18M6 6l12 12"/></t>
            <t t-elif="icon == 'share'"><path d="M12 3v12M8 7l4-4 4 4"/><path d="M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-7"/></t>
            <t t-elif="icon == 'user'"><circle cx="12" cy="8" r="4"/><path d="M6 21v-1a6 6 0 0 1 12 0v1"/></t>
            <t t-elif="icon == 'archive'"><path d="M21 8v13H3V8"/><path d="M1 3h22v5H1z"/><path d="M10 12h4"/></t>
            <t t-elif="icon == 'edit'"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></t>
            <t t-elif="icon == 'trash'"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6"/></t>
            <t t-elif="icon == 'download'"><path d="M12 3v12M7 10l5 5 5-5M5 21h14"/></t>
            <t t-elif="icon == 'upload'"><path d="M12 21V9M7 14l5-5 5 5M5 3h14"/></t>
            <t t-elif="icon == 'phone'"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.9 2z"/></t>
            <t t-elif="icon == 'mail'"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></t>
            <t t-elif="icon == 'check'"><path d="M20 6L9 17l-5-5"/></t>
            <t t-elif="icon == 'filter'"><path d="M22 3H2l8 9.5V19l4 2v-8.5z"/></t>
            <t t-elif="icon == 'sort'"><path d="M7 4v16M3 16l4 4 4-4M17 20V4M13 8l4-4 4 4"/></t>
            <t t-else="" t-call="bemade_portal_kit.pk_icon_extra"/>
        </svg>
    </template>

    <!-- Status chip. Variables: tone (red|yellow|green|secondary|ghost), label. -->
    <template id="pk_status_chip" name="Portal kit: status chip">
        <span t-attf-class="o_pk_chip o_pk_chip_#{tone or 'ghost'}" t-out="label"/>
    </template>

    <!-- Stat tile. Variables: tone (red|yellow|green), value, label. -->
    <template id="pk_stat_tile" name="Portal kit: stat tile">
        <div t-attf-class="o_pk_stat o_pk_tone_#{tone or 'neutral'}">
            <span class="o_pk_stat_value" t-out="value"/>
            <span class="o_pk_stat_label" t-out="label"/>
        </div>
    </template>

    <!-- Card. Body (0) = content. Variable: card_class (extra classes). -->
    <template id="pk_card" name="Portal kit: card">
        <div t-attf-class="o_pk_card #{card_class or ''}">
            <t t-out="0"/>
        </div>
    </template>

    <!-- Section header. Variables: title, more_url, more_label. -->
    <template id="pk_section_header" name="Portal kit: section header">
        <h2 class="o_pk_section_header">
            <span t-out="title"/>
            <a t-if="more_url" t-att-href="more_url" class="o_pk_section_more" t-out="more_label"/>
        </h2>
    </template>

    <!-- Task 1724: « Annuler » next to the submit of an inline add panel
         (details.o_pk_list_add_panel): closes the panel, clears its fields
         and its device drafts, focus back on the header's « + Ajouter »
         (pk_list_header.js). -->
    <template id="pk_list_add_cancel" name="Portal kit: add panel cancel">
        <button type="button" class="o_pk_btn o_pk_btn_ghost o_pk_list_add_cancel" data-pk-list-add-cancel="1">Cancel</button>
    </template>

    <!-- « Done » of an edit card's edit view. -->
    <template id="pk_edit_card_done" name="Portal kit: edit card done">
        <!-- Task 1676: hidden unless the user shows the « Done » buttons
             (Paramètres); the head pencil's ✓ closes the card either way. -->
        <div class="o_pk_form_actions o_pk_edit_done_actions">
            <button type="button" class="o_pk_btn o_pk_btn_primary o_pk_btn_sm o_pk_edit_done" data-pk-edit-done="1">Done</button>
        </div>
    </template>

    <!-- Empty state. Variable: message. -->
    <template id="pk_empty_state" name="Portal kit: empty state">
        <p class="o_pk_empty" t-out="message"/>
    </template>

    <!--
        Task 5370 (P4b) — a coloured status pill that is its own dropdown
        (static/src/js/pk_status_pills.js). Variables:

        - pill: {key, text, label, title, tone, icon, menu_label, options,
          target}; options [{value, label, tone, checked, disabled, hint,
          post, action, from}]
          — ``post`` is the value a pick saves (default: ``value``; an empty
          string is a value too: a blank choice); a disabled option is
          greyed, says why (``hint``) and posts nothing; an ``action``
          option posts nothing either — the pick is announced as a
          « pk:pill-action » DOM event ({action, value, from, model,
          recordId, pill}) for the module that owns that action;
          target {model, id, field, write_date, old_value}: the pick posts
          ``POST /my/app/save/<model>/<id>`` {field, value: post, write_date,
          old_value} — render the pill INSIDE a read fragment so the next
          pick posts fresh values;
        - editable: False -> the same coloured pill, read-only (a span, no
          menu, data-pk-pill-readonly);
        - undo_message: the « Undo » toast's message after a pick;
        - compact -> the small pill of a list row (``label`` shown, the full
          ``text`` as its title / accessible name, a small chevron);
        - scope -> a key making the menu id unique when one record's pills
          show several times on a page.

        The menu is the shell's generic menu popup (pk_user_menu: keyboard,
        Escape, outside tap, one open at a time).
    -->
    <template id="pk_status_pill_select" name="Portal kit: status pill select">
        <t t-set="pk_pill_target" t-value="pill['target']"/>
        <t t-set="pk_pill_menu_id" t-value="'pk-pill-%s-%s-%s%s' % (pk_pill_target['model'].replace('.', '-'), pk_pill_target['id'], pill['key'], ('-%s' % scope) if scope else '')"/>
        <span t-if="editable" t-attf-class="o_pk_pill_select_wrap#{' o_pk_pill_select_compact' if compact else ''}" data-pk-pill-select="1"
              t-att-data-pk-pill-key="pill['key']"
              t-att-data-pk-model="pk_pill_target['model']"
              t-att-data-pk-record-id="pk_pill_target['id']"
              t-att-data-pk-field="pk_pill_target['field']"
              t-att-data-pk-write-date="pk_pill_target['write_date']"
              t-att-data-pk-old-value="pk_pill_target['old_value']"
              t-att-data-pk-undo-message="undo_message or None">
            <button type="button" t-attf-class="o_pk_status_pill o_pk_pill_select o_pk_chip_#{pill['tone']}"
                    data-pk-menu-toggle="1" aria-haspopup="menu" aria-expanded="false"
                    t-att-aria-controls="pk_pill_menu_id" t-att-title="pill['title']"
                    t-att-aria-label="pill['text'] if compact else None"
                    t-att-data-pk-pill-value="pill['value']">
                <i t-if="pill['icon']" t-attf-class="fa #{pill['icon']}" aria-hidden="true"/>
                <span class="o_pk_pill_text" t-out="pill['label'] if compact else pill['text']"/>
                <t t-call="bemade_portal_kit.pk_icon"><t t-set="icon" t-value="'down'"/></t>
            </button>
            <span t-att-id="pk_pill_menu_id" class="o_pk_menu_popup o_pk_pill_popup" role="menu" data-pk-menu-popup="1" data-pk-keep-in-view="1"
                  t-att-aria-label="pill['menu_label']" hidden="hidden">
                <button t-foreach="pill['options']" t-as="option" type="button" role="menuitemradio"
                        class="o_pk_menu_item o_pk_pill_option"
                        t-att-data-pk-pill-value="option['value']"
                        t-att-data-pk-pill-post="None if option['disabled'] else option.get('post', option['value'])"
                        t-att-data-pk-pill-action="option.get('action') or None"
                        t-att-data-pk-pill-from="option.get('from') or None"
                        t-att-aria-checked="'true' if option['checked'] else 'false'"
                        t-att-aria-disabled="'true' if option['disabled'] else None">
                    <t t-call="bemade_portal_kit.pk_icon"><t t-set="icon" t-value="'check'"/></t>
                    <span t-attf-class="o_pk_pill_swatch o_pk_chip_#{option['tone']}" aria-hidden="true"/>
                    <span class="o_pk_pill_option_text">
                        <span t-out="option['label']"/>
                        <small t-if="option['disabled'] and option['hint']" class="o_pk_pill_hint" t-out="option['hint']"/>
                    </span>
                </button>
            </span>
        </span>
        <span t-else="" t-attf-class="o_pk_status_pill o_pk_chip_#{pill['tone']}" t-att-title="pill['title']"
              t-att-data-pk-pill-key="pill['key']" data-pk-pill-readonly="1">
            <i t-if="pill['icon']" t-attf-class="fa #{pill['icon']}" aria-hidden="true"/>
            <span class="o_pk_pill_text" t-out="pill['text']"/>
        </span>
    </template>

    <!-- Task 5370 (P4b) — the form guard's slots (pk_form_guard.js): the
         server-error slot and the reason line under the primary action
         (aria-describedby). Call it right after the form's actions.
         Variables: guard_id (unique on the page). -->
    <template id="pk_form_guard_slots" name="Portal kit: form guard slots">
        <p class="o_pk_field_message o_pk_field_error" role="alert" data-pk-guard-error="1" hidden="hidden"/>
        <p class="o_pk_hint o_pk_guard_reason" t-att-id="'%s_reason' % guard_id" data-pk-guard-reason="1"
           aria-live="polite" hidden="hidden"/>
    </template>

</odoo>
