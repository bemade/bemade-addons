<?xml version="1.0" encoding="utf-8"?>
<!--
    Task 5357 (kit P3b2): the kit's style guide (/pk/styleguide, internal
    users). Every generic component of the shell, kit classes only, with the
    neutral slots of pk_tokens.scss; ?theme=dark renders the dark theme.
    Synthetic labels only. P3c swaps the wrapper for the kit's own layout.
    Task 5369 (P3c1): the icons are the kit's pk_icon; the logo is a
    neutral mark drawn inline.
-->
<odoo>

    <template id="pk_styleguide" name="Portal kit: style guide">
        <t t-call="web.frontend_layout">
            <t t-set="no_header" t-value="True"/>
            <t t-set="no_footer" t-value="True"/>
            <t t-set="no_livechat" t-value="True"/>
            <t t-set="body_classname" t-value="'o_pk_app_body o_pk_app_body_%s' % pk_theme"/>
            <t t-set="title">Portal kit style guide</t>
            <div class="o_pk_app" t-att-data-pk-theme="pk_theme">
                <div class="o_pk_main">
                    <header class="o_pk_appbar">
                        <span class="o_pk_logo">
                            <svg viewBox="0 0 24 24" class="o_pk_icon" aria-hidden="true" focusable="false"><rect x="4" y="4" width="16" height="16" rx="4"/><path d="M9 12h6M12 9v6"/></svg>
                        </span>
                        <h1 class="o_pk_appbar_title">
                            <span class="o_pk_appbar_title_text">Style guide</span>
                            <small class="o_pk_appbar_context">Bemade Portal Kit</small>
                        </h1>
                        <a t-att-href="'/pk/styleguide?theme=dark' if pk_theme == 'light' else '/pk/styleguide'"
                           class="o_pk_icon_btn" aria-label="Toggle theme" title="Toggle theme">
                            <t t-call="bemade_portal_kit.pk_icon"><t t-set="icon" t-value="'moon' if pk_theme == 'light' else 'sun'"/></t>
                        </a>
                    </header>

                    <main class="o_pk_content">
                        <section class="o_pk_section">
                            <h2 class="o_pk_section_header"><span>About this page</span></h2>
                            <p class="o_pk_meta">The generic components of the portal app shell, drawn with the kit's neutral style slots (--pk-*). An addon brands them by setting the slots on .o_pk_app.</p>
                        </section>

                        <section class="o_pk_section">
                            <h2 class="o_pk_section_header">
                                <span>Cards</span>
                                <a href="#pk_sg_rows" class="o_pk_section_more">See all</a>
                            </h2>
                            <div class="o_pk_card">
                                <div class="o_pk_card_head">
                                    <div>
                                        <span class="o_pk_row_title">Sample card</span>
                                        <p class="o_pk_meta">Monday · Room B · 45 min</p>
                                    </div>
                                    <span class="o_pk_card_icons">
                                        <span class="o_pk_chip o_pk_chip_green">Open</span>
                                        <button type="button" class="o_pk_icon_btn" aria-label="Edit" title="Edit">
                                            <t t-call="bemade_portal_kit.pk_icon"><t t-set="icon" t-value="'edit'"/></t>
                                        </button>
                                        <button type="button" class="o_pk_icon_btn o_pk_icon_btn_danger" aria-label="Delete" title="Delete">
                                            <t t-call="bemade_portal_kit.pk_icon"><t t-set="icon" t-value="'trash'"/></t>
                                        </button>
                                    </span>
                                </div>
                                <p>A card holds one record or one group of fields. Its head carries the title, a status chip and the action icons.</p>
                            </div>
                        </section>

                        <section class="o_pk_section">
                            <h2 class="o_pk_section_header"><span>Stats</span></h2>
                            <div class="o_pk_stats">
                                <div class="o_pk_stat o_pk_tone_green"><span class="o_pk_stat_value">12</span><span class="o_pk_stat_label">Ready</span></div>
                                <div class="o_pk_stat o_pk_tone_yellow"><span class="o_pk_stat_value">3</span><span class="o_pk_stat_label">To check</span></div>
                                <div class="o_pk_stat o_pk_tone_red"><span class="o_pk_stat_value">1</span><span class="o_pk_stat_label">Blocked</span></div>
                            </div>
                        </section>

                        <section class="o_pk_section" id="pk_sg_rows">
                            <h2 class="o_pk_section_header"><span>Rows</span></h2>
                            <div class="o_pk_list">
                                <a href="#pk_sg_rows" class="o_pk_entity_row">
                                    <span class="o_pk_dot o_pk_tone_green" aria-hidden="true"/>
                                    <span class="o_pk_row_text">
                                        <span class="o_pk_row_title">First sample row</span>
                                        <span class="o_pk_row_subtitle">A subtitle under the title</span>
                                    </span>
                                    <span class="o_pk_row_trailing">
                                        <span class="o_pk_chip o_pk_chip_ghost">Draft</span>
                                        <t t-call="bemade_portal_kit.pk_icon"><t t-set="icon" t-value="'chevron'"/></t>
                                    </span>
                                </a>
                                <a href="#pk_sg_rows" class="o_pk_entity_row">
                                    <span class="o_pk_dot o_pk_tone_yellow" aria-hidden="true"/>
                                    <span class="o_pk_row_text">
                                        <span class="o_pk_row_title">Second sample row</span>
                                        <span class="o_pk_row_subtitle">Waiting for an answer</span>
                                    </span>
                                    <span class="o_pk_row_trailing">
                                        <t t-call="bemade_portal_kit.pk_icon"><t t-set="icon" t-value="'chevron'"/></t>
                                    </span>
                                </a>
                                <a href="#pk_sg_rows" class="o_pk_entity_row">
                                    <span class="o_pk_dot o_pk_tone_red" aria-hidden="true"/>
                                    <span class="o_pk_row_text">
                                        <span class="o_pk_row_title">Third sample row</span>
                                    </span>
                                    <span class="o_pk_row_trailing">
                                        <t t-call="bemade_portal_kit.pk_icon"><t t-set="icon" t-value="'chevron'"/></t>
                                    </span>
                                </a>
                            </div>
                        </section>

                        <section class="o_pk_section">
                            <h2 class="o_pk_section_header"><span>Chips and status pills</span></h2>
                            <div class="o_pk_chips">
                                <span class="o_pk_chip o_pk_chip_red">Red</span>
                                <span class="o_pk_chip o_pk_chip_orange">Orange</span>
                                <span class="o_pk_chip o_pk_chip_yellow">Yellow</span>
                                <span class="o_pk_chip o_pk_chip_green">Green</span>
                                <span class="o_pk_chip o_pk_chip_secondary">Secondary</span>
                                <span class="o_pk_chip o_pk_chip_ghost">Ghost</span>
                            </div>
                            <p>
                                <span class="o_pk_status_pill o_pk_chip_green"><span class="o_pk_pill_text">Available</span></span>
                                <span class="o_pk_status_pill o_pk_chip_yellow"><span class="o_pk_pill_text">Limited</span></span>
                                <span class="o_pk_status_pill o_pk_chip_red"><span class="o_pk_pill_text">Unavailable</span></span>
                            </p>
                        </section>

                        <section class="o_pk_section">
                            <h2 class="o_pk_section_header"><span>Buttons</span></h2>
                            <div class="o_pk_actions_row">
                                <button type="button" class="o_pk_btn o_pk_btn_primary">Save</button>
                                <button type="button" class="o_pk_btn">Secondary</button>
                                <button type="button" class="o_pk_btn o_pk_btn_ghost">Cancel</button>
                                <button type="button" class="o_pk_btn o_pk_btn_danger">Delete</button>
                                <button type="button" class="o_pk_btn o_pk_btn_primary o_pk_btn_sm">Small</button>
                                <button type="button" class="o_pk_icon_btn" aria-label="Add" title="Add">
                                    <t t-call="bemade_portal_kit.pk_icon"><t t-set="icon" t-value="'plus'"/></t>
                                </button>
                                <button type="button" class="o_pk_link_btn">Link button</button>
                            </div>
                        </section>

                        <section class="o_pk_section">
                            <h2 class="o_pk_section_header"><span>Fields</span></h2>
                            <form class="o_pk_form" action="#" onsubmit="return false;">
                                <div class="o_pk_field">
                                    <label class="o_pk_field_label" for="pk_sg_name">Name</label>
                                    <input id="pk_sg_name" type="text" class="o_pk_input" placeholder="Type a name"/>
                                    <small class="o_pk_hint">A hint under the field.</small>
                                </div>
                                <div class="o_pk_field">
                                    <label class="o_pk_field_label" for="pk_sg_kind">Kind</label>
                                    <select id="pk_sg_kind" class="o_pk_input o_pk_select">
                                        <option>First option</option>
                                        <option>Second option</option>
                                    </select>
                                </div>
                                <div class="o_pk_field">
                                    <label class="o_pk_field_label" for="pk_sg_date">Date</label>
                                    <input id="pk_sg_date" type="date" class="o_pk_input"/>
                                </div>
                                <div class="o_pk_field">
                                    <label class="o_pk_field_label" for="pk_sg_note">Note</label>
                                    <textarea id="pk_sg_note" class="o_pk_input o_pk_textarea" rows="3"/>
                                </div>
                                <div class="o_pk_field o_pk_field_static">
                                    <span class="o_pk_field_label">Read-only value</span>
                                    <p class="o_pk_field_value">Shown, not editable</p>
                                </div>
                            </form>
                        </section>

                        <section class="o_pk_section">
                            <h2 class="o_pk_section_header"><span>Switches</span></h2>
                            <div class="o_pk_card">
                                <label class="o_pk_switch">
                                    <span class="o_pk_switch_text">
                                        <span class="o_pk_switch_label">Notifications</span>
                                        <small class="o_pk_switch_hint">A line under the label.</small>
                                    </span>
                                    <span class="o_pk_switch_control">
                                        <input type="checkbox" role="switch" class="o_pk_switch_input" checked="checked" aria-checked="true"/>
                                        <span class="o_pk_switch_track" aria-hidden="true"><span class="o_pk_switch_thumb"/></span>
                                    </span>
                                </label>
                                <label class="o_pk_switch">
                                    <span class="o_pk_switch_text">
                                        <span class="o_pk_switch_label">Weekly summary</span>
                                    </span>
                                    <span class="o_pk_switch_control">
                                        <input type="checkbox" role="switch" class="o_pk_switch_input" aria-checked="false"/>
                                        <span class="o_pk_switch_track" aria-hidden="true"><span class="o_pk_switch_thumb"/></span>
                                    </span>
                                </label>
                            </div>
                        </section>

                        <section class="o_pk_section">
                            <h2 class="o_pk_section_header"><span>Segmented control and page tabs</span></h2>
                            <div class="o_pk_segmented o_pk_segmented_full" role="group">
                                <button type="button" aria-pressed="true">Day</button>
                                <button type="button" aria-pressed="false">Week</button>
                                <button type="button" aria-pressed="false">Month</button>
                            </div>
                            <nav class="o_pk_segmented o_pk_segmented_full o_pk_page_tabs" role="tablist">
                                <a href="#pk_sg_rows" role="tab" aria-selected="true" aria-pressed="true"><span class="o_pk_tab_label">Overview</span></a>
                                <a href="#pk_sg_rows" role="tab" aria-selected="false" aria-pressed="false"><span class="o_pk_tab_badge o_pk_tab_badge_red">2</span><span class="o_pk_tab_label">Tasks</span></a>
                                <a href="#pk_sg_rows" role="tab" aria-selected="false" aria-pressed="false"><span class="o_pk_tab_label">Files</span></a>
                            </nav>
                        </section>

                        <section class="o_pk_section">
                            <h2 class="o_pk_section_header"><span>Details</span></h2>
                            <div class="o_pk_card">
                                <dl class="o_pk_kv">
                                    <dt>Reference</dt><dd>SAMPLE-0001</dd>
                                    <dt>Owner</dt><dd>Sample owner</dd>
                                    <dt>Updated</dt><dd>2 days ago</dd>
                                </dl>
                            </div>
                        </section>

                        <section class="o_pk_section">
                            <h2 class="o_pk_section_header"><span>Banners</span></h2>
                            <div class="o_pk_banner" role="status"><strong class="o_pk_banner_title">Information</strong> A neutral message.</div>
                            <div class="o_pk_banner o_pk_banner_ok" role="status"><strong class="o_pk_banner_title">Saved</strong> The change is recorded.</div>
                            <div class="o_pk_banner o_pk_banner_warn" role="status"><strong class="o_pk_banner_title">Check this</strong> Something needs a look.</div>
                        </section>

                        <section class="o_pk_section">
                            <h2 class="o_pk_section_header"><span>Empty state</span></h2>
                            <p class="o_pk_empty">Nothing here yet.</p>
                        </section>

                        <section class="o_pk_section">
                            <h2 class="o_pk_section_header"><span>Sheet</span></h2>
                            <!-- Shown in place (not modal) for the style guide. -->
                            <dialog class="o_pk_sheet" open="open" style="position: static;" aria-labelledby="pk_sg_sheet_title">
                                <div class="o_pk_sheet_head">
                                    <h2 class="o_pk_sheet_title" id="pk_sg_sheet_title">Sample sheet</h2>
                                    <button type="button" class="o_pk_icon_btn o_pk_sheet_close" aria-label="Close" title="Close">
                                        <t t-call="bemade_portal_kit.pk_icon"><t t-set="icon" t-value="'close'"/></t>
                                    </button>
                                </div>
                                <div class="o_pk_sheet_body">
                                    <p>A bottom sheet on a phone, a centred dialog on a laptop.</p>
                                    <div class="o_pk_form_actions">
                                        <button type="button" class="o_pk_btn o_pk_btn_ghost">Cancel</button>
                                        <button type="button" class="o_pk_btn o_pk_btn_primary">Confirm</button>
                                    </div>
                                </div>
                            </dialog>
                        </section>
                    </main>
                </div>
            </div>
        </t>
    </template>

</odoo>
