<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sale Order Form: Add expected_ship_date to order lines -->
    <record id="view_order_form_inherit_late_notification" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.late.notification</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list//field[@name='customer_lead']" position="after">
                <field name="expected_ship_date"/>
            </xpath>
        </field>
    </record>

    <!-- Sale Order Search: Add Late filter -->
    <record id="view_order_search_inherit_late_notification" model="ir.ui.view">
        <field name="name">sale.order.search.inherit.late.notification</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_view_search_inherit_sale"/>
        <field name="arch" type="xml">
            <filter name="order_date" position="after">
                <separator/>
                <filter string="Late"
                    name="late_orders"
                    domain="[('is_late', '=', True)]"
                    help="Sale Orders that are late"
                />
            </filter>
        </field>
    </record>

    <!-- Sale Order Tree: Add decoration for late orders -->
    <record id="sale_order_tree_inherit_late_notification" model="ir.ui.view">
        <field name="name">sale.order.tree.inherit.late.notification</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_tree"/>
        <field name="arch" type="xml">
            <field name="commitment_date" position="attributes">
                <attribute name="decoration-danger">is_late</attribute>
            </field>
        </field>
    </record>
</odoo>
