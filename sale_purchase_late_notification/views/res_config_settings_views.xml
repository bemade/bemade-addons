<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sale Order Late Notification Settings (in Sales app settings) -->
    <record id="res_config_settings_view_form_sale" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.sale.late.notification</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='quotation_order_setting_container']" position="after">
                <block title="Late Order Notifications" name="sale_late_notifications">
                    <setting string="Days Before Notification" help="Number of days after the expected date before notifying about a late sale order">
                        <field name="sale_late_notification_days"/>
                    </setting>
                    <setting string="Activity Summary" help="Summary text for the activity created on late sale orders">
                        <field name="sale_late_activity_summary"/>
                    </setting>
                    <setting string="Responsible User" help="User assigned to handle late sale order activities">
                        <field name="sale_late_activity_user_id"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

    <!-- Purchase Order Late Notification Settings (in Purchase app settings) -->
    <record id="res_config_settings_view_form_purchase" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.purchase.late.notification</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="purchase.res_config_settings_view_form_purchase"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='purchase_setting_container']" position="after">
                <block title="Late Order Notifications" name="purchase_late_notifications">
                    <setting string="Days Before Notification" help="Number of days after the planned date before notifying about a late purchase order">
                        <field name="purchase_late_notification_days"/>
                    </setting>
                    <setting string="Activity Summary" help="Summary text for the activity created on late purchase orders">
                        <field name="purchase_late_activity_summary"/>
                    </setting>
                    <setting string="Responsible User" help="User assigned to handle late purchase order activities">
                        <field name="purchase_late_activity_user_id"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
