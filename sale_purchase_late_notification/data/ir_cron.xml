<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Scheduled action to check for late sale orders -->
    <record id="ir_cron_check_late_sale_orders" model="ir.cron">
        <field name="name">Check for Late Sale Orders</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="state">code</field>
        <field name="code">model._cron_create_late_activities()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <!-- Scheduled action to check for late purchase orders -->
    <record id="ir_cron_check_late_purchase_orders" model="ir.cron">
        <field name="name">Check for Late Purchase Orders</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="state">code</field>
        <field name="code">model._cron_create_late_activities()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
