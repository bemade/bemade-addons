#. module: bemade_portal_kit_pwa
#: model_terms:ir.ui.view,arch_db:bemade_portal_kit_pwa.pk_app_install
msgid ""
"Without a connection the app only shows an offline page: no data is kept on "
"the device."
msgstr ""
"Sans connexion, l'application n'affiche qu'une page hors ligne : aucune "
"donnée n'est gardée sur l'appareil."

#. module: bemade_portal_kit_pwa
#: model_terms:ir.ui.view,arch_db:bemade_portal_kit_pwa.pk_app_offline
