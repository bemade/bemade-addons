#: model:ir.model.fields,help:bemade_portal_kit_pwa.field_res_config_settings__pk_pwa_background_color
msgid ""
"The splash screen and offline page background (#rrggbb). Empty: the app's "
"light theme colour."
msgstr ""
"Le fond de l'écran de démarrage et de la page hors ligne (#rrggbb). Vide : "
"la couleur du thème clair de l'application."

#. module: bemade_portal_kit_pwa
#: model_terms:ir.ui.view,arch_db:bemade_portal_kit_pwa.pk_pwa_res_config_settings_view_form
msgid ""
"The splash screen and offline page background, and the title bar of the "
"installed app. Empty: the app's light theme colour."
msgstr ""
"Le fond de l'écran de démarrage et de la page hors ligne, et la barre de "
"titre de l'application installée. Vide : la couleur du thème clair de "
"l'application."

#. module: bemade_portal_kit_pwa
#: model_terms:ir.ui.view,arch_db:bemade_portal_kit_pwa.pk_app_offline
