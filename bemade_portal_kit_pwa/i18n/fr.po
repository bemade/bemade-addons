"colour."
msgstr ""
"La couleur de la barre de titre de l'application installée (#rrggbb). Vide :"
" la couleur de fond."

#. module: bemade_portal_kit_pwa
#: model:ir.model.fields,help:bemade_portal_kit_pwa.field_res_company__pk_pwa_short_name
