<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="campaign_criterion_view_list" model="ir.ui.view">
        <field name="name">hr.appraisal.campaign.criterion.list</field>
        <field name="model">hr.appraisal.campaign.criterion</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="section_id"/>
                <field name="name"/>
                <field name="scale_id" optional="hide"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="campaign_criterion_view_form" model="ir.ui.view">
        <field name="name">hr.appraisal.campaign.criterion.form</field>
        <field name="model">hr.appraisal.campaign.criterion</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <field name="name"/>
                        <field name="section_id"/>
                        <field name="scale_id"/>
                        <field name="sequence"/>
                        <field name="active" invisible="1"/>
                        <field name="description"/>
                    </group>
                    <separator string="Word pictures (one description per level)"/>
                    <field name="level_ids">
                        <list editable="bottom" create="0" delete="0" default_order="value">
                            <field name="level_id" readonly="1"/>
                            <field name="description"/>
                        </list>
                    </field>
                    <div class="text-muted">
                        Changes apply to the next campaigns only: every evaluation keeps the wording it was graded with.
                        Save the criterion to get one line per level of the section's scale.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="campaign_criterion_view_search" model="ir.ui.view">
        <field name="name">hr.appraisal.campaign.criterion.search</field>
        <field name="model">hr.appraisal.campaign.criterion</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="section_id"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_section" string="Section" context="{'group_by': 'section_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_campaign_criterion" model="ir.actions.act_window">
        <field name="name">Evaluation Criteria</field>
        <field name="res_model">hr.appraisal.campaign.criterion</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_section': 1}</field>
    </record>
</odoo>
