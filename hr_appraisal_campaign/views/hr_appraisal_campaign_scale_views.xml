<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Rating scales -->
    <record id="campaign_scale_view_list" model="ir.ui.view">
        <field name="name">hr.appraisal.campaign.scale.list</field>
        <field name="model">hr.appraisal.campaign.scale</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="level_count" string="Levels"/>
                <field name="max_value"/>
            </list>
        </field>
    </record>

    <record id="campaign_scale_view_form" model="ir.ui.view">
        <field name="name">hr.appraisal.campaign.scale.form</field>
        <field name="model">hr.appraisal.campaign.scale</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Four-level scale"/></h1>
                    </div>
                    <field name="active" invisible="1"/>
                    <notebook>
                        <page string="Levels" name="levels">
                            <field name="level_ids">
                                <list editable="bottom" default_order="value">
                                    <field name="value"/>
                                    <field name="name"/>
                                    <field name="color" optional="show"/>
                                    <field name="display_color" column_invisible="True"/>
                                </list>
                            </field>
                            <div class="text-muted">
                                Each level is a grade (value) with its name. Criteria get one word picture per level.
                            </div>
                        </page>
                        <page string="Campaign Defaults" name="defaults">
                            <group>
                                <group>
                                    <field name="default_target_score"/>
                                    <field name="default_alignment_gap"/>
                                </group>
                            </group>
                            <separator string="Overall thresholds (points of the final total)"/>
                            <field name="threshold_ids">
                                <list editable="bottom" default_order="min_score desc">
                                    <field name="level_id" domain="[('scale_id', '=', parent.id)]" options="{'no_create': True}"/>
                                    <field name="min_score"/>
                                </list>
                            </field>
                            <div class="text-muted">
                                New campaigns copy these values and the thresholds of the sections; each campaign
                                then keeps its own.
                            </div>
                        </page>
                        <page string="Sections" name="sections">
                            <field name="section_ids" readonly="1">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="criterion_count" string="Criteria"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_campaign_scale" model="ir.actions.act_window">
        <field name="name">Rating Scales</field>
        <field name="res_model">hr.appraisal.campaign.scale</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define the rating scale</p>
            <p>A scale lists the levels a criterion is graded with (e.g. 1 Unsatisfactory to 4 Superior).</p>
        </field>
    </record>

    <!-- Sections -->
    <record id="campaign_section_view_list" model="ir.ui.view">
        <field name="name">hr.appraisal.campaign.section.list</field>
        <field name="model">hr.appraisal.campaign.section</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="scale_id"/>
                <field name="criterion_count" string="Criteria"/>
            </list>
        </field>
    </record>

    <record id="campaign_section_view_form" model="ir.ui.view">
        <field name="name">hr.appraisal.campaign.section.form</field>
        <field name="model">hr.appraisal.campaign.section</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <field name="name"/>
                        <field name="scale_id"/>
                        <field name="sequence"/>
                        <field name="active" invisible="1"/>
                    </group>
                    <separator string="Default thresholds (points of the section's final total)"/>
                    <field name="threshold_ids">
                        <list editable="bottom" default_order="min_score desc">
                            <field name="scale_id" column_invisible="True"/>
                            <field name="level_id" domain="[('scale_id', '=', scale_id)]" options="{'no_create': True}"/>
                            <field name="min_score"/>
                        </list>
                    </field>
                    <separator string="Criteria"/>
                    <field name="criterion_ids" readonly="1">
                        <list>
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_campaign_section" model="ir.actions.act_window">
        <field name="name">Evaluation Sections</field>
        <field name="res_model">hr.appraisal.campaign.section</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
