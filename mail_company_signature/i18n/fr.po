#. module: mail_company_signature
#: model:ir.model.fields,help:mail_company_signature.field_res_users__personal_signature_backup
msgid ""
"Signature the user had before the company-standard signature was enforced."
msgstr ""
"Signature de l'utilisateur avant l'application de la signature standard de "
"l'entreprise."

#. module: mail_company_signature
#: model:ir.model.fields,help:mail_company_signature.field_res_company__company_signature_notice
#: model:ir.model.fields,help:mail_company_signature.field_res_config_settings__company_signature_notice
msgid ""
"Temporary notice (closure, holiday hours...) shown where the template has "
"{{company_notice}}."
msgstr ""
"Avis temporaire (fermeture, horaire des fêtes...) affiché à l'endroit du "
"modèle où se trouve {{company_notice}}."

#. module: mail_company_signature
#: model_terms:ir.ui.view,arch_db:mail_company_signature.res_config_settings_view_form
msgid ""
"The company notice replaces {{company_notice}} in the\n"
"                            template until the \"Show until\" day included; it is then\n"
"                            removed automatically."
msgstr ""
"L'avis de l'entreprise remplace {{company_notice}} dans le\n"
"                            modèle jusqu'au jour « Afficher jusqu'au » inclus; il est ensuite\n"
"                            retiré automatiquement."

#. module: mail_company_signature
#: model_terms:ir.ui.view,arch_db:mail_company_signature.view_users_form
#: model_terms:ir.ui.view,arch_db:mail_company_signature.view_users_form_simple_modif
