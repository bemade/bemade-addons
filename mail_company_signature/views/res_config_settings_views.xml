<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.company.signature</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mail.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@id='emails']" position="inside">
                <setting
          id="company_signature_setting"
          string="Company-standard Signature"
          help="Generate the email signature of every internal user from one template. Users can no longer edit their own signature."
          company_dependent="1"
          groups="base.group_system"
        >
                    <field name="company_signature_enforced" />
                    <div
            class="content-group mt16"
            invisible="not company_signature_enforced"
          >
                        <field
              name="company_signature_template"
              options="{'codeview': true, 'height': 220, 'resizable': true}"
              class="border border-secondary"
            />
                        <div class="text-muted mt8">
                            Placeholders: {{name}}, {{job_title}}, {{job_position}},
                            {{work_phone}}, {{mobile_phone}}, {{work_email}},
                            {{company_name}}, {{company_phone}}, {{company_email}},
                            {{company_website}}, {{company_notice}}.
                            {{job_position}} shows the job position in French and
                            English ("FR / EN"), or the job title without a position.
                            Unknown placeholders are left as typed. Write one optional
                            line per paragraph: a paragraph whose placeholders are all
                            empty (for example a user without a mobile) is removed
                            entirely, label included. Turning the policy off keeps each
                            user's last generated signature; the original is kept in
                            the user form and can be restored there.
                        </div>
                        <div class="mt16">
                            <label
                for="company_signature_notice"
                class="o_form_label"
              />
                            <field
                name="company_signature_notice"
                options="{'height': 80, 'resizable': true}"
                class="border border-secondary"
              />
                        </div>
                        <div class="mt8">
                            <label
                for="company_signature_notice_until"
                class="o_form_label me-2"
              />
                            <field name="company_signature_notice_until" />
                        </div>
                        <div class="text-muted mt8">
                            The company notice replaces {{company_notice}} in the
                            template until the "Show until" day included; it is then
                            removed automatically.
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
