<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="sale_order_portal_content_inherit_sale_mandatory_reference" inherit_id="sale.sale_order_portal_content" priority="30">
        <xpath expr="//div[@id='informations']" position="inside">
            <div t-if="sale_order.state in ('draft', 'sent')" 
                 class="col-12 col-lg-6 mb-4 o_portal_sale_reference" 
                 t-att-data-order-id="sale_order.id"
                 t-att-data-access-token="access_token">
                <h5 class="mb-1">Your Reference (# PO)</h5>
                <hr class="mt-1 mb-2"/>
                <input type="text" 
                       class="form-control" 
                       name="client_order_ref" 
                       t-att-value="sale_order.client_order_ref or ''" 
                       placeholder="Enter your purchase order number"
                       t-att-required="enforce_customer_reference"/>
                <small t-if="enforce_customer_reference" class="text-muted">
                    A reference (PO number) is required before confirming this order.
                </small>
            </div>
        </xpath>
    </template>

    <template id="sale_order_portal_template_inherit_sale_mandatory_reference" inherit_id="sale.sale_order_portal_template" priority="30">
        <xpath expr="//div[@id='quote_content']" position="attributes">
            <attribute name="t-att-data-reference-required">enforce_customer_reference</attribute>
        </xpath>
        <!-- The customer must not be able to open the signature dialog while
             the reference is missing. The buttons are rendered disabled and
             portal_sale.js enables them once the reference is saved. -->
        <xpath expr="//div[@id='sale_order_sidebar_button']/a[@t-if]" position="before">
            <div t-if="sale_order._portal_reference_missing()" class="alert alert-warning mb-0 d-flex align-items-start gap-2 o_portal_reference_alert" role="alert">
                <i class="fa fa-exclamation-triangle mt-1"/>
                <!-- block wrapper: keeps the sentence out of the icon's inline
                     run so the translation term is the bare sentence -->
                <div>A reference (PO number) is required before confirming this order.</div>
            </div>
        </xpath>
        <xpath expr="//div[@id='sale_order_sidebar_button']/a[@t-if]" position="attributes">
            <attribute name="class"/>
            <attribute name="t-attf-class">btn btn-primary o_portal_reference_gate #{'disabled pe-none' if sale_order._portal_reference_missing() else ''}</attribute>
            <attribute name="t-att-aria-disabled">'true' if sale_order._portal_reference_missing() else None</attribute>
        </xpath>
        <xpath expr="//div[@name='sale_order_actions']/t[@t-if]" position="before">
            <div t-if="sale_order._portal_reference_missing()" class="alert alert-warning mb-0 d-flex align-items-start gap-2 o_portal_reference_alert" role="alert">
                <i class="fa fa-exclamation-triangle mt-1"/>
                <!-- block wrapper: keeps the sentence out of the icon's inline
                     run so the translation term is the bare sentence -->
                <div>A reference (PO number) is required before confirming this order.</div>
            </div>
        </xpath>
        <xpath expr="//div[@name='sale_order_actions']/t[@t-if]/div[1]/a" position="attributes">
            <attribute name="class"/>
            <attribute name="t-attf-class">btn btn-primary o_portal_reference_gate #{'disabled pe-none' if sale_order._portal_reference_missing() else ''}</attribute>
            <attribute name="t-att-aria-disabled">'true' if sale_order._portal_reference_missing() else None</attribute>
        </xpath>
    </template>
</odoo>
