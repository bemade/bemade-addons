<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="conversation_transport_view_form_gmail" model="ir.ui.view">
        <field name="name">conversation.transport.view.form.gmail</field>
        <field name="model">conversation.transport</field>
        <field
      name="inherit_id"
      ref="conversation_base.conversation_transport_view_form"
    />
        <field name="arch" type="xml">
            <group name="capabilities" position="after">
                <group
          name="gmail_oauth"
          string="Gmail"
          invisible="provider != 'gmail'"
        >
                    <field name="imap_folder" />
                    <!-- Blank = discover Gmail's Trash via SPECIAL-USE (it
                         is localised, e.g. [Gmail]/Corbeille), else
                         [Gmail]/Trash. Archive is a label removal and
                         needs no folder; Sent is filed by Gmail itself. -->
                    <field name="imap_trash_folder" />
                    <!-- Both blank (the common case) uses the
                         instance-wide Client ID/Secret configured under
                         Settings > General Settings > Emails > "Use a
                         Gmail Server" - the right choice for a Google
                         Workspace org sharing one OAuth app. Fill these
                         in only to connect a personal Gmail account with
                         its own Google Cloud OAuth client instead (task
                         #3965, AC4): Workspace-vs-personal is a UI
                         choice made here, not a separate provider or
                         model. groups="base.group_system" on the Secret
                         matches the OAuth token fields below - a
                         credential, not readable by an ordinary user. -->
                    <field name="client_id" />
                    <field
            name="client_secret"
            password="True"
            groups="base.group_system"
          />
                    <!-- The tokens themselves stay administrator-only; the
                         owner of a personal account only ever sees the
                         non-secret gmail_connected indicator, and may start
                         (or restart) the Google consent flow on their own
                         account. The server enforces ownership. -->
                    <field name="gmail_connected" invisible="1" />
                    <div>
                        <button
              name="open_google_gmail_uri"
              type="object"
              string="Connect to Google"
              class="btn-primary"
              invisible="gmail_connected"
            />
                        <button
              name="open_google_gmail_uri"
              type="object"
              string="Reconnect"
              invisible="not gmail_connected"
            />
                        <span invisible="not gmail_connected">
                            Connected.
                        </span>
                    </div>
                </group>
            </group>
        </field>
    </record>
</odoo>
