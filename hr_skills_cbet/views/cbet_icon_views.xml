<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cbet_icon_list" model="ir.ui.view">
        <field name="name">cbet.icon.list</field>
        <field name="model">cbet.icon</field>
        <field name="arch" type="xml">
            <list>
                <field name="svg" widget="image" string="SVG"/>
                <field name="emoji"/>
                <field name="token"/>
                <field name="name"/>
                <field name="category"/>
                <field name="iso_ref" optional="show"/>
                <field name="svg_filename" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_cbet_icon_form" model="ir.ui.view">
        <field name="name">cbet.icon.form</field>
        <field name="model">cbet.icon</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="token" placeholder="epi-lunettes"/>
                            <field name="name"/>
                            <field name="category"/>
                        </group>
                        <group>
                            <field name="emoji"/>
                            <field name="iso_ref"/>
                            <field name="svg" filename="svg_filename"/>
                            <field name="svg_filename" invisible="1"/>
                            <field name="svg" widget="image" string="Preview" readonly="1"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cbet_icon_search" model="ir.ui.view">
        <field name="name">cbet.icon.search</field>
        <field name="model">cbet.icon</field>
        <field name="arch" type="xml">
            <search>
                <field name="token"/>
                <field name="name"/>
                <group>
                    <filter name="group_category" string="Category" context="{'group_by': 'category'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_cbet_icon" model="ir.actions.act_window">
        <field name="name">Icons</field>
        <field name="res_model">cbet.icon</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_cbet_icon_search"/>
        <field name="context">{'search_default_group_category': 1}</field>
    </record>
</odoo>
