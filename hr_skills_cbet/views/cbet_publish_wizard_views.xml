<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cbet_publish_wizard_form" model="ir.ui.view">
        <field name="name">cbet.publish.wizard.form</field>
        <field name="model">cbet.publish.wizard</field>
        <field name="arch" type="xml">
            <form string="Publish">
                <group>
                    <field name="competency_id" readonly="1"/>
                    <field name="current_version" invisible="first_publication"/>
                    <field name="next_version"/>
                    <field name="first_publication" invisible="1"/>
                </group>
                <field name="changes_html" nolabel="1" readonly="1"/>
                <div class="text-muted">
                    Publishing freezes the documents, criteria and protocol as this version;
                    evaluations pin the version they are run against.
                </div>
                <footer>
                    <button name="action_confirm" type="object" string="Publish"
                            class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
