<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Evaluation unit form (opened from the competency's Units tab). -->
    <record id="view_cbet_unit_form" model="ir.ui.view">
        <field name="name">cbet.evaluation.unit.form</field>
        <field name="model">cbet.evaluation.unit</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="competency_id" readonly="1"/>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="required"/>
                        <field name="is_default" readonly="1"/>
                    </group>
                    <field name="protocol_notes" placeholder="Optional protocol override…"/>
                    <separator string="Criteria"/>
                    <field name="criterion_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="criterion_type"/>
                            <field name="text"/>
                            <field name="verification_method"/>
                            <field name="tolerance"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cbet_competency_list" model="ir.ui.view">
        <field name="name">cbet.competency.list</field>
        <field name="model">cbet.competency</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'draft'">
                <field name="code"/>
                <field name="name"/>
                <field name="domain_id"/>
                <field name="kind"/>
                <field name="version"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'published'"/>
            </list>
        </field>
    </record>

    <record id="view_cbet_competency_search" model="ir.ui.view">
        <field name="name">cbet.competency.search</field>
        <field name="model">cbet.competency</field>
        <field name="arch" type="xml">
            <search>
                <field name="code"/>
                <field name="name"/>
                <field name="domain_id"/>
                <filter name="published" string="Published" domain="[('state','=','published')]"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <group>
                    <filter name="group_domain" string="Domain" context="{'group_by': 'domain_id'}"/>
                    <filter name="group_kind" string="Kind" context="{'group_by': 'kind'}"/>
                    <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_cbet_competency_form" model="ir.ui.view">
        <field name="name">cbet.competency.form</field>
        <field name="model">cbet.competency</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_publish" type="object" string="Publish"
                            class="btn-primary" invisible="state == 'published'"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to draft"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="code" placeholder="XXX-NN"/></h1>
                        <h2><field name="name" placeholder="Competency name"/></h2>
                    </div>
                    <group>
                        <group>
                            <field name="domain_id"/>
                            <field name="kind"/>
                        </group>
                        <group>
                            <field name="version" readonly="1"/>
                            <field name="publish_date" readonly="1"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Units &amp; Criteria">
                            <field name="unit_ids" context="{'default_competency_id': id}">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="required"/>
                                    <field name="is_default"/>
                                </list>
                            </field>
                        </page>
                        <page string="Part B — Questions">
                            <field name="question_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="text"/>
                                    <field name="expected_answer"/>
                                    <field name="section_ref"/>
                                    <field name="essential"/>
                                </list>
                            </field>
                        </page>
                        <page string="Prerequisites">
                            <field name="prerequisite_ids">
                                <list editable="bottom">
                                    <field name="prerequisite_id"/>
                                    <field name="prereq_type"/>
                                </list>
                            </field>
                        </page>
                        <page string="Protocol &amp; Policy">
                            <group>
                                <group string="Protocol">
                                    <field name="protocol_method"/>
                                    <field name="protocol_place"/>
                                    <field name="protocol_duration"/>
                                    <field name="protocol_support"/>
                                    <field name="protocol_min_evaluator_qualification"/>
                                    <field name="designated_trainer_ids" widget="many2many_tags"/>
                                </group>
                                <group string="Validity &amp; scoring">
                                    <field name="pass_threshold"/>
                                    <field name="validity_months"/>
                                    <field name="reprise_deadline_days"/>
                                </group>
                            </group>
                        </page>
                        <page string="Content">
                            <group>
                                <field name="field_frequency"/>
                                <field name="difficulty"/>
                                <field name="learning_time"/>
                            </group>
                            <separator string="Execution context"/>
                            <field name="execution_context"/>
                            <separator string="Safety"/>
                            <field name="safety_block"/>
                            <separator string="Tools &amp; materials"/>
                            <field name="tools_materials"/>
                            <separator string="Common pitfalls"/>
                            <field name="common_pitfalls"/>
                        </page>
                        <page string="Versions">
                            <field name="version_ids" readonly="1">
                                <list>
                                    <field name="version"/>
                                    <field name="publish_date"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_cbet_competency" model="ir.actions.act_window">
        <field name="name">Competencies</field>
        <field name="res_model">cbet.competency</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_cbet_competency_search"/>
    </record>
</odoo>
