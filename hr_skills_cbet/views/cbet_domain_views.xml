<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cbet_domain_list" model="ir.ui.view">
        <field name="name">cbet.domain.list</field>
        <field name="model">cbet.domain</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="competency_count"/>
            </list>
        </field>
    </record>

    <record id="view_cbet_domain_form" model="ir.ui.view">
        <field name="name">cbet.domain.form</field>
        <field name="model">cbet.domain</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active" widget="boolean_toggle"/>
                    </group>
                    <field name="competency_ids" readonly="1">
                        <list>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="state"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cbet_domain" model="ir.actions.act_window">
        <field name="name">Domains</field>
        <field name="res_model">cbet.domain</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
