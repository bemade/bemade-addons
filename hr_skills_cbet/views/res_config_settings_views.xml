<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_cbet" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.cbet</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='employees_setting_container']" position="after">
                <block title="CBET — Competency training" name="cbet_settings_container">
                    <setting string="Default certification validity"
                             help="Seeds each competency's validity (months).">
                        <field name="cbet_default_validity_months"/>
                    </setting>
                    <setting string="Retake completion deadline"
                             help="Seeds each competency's targeted-retake deadline (days).">
                        <field name="cbet_reprise_deadline_days"/>
                    </setting>
                    <setting string="Expiry warning horizon"
                             help="How far ahead certifications are flagged 'expiring' (months).">
                        <field name="cbet_expiry_horizon_months"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
