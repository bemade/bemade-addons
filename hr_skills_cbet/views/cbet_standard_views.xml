<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cbet_standard_list" model="ir.ui.view">
        <field name="name">cbet.standard.list</field>
        <field name="model">cbet.standard</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="parent_standard_id"/>
                <field name="required_count"/>
                <field name="skill_id"/>
            </list>
        </field>
    </record>

    <record id="view_cbet_standard_form" model="ir.ui.view">
        <field name="name">cbet.standard.form</field>
        <field name="model">cbet.standard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Standard name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="parent_standard_id"/>
                            <field name="is_sub_qualification" readonly="1"/>
                            <field name="skill_id"/>
                        </group>
                        <group>
                            <field name="required_count"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <field name="role_description" placeholder="Role description…"/>
                    <notebook>
                        <page string="Competency lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="competency_id"/>
                                    <field name="line_type"/>
                                </list>
                            </field>
                        </page>
                        <page string="Full requirement set (closure)">
                            <group>
                                <field name="essential_competency_ids" widget="many2many_tags"
                                       readonly="1"/>
                                <field name="pulled_in_competency_ids" widget="many2many_tags"
                                       readonly="1"/>
                                <field name="closed_competency_ids" widget="many2many_tags"
                                       readonly="1"/>
                            </group>
                        </page>
                        <page string="Qualifications">
                            <field name="qualification_ids" readonly="1">
                                <list decoration-success="state == 'qualified'"
                                      decoration-warning="state == 'suspended'">
                                    <field name="employee_id"/>
                                    <field name="state"/>
                                    <field name="percent_complete" widget="progressbar"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cbet_standard" model="ir.actions.act_window">
        <field name="name">Standards</field>
        <field name="res_model">cbet.standard</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
