<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The printable legend of the job-aid pictograms: every catalog icon,
         grouped by category, with its token, name, emoji stand-in and ISO
         reference. Printed from the Icons list (any selection) or from the
         Configuration menu (the whole active catalog). Same Letter format and
         inline style as the training documents. -->

    <record id="action_report_cbet_icon_legend" model="ir.actions.report">
        <field name="name">Icon legend</field>
        <field name="model">cbet.icon</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hr_skills_cbet.report_cbet_icon_legend</field>
        <field name="report_file">hr_skills_cbet.report_cbet_icon_legend</field>
        <field name="print_report_name">'icon_legend'</field>
        <field name="paperformat_id" ref="paperformat_cbet_letter"/>
        <field name="binding_model_id" ref="model_cbet_icon"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_cbet_icon_legend">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page cbet-doc cbet-legend">
                    <t t-call="hr_skills_cbet.cbet_document_style"/>
                    <style>
                        .cbet-legend table { font-size: 9pt; }
                        .cbet-legend th { background: #f7f7f7; }
                        .cbet-legend td, .cbet-legend th { vertical-align: middle; }
                        .cbet-legend .c-icon { width: 14%; white-space: nowrap; }
                        .cbet-legend .c-token { width: 20%; font-family: monospace; }
                        .cbet-legend .c-emoji { width: 9%; text-align: center; }
                        .cbet-legend .c-iso { width: 15%; }
                        .cbet-legend .cbet-icon-lg { height: 10mm; width: 10mm; margin-right: 6pt; }
                    </style>
                    <div class="cbet-kind">Field job aids</div>
                    <h1>Icon legend</h1>
                    <p class="cbet-subtitle">Each pictogram is shown at 10 mm and at the size printed on the job aids (5 mm).</p>
                    <t t-foreach="groups" t-as="g">
                        <h2><t t-out="g['label']"/></h2>
                        <table>
                            <thead>
                                <tr>
                                    <th class="c-icon">Icon</th>
                                    <th class="c-token">Token</th>
                                    <th>Name</th>
                                    <th class="c-emoji">Emoji</th>
                                    <th class="c-iso">ISO reference</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="g['icons']" t-as="icon">
                                    <td class="c-icon">
                                        <t t-if="icon.svg">
                                            <img class="cbet-icon cbet-icon-lg" t-att-src="icon._svg_data_uri()" t-att-alt="icon.name"/>
                                            <img class="cbet-icon" t-att-src="icon._svg_data_uri()" t-att-alt="icon.name"/>
                                        </t>
                                        <span t-else="" class="cbet-icon-emoji" t-out="icon.emoji"/>
                                    </td>
                                    <td class="c-token"><t t-out="icon.token"/></td>
                                    <td><span t-field="icon.name"/></td>
                                    <td class="c-emoji"><t t-out="icon.emoji or '—'"/></td>
                                    <td class="c-iso"><t t-out="icon.iso_ref or '—'"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </t>
                </div>
            </t>
        </t>
    </template>
</odoo>
