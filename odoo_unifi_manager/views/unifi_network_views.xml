<odoo>
    <!-- Vue Liste pour les Réseaux -->
    <record id="view_network_tree" model="ir.ui.view">
        <field name="name">unifi.network.tree</field>
        <field name="model">unifi.network</field>
        <field name="arch" type="xml">
            <tree string="Networks">
                <field name="name"/>
                <field name="cidr"/>
                <field name="gateway"/>
                <field name="vlan_id"/>
                <field name="ctrl_id"/>
                <field name="last_sync"/>
            </tree>
        </field>
    </record>

    <!-- Vue Formulaire pour les Réseaux -->
    <record id="view_network_form" model="ir.ui.view">
        <field name="name">unifi.network.form</field>
        <field name="model">unifi.network</field>
        <field name="arch" type="xml">
            <form string="Network">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="cidr"/>
                            <field name="gateway"/>
                        </group>
                        <group>
                            <field name="vlan_id"/>
                            <field name="ctrl_id"/>
                            <field name="description"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>