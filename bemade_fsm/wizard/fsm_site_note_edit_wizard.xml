<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="fsm_site_note_edit_wizard_view_form" model="ir.ui.view">
        <field name="name">fsm.site.note.edit.wizard.view.form</field>
        <field name="model">fsm.site.note.edit.wizard</field>
        <field name="arch" type="xml">
            <form string="Update site note">
                <field name="task_id" invisible="1" />
                <p class="text-muted">
                    This note shows as a banner on every service task at
                    <field
            name="partner_id"
            readonly="1"
            class="d-inline fw-bold"
            options="{'no_open': True}"
          />
                    until someone clears it. Every change is kept in the site's history.
                </p>
                <field
          name="note"
          nolabel="1"
          class="w-100"
          placeholder="E.g.: gate code changed, bring the tall ladder"
        />
                <footer>
                    <button
            class="btn-primary"
            name="action_save"
            type="object"
            string="Save"
            data-hotkey="q"
          />
                    <button
            class="btn-secondary"
            special="cancel"
            string="Cancel"
            data-hotkey="x"
          />
                </footer>
            </form>
        </field>
    </record>
</odoo>
