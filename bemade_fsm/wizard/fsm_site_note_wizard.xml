<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="fsm_site_note_wizard_view_form" model="ir.ui.view">
        <field name="name">fsm.site.note.wizard.view.form</field>
        <field name="model">fsm.site.note.wizard</field>
        <field name="arch" type="xml">
            <form string="Anything to remember next time at this site?">
                <field name="task_id" invisible="1" />
                <p class="text-muted">
                    This note shows as a banner on every service task at
                    <field
            name="partner_id"
            readonly="1"
            class="d-inline fw-bold"
            options="{'no_open': True}"
          />
                    until someone clears it.
                </p>
                <field
          name="note"
          nolabel="1"
          class="w-100"
          placeholder="E.g.: gate code changed, bring the tall ladder"
        />
                <field name="task_equipment_ids" invisible="1" />
                <div class="fw-bold mt-3">To do on the next visit</div>
                <p class="text-muted small mb-1">
                    Each line becomes a « From last visit » subtask on the next
                    visit at this site.
                </p>
                <field name="todo_line_ids" nolabel="1">
                    <list editable="bottom">
                        <field
              name="name"
              placeholder="E.g.: replace the gasket on the softener"
            />
                        <field
              name="equipment_id"
              domain="[('id', 'in', parent.task_equipment_ids)]"
              options="{'no_create': True, 'no_open': True}"
            />
                    </list>
                </field>
                <footer>
                    <button
            class="btn-primary"
            name="action_save"
            type="object"
            string="Save &amp; close"
            data-hotkey="q"
          />
                    <button
            class="btn-secondary"
            name="action_skip"
            type="object"
            string="Skip"
            data-hotkey="k"
          />
                    <button
            class="btn-secondary"
            special="cancel"
            string="Cancel"
            data-hotkey="x"
          />
                </footer>
            </form>
        </field>
    </record>
</odoo>
