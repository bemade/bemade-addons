<?xml version="1.0" ?>
<odoo>
    <record id="partner_equipment_location_view_form" model="ir.ui.view">
        <field name="name">partner.equipment.location.view.form</field>
        <field name="model">res.partner</field>
        <field
      name="inherit_id"
      ref="fsm_equipment.partner_equipment_location_view_form"
    />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
          name="action_view_fsm_carried_todos"
          type="object"
          class="oe_stat_button"
          icon="fa-list-ul"
          groups="industry_fsm.group_fsm_user"
          invisible="not fsm_carried_todo_ids"
        >
                    <field
            name="fsm_carried_todo_count"
            widget="statinfo"
            string="Next-visit to-dos"
          />
                    <field name="fsm_carried_todo_ids" invisible="1" />
                </button>
            </div>
            <xpath expr="//sheet/notebook" position="before">
                <div
          name="fsm_site_note_block"
          class="mb-3"
          groups="industry_fsm.group_fsm_user"
        >
                    <label for="fsm_site_note" class="fw-bold" />
                    <field
            name="fsm_site_note"
            class="o_fsm_site_note_text"
            placeholder="E.g.: gate code changed, bring the tall ladder"
          />
                    <div class="text-muted small">
                        Shown as a banner on every service task at this address until cleared.
                    </div>
                    <div
            class="mt-2 o_fsm_site_note_history"
            invisible="not fsm_site_note_history_ids"
          >
                        <div class="fw-bold small">History</div>
                        <field
              name="fsm_site_note_history_ids"
              readonly="1"
              nolabel="1"
            >
                            <list create="0" delete="0" limit="10">
                                <field name="note_datetime" />
                                <field name="author_id" widget="many2one_avatar_user" />
                                <field name="content" />
                                <field name="task_id" optional="show" />
                            </list>
                        </field>
                    </div>
                </div>
            </xpath>
            <page name="equipment" position="attributes">
                <attribute name="invisible">site_ids</attribute>
            </page>
            <page name="equipment" position="after">
                <page name="Service Contacts" invisible="site_ids">
                    <field
            name="site_contacts"
            context="{'list_view_ref': 'bemade_fsm.fsm_contacts_view_list'}"
          />
                    <field
            name="work_order_contacts"
            context="{'list_view_ref': 'bemade_fsm.fsm_contacts_view_list'}"
          />
                </page>
                <field name="is_service_site" invisible="True" />
                <page name="Service Sites" invisible="is_service_site">
                    <group>
                        <field name="site_ids">
                            <list editable="bottom">
                                <field name="name" widget="res_partner_many2one" />
                            </list>
                        </field>
                    </group>
                </page>
            </page>
        </field>
    </record>
    <record id="fsm_contacts_view_list" model="ir.ui.view">
        <field name="name">bemade_fsm.contacts.list</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list editable="bottom" open_form_view="True">
                <field name="name" />
                <field name="email" widget="email" />
                <field name="phone" widget="phone" />
            </list>
        </field>
    </record>
</odoo>
