<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <!-- Buttons of the bemade_fsm task list: 'Create from Template'. In 19.0 web.ListView.Buttons
         is an empty template (the New button lives in the control panel), so this template is
         standalone instead of an xpath into it. -->
    <t t-name="bemade_fsm.ProjectTaskList.Buttons">
        <button type="button" class="btn btn-primary ms-1"
                t-if="activeActions and activeActions.create"
                t-on-click="onCreateFromTemplate"
                title="Create Task from Template">
            Create from Template
        </button>
    </t>
</templates>
