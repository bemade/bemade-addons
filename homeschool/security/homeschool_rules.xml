<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- One instance, several families: each family is a res.company.

         Manager rules (one per family-owned model): a manager sees the companies he is attached
         to. Curriculum items, item dependencies and subjects are shared (no company, no rule);
         what a family has done about an item is its own homeschool.item.coverage row (ruled).

         Portal rules: a portal user reaches
           - his own student (student.user_id) and the students he is attached to as a resource
             user (student.resource_user_ids) — read; subjects are shared (access line, no rule);
           - the days, blocks, deliverables, reading books and reading entries of those students
             — read;
           - the INSTITUTIONAL traces and material of the companies of those students — read;
           - the traces HE submitted while they wait for the parent's validation — read, create
             and write (the model's guard keeps ``validated``, ``diffusion``, ``note``,
             ``student_id``… out of his reach; a validated trace leaves the rule's domain);
           - write: his own student's deliverables (the model limits him to ``done``) and his own
             student's reading entries (write + create). Resource users write nothing else.
         There is deliberately no portal rule and no portal access line on homeschool.journal,
         homeschool.indicator, homeschool.indicator.value and homeschool.review: the parent's
         journal and the indicators never reach the portal. This file is not noupdate: the rules
         refresh on every upgrade. -->
    <record id="rule_student_company" model="ir.rule">
        <field name="name">Students: manager sees his companies</field>
        <field name="model_id" ref="model_homeschool_student"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('homeschool.group_homeschool_manager'))]"/>
    </record>
