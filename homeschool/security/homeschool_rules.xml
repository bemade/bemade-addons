    <record id="rule_student_portal_own" model="ir.rule">
        <field name="name">Students: portal sees his own student and the students he follows</field>
        <field name="model_id" ref="model_homeschool_student"/>
        <field name="domain_force">['|', ('user_id', '=', user.id), ('resource_user_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[Command.link(ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_day_portal_own" model="ir.rule">
        <field name="name">Days: portal sees his student's days (own or resource user)</field>
        <field name="model_id" ref="model_homeschool_day"/>
        <field name="domain_force">['|', ('student_id.user_id', '=', user.id), ('student_id.resource_user_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[Command.link(ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
