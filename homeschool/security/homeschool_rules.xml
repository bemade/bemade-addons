<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- One instance, several families: each family is a res.company.

         Manager rules (one per family-owned model): a manager sees the companies he is attached
         to. Curriculum items, item dependencies and subjects are shared (no company, no rule).

         Portal rules (read-only): a portal user reaches
           - the days and blocks of his own student (student.user_id) and of the students he is
             attached to as a resource user (student.resource_user_ids);
           - the INSTITUTIONAL traces and material of the companies of those students.
         There is deliberately no portal rule and no portal access line on homeschool.journal,
         homeschool.indicator, homeschool.indicator.value and homeschool.review: the parent's
         journal and the indicators never reach the portal. This file is not noupdate: the rules
         refresh on every upgrade. -->
    <record id="rule_student_company" model="ir.rule">
        <field name="name">Students: manager sees his companies</field>
        <field name="model_id" ref="model_homeschool_student"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('homeschool.group_homeschool_manager'))]"/>
    </record>
    <record id="rule_year_company" model="ir.rule">
        <field name="name">School years: manager sees his companies</field>
        <field name="model_id" ref="model_homeschool_year"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('homeschool.group_homeschool_manager'))]"/>
    </record>
    <record id="rule_day_company" model="ir.rule">
        <field name="name">Days: manager sees his companies</field>
        <field name="model_id" ref="model_homeschool_day"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('homeschool.group_homeschool_manager'))]"/>
    </record>
    <record id="rule_block_company" model="ir.rule">
        <field name="name">Blocks: manager sees his companies</field>
        <field name="model_id" ref="model_homeschool_block"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('homeschool.group_homeschool_manager'))]"/>
    </record>
    <record id="rule_trace_company" model="ir.rule">
        <field name="name">Traces: manager sees his companies</field>
        <field name="model_id" ref="model_homeschool_trace"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('homeschool.group_homeschool_manager'))]"/>
    </record>
    <record id="rule_review_company" model="ir.rule">
        <field name="name">Reviews: manager sees his companies</field>
        <field name="model_id" ref="model_homeschool_review"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('homeschool.group_homeschool_manager'))]"/>
    </record>
    <record id="rule_project_company" model="ir.rule">
        <field name="name">Projects: manager sees his companies</field>
        <field name="model_id" ref="model_homeschool_project"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('homeschool.group_homeschool_manager'))]"/>
    </record>
    <record id="rule_material_company" model="ir.rule">
        <field name="name">Material: manager sees his companies</field>
        <field name="model_id" ref="model_homeschool_material"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('homeschool.group_homeschool_manager'))]"/>
    </record>
    <record id="rule_block_template_company" model="ir.rule">
        <field name="name">Block templates: manager sees his companies</field>
        <field name="model_id" ref="model_homeschool_block_template"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('homeschool.group_homeschool_manager'))]"/>
    </record>
    <record id="rule_indicator_company" model="ir.rule">
        <field name="name">Indicators: manager sees his companies</field>
        <field name="model_id" ref="model_homeschool_indicator"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('homeschool.group_homeschool_manager'))]"/>
    </record>
    <record id="rule_indicator_value_company" model="ir.rule">
        <field name="name">Indicator values: manager sees his companies</field>
        <field name="model_id" ref="model_homeschool_indicator_value"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('homeschool.group_homeschool_manager'))]"/>
    </record>
    <record id="rule_journal_company" model="ir.rule">
        <field name="name">Journal: manager sees his companies</field>
        <field name="model_id" ref="model_homeschool_journal"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('homeschool.group_homeschool_manager'))]"/>
    </record>
    <record id="rule_day_portal_own" model="ir.rule">
        <field name="name">Days: portal sees his student's days (own or resource user)</field>
        <field name="model_id" ref="model_homeschool_day"/>
        <field name="domain_force">['|', ('student_id.user_id', '=', user.id), ('student_id.resource_user_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[Command.link(ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_block_portal_own" model="ir.rule">
        <field name="name">Blocks: portal sees his student's blocks (own or resource user)</field>
        <field name="model_id" ref="model_homeschool_block"/>
        <field name="domain_force">['|', ('student_id.user_id', '=', user.id), ('student_id.resource_user_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[Command.link(ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_trace_portal_institutional" model="ir.rule">
        <field name="name">Traces: portal sees institutional traces of his students' families</field>
        <field name="model_id" ref="model_homeschool_trace"/>
        <field name="domain_force">[('diffusion', '=', 'institutional'), ('company_id.homeschool_student_ids', 'any', ['|', ('user_id', '=', user.id), ('resource_user_ids', 'in', [user.id])])]</field>
        <field name="groups" eval="[Command.link(ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_material_portal_institutional" model="ir.rule">
        <field name="name">Material: portal sees institutional material of his students' families</field>
        <field name="model_id" ref="model_homeschool_material"/>
        <field name="domain_force">[('diffusion', '=', 'institutional'), ('company_id.homeschool_student_ids', 'any', ['|', ('user_id', '=', user.id), ('resource_user_ids', 'in', [user.id])])]</field>
        <field name="groups" eval="[Command.link(ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
