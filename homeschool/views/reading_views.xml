<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Book -->
    <record id="view_reading_book_form" model="ir.ui.view">
        <field name="name">homeschool.reading.book.form</field>
        <field name="model">homeschool.reading.book</field>
        <field name="arch" type="xml">
            <form string="Book">
                <sheet>
                    <div class="oe_title"><h1><field name="title" placeholder="Title"/></h1></div>
                    <group>
                        <group><field name="author"/><field name="student_id"/><field name="company_id" groups="base.group_multi_company"/></group>
                        <group><field name="started"/><field name="finished"/><field name="entry_count"/></group>
                    </group>
                    <notebook>
                        <page string="Entries">
                            <field name="entry_ids" context="{'default_book_id': id}">
                                <list editable="bottom" default_order="date desc">
                                    <field name="date"/>
                                    <field name="word1"/>
                                    <field name="word2"/>
                                    <field name="question"/>
                                    <field name="answer"/>
                                    <field name="weekly_page" optional="show"/>
                                    <field name="written_by" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Note"><field name="note"/></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_reading_book_list" model="ir.ui.view">
        <field name="name">homeschool.reading.book.list</field>
        <field name="model">homeschool.reading.book</field>
        <field name="arch" type="xml">
            <list string="Books" decoration-muted="finished">
                <field name="title"/><field name="author"/><field name="student_id"/><field name="started"/><field name="finished"/><field name="entry_count"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="view_reading_book_search" model="ir.ui.view">
        <field name="name">homeschool.reading.book.search</field>
        <field name="model">homeschool.reading.book</field>
        <field name="arch" type="xml">
            <search>
                <field name="title"/><field name="author"/><field name="student_id"/>
                <filter name="reading" string="Being read" domain="[('finished', '=', False)]"/>
                <filter name="finished" string="Finished" domain="[('finished', '!=', False)]"/>
                <group><filter name="group_student" string="Student" context="{'group_by': 'student_id'}"/></group>
            </search>
        </field>
    </record>
    <record id="action_reading_book" model="ir.actions.act_window">
        <field name="name">Reading log</field>
        <field name="res_model">homeschool.reading.book</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_reading': 1}</field>
    </record>

    <!-- Entry -->
    <record id="view_reading_entry_list" model="ir.ui.view">
        <field name="name">homeschool.reading.entry.list</field>
        <field name="model">homeschool.reading.entry</field>
        <field name="arch" type="xml">
            <list string="Reading entries" default_order="date desc">
                <field name="date"/><field name="book_id"/><field name="student_id"/><field name="word1"/><field name="word2"/><field name="question"/><field name="answer"/>
                <field name="weekly_page" optional="hide"/><field name="written_by" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="view_reading_entry_form" model="ir.ui.view">
        <field name="name">homeschool.reading.entry.form</field>
        <field name="model">homeschool.reading.entry</field>
        <field name="arch" type="xml">
            <form string="Reading entry">
                <sheet>
                    <group>
                        <group><field name="book_id"/><field name="student_id"/><field name="date"/></group>
                        <group><field name="word1"/><field name="word2"/><field name="written_by"/><field name="company_id" groups="base.group_multi_company"/></group>
                    </group>
                    <group>
                        <field name="question"/><field name="answer"/><field name="weekly_page"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_reading_entry" model="ir.actions.act_window">
        <field name="name">Reading entries</field>
        <field name="res_model">homeschool.reading.entry</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
