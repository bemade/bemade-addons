<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_close_week_wizard_form" model="ir.ui.view">
        <field name="name">homeschool.close.week.wizard.form</field>
        <field name="model">homeschool.close.week.wizard</field>
        <field name="arch" type="xml">
            <form string="Close the week">
                <field name="step" invisible="1"/>
                <field name="multi_student" invisible="1"/>
                <field name="review_id" invisible="1"/>
                <field name="r3_alert" invisible="1"/>

                <!-- the student and the week; the first screen asks for them when the student is not known
                     (several students) or to change the week -->
                <group>
                    <group>
                        <field name="student_id" options="{'no_create': True}" readonly="step != 'start'"
                               required="step == 'start'" invisible="step != 'start' and not multi_student"/>
                        <field name="date" required="step == 'start'" invisible="step != 'start'"/>
                        <field name="iso_week" invisible="step == 'start'"/>
                    </group>
                    <group invisible="step == 'start'">
                        <field name="week_start"/>
                        <field name="week_end"/>
                    </group>
                </group>

                <!-- step 1: every indicator of the week on one screen -->
                <div invisible="step != 'indicators'">
                    <group string="Indicator notes from the journal" invisible="not journal_notes">
                        <field name="journal_notes" readonly="1" nolabel="1" colspan="2"/>
                    </group>
                    <field name="line_ids" nolabel="1">
                        <list editable="bottom" create="0" delete="0" decoration-info="is_monthly">
                            <field name="is_monthly" column_invisible="1"/>
                            <field name="indicator_id" column_invisible="1"/>
                            <field name="value_id" column_invisible="1"/>
                            <field name="code" readonly="1" width="120px"/>
                            <field name="name" readonly="1"/>
                            <field name="marker" readonly="1"/>
                            <field name="unit" readonly="1" width="90px"/>
                            <field name="last_value_label" readonly="1" width="140px"/>
                            <field name="threshold" readonly="1" optional="hide" class="small text-muted"/>
                            <field name="value" placeholder="blank = not measured" width="110px"/>
                            <field name="note"/>
                        </list>
                    </field>
                    <p class="text-muted">A blank writes nothing; a 0 is a value; 2,5 and 2.5 are both accepted. R3-PARENTS (the mean of D and M) and R1-ADULTE (adult-present hours) are computed on Next.</p>
                </div>

                <!-- step 2: the Sunday questions and the week's summary -->
                <div invisible="step != 'review'">
                    <div class="alert alert-danger" role="alert" invisible="not r3_alert">
                        <strong>R3-PARENTS:</strong> Second week in a row below 3 — trigger 5 (decision 0001)
                    </div>
                    <group string="The week">
                        <group>
                            <field name="adult_hours" readonly="1"/>
                            <field name="days_without_journal" readonly="1"/>
                        </group>
                        <group>
                            <field name="blank_codes" readonly="1"/>
                        </group>
                    </group>
                    <group string="Sunday questions">
                        <field name="answer_dose"/>
                        <field name="answer_cap"/>
                        <field name="adjustment"/>
                        <field name="notes" placeholder="Markdown"/>
                    </group>
                    <p class="text-muted">The indicators are already saved; closing this window with × loses the answers typed on this screen only.</p>
                </div>

                <footer>
                    <button name="action_load" type="object" string="Next" class="btn-primary" invisible="step != 'start'"/>
                    <button name="action_change_week" type="object" string="Other week" invisible="step != 'indicators'"/>
                    <button name="action_next" type="object" string="Next" class="btn-primary" invisible="step != 'indicators'"/>
                    <button name="action_previous" type="object" string="Previous" invisible="step != 'review'"/>
                    <button name="action_finish" type="object" string="Close the week" class="btn-primary" invisible="step != 'review'"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_close_week_wizard" model="ir.actions.server">
        <field name="name">Close the week</field>
        <field name="model_id" ref="model_homeschool_close_week_wizard"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open()</field>
    </record>
</odoo>
