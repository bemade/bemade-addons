<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_deliverable_list" model="ir.ui.view">
        <field name="name">homeschool.deliverable.list</field>
        <field name="model">homeschool.deliverable</field>
        <field name="arch" type="xml">
            <list string="Deliverables" editable="bottom" default_order="date desc, sequence" decoration-success="done" decoration-muted="bonus">
                <field name="sequence" widget="handle"/>
                <field name="day_id"/>
                <field name="date" optional="hide"/>
                <field name="student_id" optional="show"/>
                <field name="when"/>
                <field name="name"/>
                <field name="detail" optional="hide"/>
                <field name="bonus"/>
                <field name="done"/>
                <field name="done_at" optional="show"/>
                <field name="done_by" optional="show"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="view_deliverable_form" model="ir.ui.view">
        <field name="name">homeschool.deliverable.form</field>
        <field name="model">homeschool.deliverable</field>
        <field name="arch" type="xml">
            <form string="Deliverable">
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="What is expected"/></h1></div>
                    <group>
                        <group><field name="day_id"/><field name="student_id"/><field name="when"/><field name="sequence"/><field name="bonus"/></group>
                        <group><field name="done"/><field name="done_at"/><field name="done_by"/><field name="company_id" groups="base.group_multi_company"/></group>
                    </group>
                    <field name="detail" placeholder="What exactly, how much, where it goes."/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_deliverable_search" model="ir.ui.view">
        <field name="name">homeschool.deliverable.search</field>
        <field name="model">homeschool.deliverable</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/><field name="day_id"/><field name="student_id"/>
                <filter name="todo" string="To do" domain="[('done', '=', False)]"/>
                <filter name="done" string="Done" domain="[('done', '=', True)]"/>
                <filter name="bonus" string="Bonus" domain="[('bonus', '=', True)]"/>
                <separator/>
                <filter name="today" string="Today" domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter name="group_day" string="Day" context="{'group_by': 'day_id'}"/>
                    <filter name="group_student" string="Student" context="{'group_by': 'student_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_deliverable" model="ir.actions.act_window">
        <field name="name">Deliverables</field>
        <field name="res_model">homeschool.deliverable</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_day': 1}</field>
    </record>
</odoo>
