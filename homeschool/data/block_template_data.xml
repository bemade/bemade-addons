    <record id="tpl_tue_s2" model="homeschool.block.template"><field name="weekday">1</field><field name="sequence">4</field><field name="kind">bloc</field><field name="name">Segment 2</field><field name="duration_planned">45</field></record>
    <record id="tpl_tue_p2" model="homeschool.block.template"><field name="weekday">1</field><field name="sequence">5</field><field name="kind">pause</field><field name="name">Pause</field><field name="duration_planned">15</field></record>
    <record id="tpl_tue_s3" model="homeschool.block.template"><field name="weekday">1</field><field name="sequence">6</field><field name="kind">bloc</field><field name="name">Segment 3</field><field name="duration_planned">35</field></record>
