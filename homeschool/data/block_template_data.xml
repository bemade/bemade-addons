<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Default household grid: Mon/Tue morning block + reading at 14:00; Wed projects + reading;
         Thu ressource (outside teacher 9-11) OR morning block (alternative group); Fri nothing. -->
    <record id="tpl_mon_opening" model="homeschool.block.template"><field name="weekday">0</field><field name="sequence">1</field><field name="kind">opening</field><field name="name">Opening</field><field name="duration_planned">5</field></record>
    <record id="tpl_mon_s1" model="homeschool.block.template"><field name="weekday">0</field><field name="sequence">2</field><field name="kind">bloc</field><field name="name">Segment 1</field><field name="duration_planned">45</field></record>
    <record id="tpl_mon_p1" model="homeschool.block.template"><field name="weekday">0</field><field name="sequence">3</field><field name="kind">pause</field><field name="name">Pause</field><field name="duration_planned">15</field></record>
    <record id="tpl_mon_s2" model="homeschool.block.template"><field name="weekday">0</field><field name="sequence">4</field><field name="kind">bloc</field><field name="name">Segment 2</field><field name="duration_planned">45</field></record>
    <record id="tpl_mon_p2" model="homeschool.block.template"><field name="weekday">0</field><field name="sequence">5</field><field name="kind">pause</field><field name="name">Pause</field><field name="duration_planned">15</field></record>
    <record id="tpl_mon_s3" model="homeschool.block.template"><field name="weekday">0</field><field name="sequence">6</field><field name="kind">bloc</field><field name="name">Segment 3</field><field name="duration_planned">35</field></record>
    <record id="tpl_mon_debrief" model="homeschool.block.template"><field name="weekday">0</field><field name="sequence">7</field><field name="kind">debrief</field><field name="name">Debrief</field><field name="duration_planned">15</field></record>
    <record id="tpl_mon_reading" model="homeschool.block.template"><field name="weekday">0</field><field name="sequence">8</field><field name="kind">reading</field><field name="name">Reading</field><field name="duration_planned">20</field><field name="anchored" eval="True"/><field name="start_fixed">14.0</field></record>
    <record id="tpl_tue_opening" model="homeschool.block.template"><field name="weekday">1</field><field name="sequence">1</field><field name="kind">opening</field><field name="name">Opening</field><field name="duration_planned">5</field></record>
