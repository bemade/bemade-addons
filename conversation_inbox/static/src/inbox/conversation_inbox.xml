<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="conversation_inbox.Inbox">
        <div class="o_conversation_inbox h-100 d-flex flex-column p-3">
            <t t-if="!state.transports.length">
                <div class="alert alert-info o_conversation_inbox_empty" role="alert">
                    <p class="mb-2">
                        You have no mailbox connected yet. Add your own Google
                        Workspace or IMAP mailbox under "My mailboxes"; no
                        administrator is needed.
                    </p>
                    <button
            class="btn btn-primary o_conversation_inbox_add_mailbox"
            t-on-click="onAddMailbox"
          >Add a mailbox</button>
                </div>
            </t>
            <t t-else="">
                <div class="d-flex align-items-center mb-3 gap-2">
                    <label for="o_conversation_inbox_transport">Account</label>
                    <select
            id="o_conversation_inbox_transport"
            class="form-select w-auto"
            t-att-disabled="state.bulkBusy"
            t-on-change="onTransportChange"
          >
                        <t
              t-foreach="state.transports"
              t-as="transport"
              t-key="transport.id"
            >
                            <option
                t-att-value="transport.id"
                t-att-selected="transport.id === state.transportId"
              >
                                <t t-esc="transport.name" />
                            </option>
                        </t>
                    </select>
                    <t t-if="canSearch">
                        <form
              class="o_conversation_inbox_search input-group w-auto"
              t-on-submit="onSearchSubmit"
            >
                            <input
                type="search"
                class="form-control o_conversation_inbox_search_input"
                placeholder="Search this mailbox..."
                aria-label="Search this mailbox"
                t-model="state.searchTerm"
              />
                            <button
                type="submit"
                class="btn btn-secondary o_conversation_inbox_search_submit"
                title="Search"
              >
                                <i class="fa fa-search" />
                            </button>
                            <t t-if="state.searchTerm or state.activeQuery">
                                <button
                  type="button"
                  class="btn btn-secondary o_conversation_inbox_search_clear"
                  title="Clear search"
                  t-on-click="onSearchClear"
                >
                                    <i class="fa fa-times" />
                                </button>
                            </t>
                        </form>
                    </t>
                    <div class="ms-auto d-flex gap-2">
                        <button
              class="btn btn-secondary"
              t-on-click="onPrevPage"
              t-att-disabled="state.page &lt;= 1 or state.bulkBusy"
            >
                            Previous
                        </button>
                        <span t-esc="'Page ' + state.page" />
                        <button
              class="btn btn-secondary"
              t-on-click="onNextPage"
              t-att-disabled="!state.hasMore or state.bulkBusy"
            >
                            Next
                        </button>
                    </div>
                </div>

                <t t-if="state.loading">
                    <div class="text-muted">Loading...</div>
                </t>
                <t t-elif="!state.items.length and state.activeQuery">
                    <div
            class="text-muted o_conversation_inbox_no_match"
          >No messages match your search.</div>
                </t>
                <t t-elif="!state.items.length">
                    <div class="text-muted">No messages on this page.</div>
                </t>
                <t t-else="">
                    <div class="o_conversation_inbox_list flex-grow-1 overflow-auto">
                        <div
              class="o_conversation_inbox_toolbar d-flex flex-wrap align-items-center gap-2 mb-2"
            >
                            <label class="d-flex align-items-center gap-2 mb-0">
                                <input
                  type="checkbox"
                  class="form-check-input mt-0 o_inbox_select_all"
                  t-att-checked="allSelected"
                  t-att-disabled="state.bulkBusy"
                  t-on-change="toggleSelectAll"
                />
                                <span>Select all</span>
                            </label>
                            <t t-if="state.selectedIds.length">
                                <div
                  class="o_inbox_bulk_bar d-flex flex-wrap align-items-center gap-2 ms-3"
                >
                                    <strong
                    class="o_inbox_selected_count"
                    t-esc="selectedCountLabel"
                  />
                                    <t
                    t-foreach="bulkActions"
                    t-as="bulk"
                    t-key="bulk.key"
                  >
                                        <button
                      t-att-class="'btn btn-sm o_inbox_bulk_' + bulk.key + (bulk.danger ? ' btn-outline-danger' : ' btn-secondary')"
                      t-att-title="bulk.title"
                      t-att-disabled="state.bulkBusy"
                      t-on-click="() => bulk.run()"
                    >
                                            <i t-att-class="'fa me-1 ' + bulk.icon" />
                                            <t t-esc="bulk.label" />
                                        </button>
                                    </t>
                                    <button
                    class="btn btn-link btn-sm o_inbox_bulk_clear"
                    t-att-disabled="state.bulkBusy"
                    t-on-click="clearSelection"
                  >Clear selection</button>
                                </div>
                            </t>
                        </div>
                        <t t-foreach="state.items" t-as="item" t-key="item.external_id">
                            <div
                class="card mb-2 o_inbox_row"
                t-att-data-external-id="item.external_id"
              >
                                <div
                  class="card-header d-flex align-items-center gap-2"
                  style="cursor: pointer;"
                  t-on-click="() => this.onExpand(item)"
                >
                                    <input
                    type="checkbox"
                    class="form-check-input mt-0 flex-shrink-0 o_inbox_select"
                    aria-label="Select this message"
                    t-att-checked="isSelected(item)"
                    t-att-disabled="state.bulkBusy"
                    t-on-click.stop="noop"
                    t-on-change="() => this.toggleSelected(item)"
                  />
                                    <div class="flex-grow-1 text-truncate">
                                        <strong
                      t-esc="item.subject || '(no subject)'"
                    />
                                        <span
                      class="text-muted ms-2"
                      t-esc="item.email_from"
                    />
                                    </div>
                                    <span
                    class="text-muted flex-shrink-0"
                    t-esc="item.date or ''"
                  />
                                    <div
                    class="o_inbox_row_actions d-flex flex-shrink-0 gap-1 ms-2"
                    t-on-click.stop="noop"
                  >
                                        <t
                      t-foreach="rowActions"
                      t-as="rowAction"
                      t-key="rowAction.key"
                    >
                                            <button
                        type="button"
                        t-att-class="'btn btn-sm btn-link px-1 o_inbox_' + rowAction.key + (rowAction.danger ? ' text-danger' : ' text-secondary')"
                        t-att-title="rowAction.title"
                        t-att-aria-label="rowAction.label"
                        t-on-click="() => rowAction.run(item)"
                      >
                                                <i
                          t-att-class="'fa ' + rowAction.icon"
                        />
                                            </button>
                                        </t>
                                    </div>
                                </div>
                                <t t-if="state.expandedId === item.external_id">
                                    <div class="card-body">
                                        <t t-if="state.expandedBody === null">
                                            <div
                        class="text-muted"
                      >Loading message...</div>
                                        </t>
                                        <t t-else="">
                                            <div
                        class="o_conversation_inbox_body mb-3"
                        t-out="state.expandedBody"
                      />
                                            <t t-if="state.expandedAttachments.length">
                                                <div
                          class="o_conversation_inbox_attachments mb-3 d-flex flex-wrap gap-2"
                        >
                                                    <t
                            t-foreach="state.expandedAttachments"
                            t-as="attachment"
                            t-key="attachment.filename"
                          >
                                                        <span
                              class="badge text-bg-light border"
                              title="Attachment -- not inlined; capture the message to pull it into Odoo."
                            >
                                                            <i
                                class="fa fa-paperclip me-1"
                              />
                                                            <t
                                t-esc="attachment.filename"
                              />
                                                        </span>
                                                    </t>
                                                </div>
                                            </t>
                                        </t>
                                    </div>
                                </t>
                            </div>
                        </t>
                    </div>
                </t>
            </t>
        </div>
    </t>
</templates>
