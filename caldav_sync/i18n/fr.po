#: model:ir.model.fields,field_description:caldav_sync.field_calendar_event__caldav_imported
msgid "Imported from CalDAV"
msgstr "Importé depuis CalDAV"

#. module: caldav_sync
#: model:ir.model.fields,field_description:caldav_sync.field_calendar_event__caldav_date_locked
msgid "Caldav Date Locked"
msgstr "Date verrouillée par CalDAV"

#. module: caldav_sync
#: model:ir.model.fields,help:caldav_sync.field_calendar_event__caldav_date_locked
msgid ""
"Date and time can only be changed in the external calendar this meeting was "
"created in."
msgstr ""
"La date et l'heure ne peuvent être modifiées que dans le calendrier externe "
"où cette réunion a été créée."

#. module: caldav_sync
#: model_terms:ir.ui.view,arch_db:caldav_sync.calendar_event_view_form
msgid ""
"This meeting was created in the external calendar: its date and time cannot "
"be changed in Odoo."
msgstr ""
"Cette réunion a été créée dans le calendrier externe : sa date et son heure "
"ne peuvent pas être modifiées dans Odoo."

#. module: caldav_sync
#. odoo-python
#: code:addons/caldav_sync/models/calendar_event.py:0
msgid ""
"The date and time of “%(name)s” cannot be changed in Odoo: this meeting was "
"created in the external calendar."
msgstr ""
"La date et l'heure de « %(name)s » ne peuvent pas être modifiées dans Odoo : "
"cette réunion a été créée dans le calendrier externe."
