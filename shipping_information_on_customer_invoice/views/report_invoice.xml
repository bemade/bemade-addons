<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_document_inherit_shipping" inherit_id="account.report_invoice_document">
        <xpath expr="//div[@id='informations']" position="inside">
            <div class="col" name="carrier" t-if="o.picking_id.carrier_id">
                <strong>Carrier: </strong>
                <div t-field="o.picking_id.carrier_id.name"/>
                <div t-if="o.picking_id.delivery_billing_mode" t-field="o.picking_id.delivery_billing_mode"/>
            </div>
            <div class="col" name="tracking" t-if="o.picking_id.carrier_tracking_ref">
                <strong>Tracking: </strong>
                <div>
                    <span t-field="o.picking_id.carrier_tracking_ref"/>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
