<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Quest pool (shared by every family; a family may add its own or archive these) -->
        <record id="quest_unit_session" model="homeschool.practice.quest.template">
            <field name="name">A session on {unit}</field>
            <field name="kind">unit_session</field><field name="target">1</field><field name="xp">15</field><field name="sequence">1</field>
        </record>
        <record id="quest_review_session" model="homeschool.practice.quest.template">
            <field name="name">A review session</field>
            <field name="kind">review_session</field><field name="target">1</field><field name="xp">15</field><field name="sequence">2</field>
        </record>
        <record id="quest_no_hint" model="homeschool.practice.quest.template">
            <field name="name">{target} correct answers without a hint</field>
            <field name="kind">no_hint</field><field name="target">10</field><field name="xp">10</field><field name="weight">3</field>
        </record>
        <record id="quest_perfect" model="homeschool.practice.quest.template">
            <field name="name">A session without a miss</field>
            <field name="kind">perfect</field><field name="target">1</field><field name="xp">15</field><field name="weight">2</field>
        </record>
        <record id="quest_answers" model="homeschool.practice.quest.template">
            <field name="name">Answer {target} questions</field>
            <field name="kind">answers</field><field name="target">20</field><field name="xp">10</field><field name="weight">3</field>
        </record>

        <!-- Badges -->
        <record id="badge_xp_100" model="homeschool.practice.badge.template"><field name="name">100 XP</field><field name="icon">⭐</field><field name="kind">xp_total</field><field name="threshold">100</field></record>
        <record id="badge_xp_500" model="homeschool.practice.badge.template"><field name="name">500 XP</field><field name="icon">🌟</field><field name="kind">xp_total</field><field name="threshold">500</field></record>
        <record id="badge_xp_1000" model="homeschool.practice.badge.template"><field name="name">1,000 XP</field><field name="icon">💫</field><field name="kind">xp_total</field><field name="threshold">1000</field></record>
        <record id="badge_xp_5000" model="homeschool.practice.badge.template"><field name="name">5,000 XP</field><field name="icon">🚀</field><field name="kind">xp_total</field><field name="threshold">5000</field></record>
        <record id="badge_xp_day_50" model="homeschool.practice.badge.template"><field name="name">Big day: 50 XP</field><field name="icon">🔥</field><field name="kind">xp_day</field><field name="threshold">50</field></record>
        <record id="badge_xp_day_100" model="homeschool.practice.badge.template"><field name="name">Huge day: 100 XP</field><field name="icon">⚡</field><field name="kind">xp_day</field><field name="threshold">100</field></record>
        <record id="badge_perfect_1" model="homeschool.practice.badge.template"><field name="name">First perfect session</field><field name="icon">🎯</field><field name="kind">perfect_session</field><field name="threshold">1</field></record>
        <record id="badge_perfect_10" model="homeschool.practice.badge.template"><field name="name">10 perfect sessions</field><field name="icon">🏹</field><field name="kind">perfect_session</field><field name="threshold">10</field></record>
        <record id="badge_sessions_10" model="homeschool.practice.badge.template"><field name="name">10 sessions</field><field name="icon">🧱</field><field name="kind">sessions_total</field><field name="threshold">10</field></record>
        <record id="badge_sessions_50" model="homeschool.practice.badge.template"><field name="name">50 sessions</field><field name="icon">🏗️</field><field name="kind">sessions_total</field><field name="threshold">50</field></record>
        <record id="badge_sessions_100" model="homeschool.practice.badge.template"><field name="name">100 sessions</field><field name="icon">🏰</field><field name="kind">sessions_total</field><field name="threshold">100</field></record>
        <record id="badge_goals_5" model="homeschool.practice.badge.template"><field name="name">5 daily goals</field><field name="icon">✅</field><field name="kind">goals_total</field><field name="threshold">5</field></record>
        <record id="badge_goals_20" model="homeschool.practice.badge.template"><field name="name">20 daily goals</field><field name="icon">🏆</field><field name="kind">goals_total</field><field name="threshold">20</field></record>
        <record id="badge_goals_50" model="homeschool.practice.badge.template"><field name="name">50 daily goals</field><field name="icon">👑</field><field name="kind">goals_total</field><field name="threshold">50</field></record>
        <record id="badge_level_5" model="homeschool.practice.badge.template"><field name="name">Level 5</field><field name="icon">🥉</field><field name="kind">level</field><field name="threshold">5</field></record>
        <record id="badge_level_10" model="homeschool.practice.badge.template"><field name="name">Level 10</field><field name="icon">🥈</field><field name="kind">level</field><field name="threshold">10</field></record>
        <record id="badge_unit_bronze" model="homeschool.practice.badge.template"><field name="name">Bronze</field><field name="description">Half of the unit is solid</field><field name="icon">🟫</field><field name="kind">unit_proficiency</field><field name="threshold">50</field></record>
        <record id="badge_unit_silver" model="homeschool.practice.badge.template"><field name="name">Silver</field><field name="description">Most of the unit is solid</field><field name="icon">⬜</field><field name="kind">unit_proficiency</field><field name="threshold">80</field></record>
        <record id="badge_unit_gold" model="homeschool.practice.badge.template"><field name="name">Gold</field><field name="description">The whole unit is solid</field><field name="icon">🟨</field><field name="kind">unit_proficiency</field><field name="threshold">100</field></record>
    </data>
</odoo>
