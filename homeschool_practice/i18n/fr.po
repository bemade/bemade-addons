msgstr "Séances par jour (max)"

#. module: homeschool_practice
#: model:ir.model.fields,field_description:homeschool_practice.field_homeschool_student__practice_sessions_min
msgid "Sessions a day (min)"
msgstr "Séances par jour (min)"

#. module: homeschool_practice
#: model:ir.model.fields,help:homeschool_practice.field_homeschool_practice_quest__target
msgid "Sessions, answers, or minutes for the practice-time quest."
msgstr "Séances, réponses, ou minutes pour la quête de temps de pratique."

#. module: homeschool_practice
#: model:ir.model.fields,field_description:homeschool_practice.field_homeschool_student__practice_subject_quests
msgid "Subject quests"
msgstr "Quêtes par matière"

#. module: homeschool_practice
#: model:ir.model.fields,help:homeschool_practice.field_homeschool_practice_quest__subject_id
msgid "Subject quests: any deck of it counts."
msgstr "Quêtes par matière : n’importe lequel de ses paquets compte."

#. module: homeschool_practice
#: model:ir.model.fields,help:homeschool_practice.field_homeschool_student__practice_sessions_min
msgid "The day's session quests ask for this many sessions at least."
msgstr ""
"Les quêtes de séances du jour demandent au moins ce nombre de séances."

#. module: homeschool_practice
#. odoo-python
#: code:addons/homeschool_practice/controllers/api.py:0
