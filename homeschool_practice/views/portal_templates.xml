<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The practice app: a full-screen page of its own (no portal header), touch first. -->
    <template id="practice_app" name="Homeschool: practice app">
        <t t-out="'&lt;!DOCTYPE html&gt;'"/>
        <html t-att-lang="lang">
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover"/>
                <meta name="apple-mobile-web-app-capable" content="yes"/>
                <meta name="mobile-web-app-capable" content="yes"/>
                <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"/>
                <meta name="apple-mobile-web-app-title" content="Pratique"/>
                <meta name="theme-color" content="#14213d"/>
                <title>Pratique</title>
                <link rel="manifest" href="/my/homeschool/practice/manifest.webmanifest"/>
                <link rel="apple-touch-icon" href="/homeschool_practice/static/src/img/icon-180.png"/>
                <link rel="stylesheet" href="/homeschool_practice/static/src/css/practice.css"/>
            </head>
            <body t-att-data-handedness="student.practice_handedness">
                <main id="app" aria-live="polite"><div class="hp-loading">…</div></main>
                <script src="/homeschool_practice/static/src/js/practice.js"/>
            </body>
        </html>
    </template>

    <!-- A way in from the homeschool portal home, for the learner himself -->
    <template id="portal_home_practice" inherit_id="homeschool_portal.portal_home" name="Homeschool: practice link">
        <xpath expr="//a[contains(@t-attf-href, '/reading')]" position="after">
            <a t-if="s.user_id == request.env.user" href="/my/homeschool/practice" class="btn btn-success">Practice</a>
        </xpath>
    </template>
</odoo>
