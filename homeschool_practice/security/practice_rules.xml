<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Managers: the records of their companies (families). Portal: the learner reaches his
         progress, quests, goals, badges, XP and reward balances; the educators (resource users
         attached to the learner) read everything practice-related EXCEPT rewards, and the
         learner never reads sessions, attempts or mastery (timings and the mastery verdict are
         for educators). The learner writes nothing: the portal API does it for him after
         checking that the student is his. Not noupdate: the rules refresh on every upgrade. -->
    <record id="rule_deck_company" model="ir.rule">
        <field name="name">Practice deck: manager sees his companies</field>
        <field name="model_id" ref="model_homeschool_practice_deck"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('homeschool.group_homeschool_manager'))]"/>
    </record>
