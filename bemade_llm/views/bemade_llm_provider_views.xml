<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bemade_llm_provider_view_list" model="ir.ui.view">
        <field name="name">bemade.llm.provider.list</field>
        <field name="model">bemade.llm.provider</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="base_url"/>
                <field name="is_local"/>
                <field name="structured_output" optional="hide"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="bemade_llm_provider_view_form" model="ir.ui.view">
        <field name="name">bemade.llm.provider.form</field>
        <field name="model">bemade.llm.provider</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_test_connection" type="object" string="Test Connection"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Local Ollama"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="base_url" placeholder="http://localhost:11434/v1"/>
                            <field name="api_key" password="True"/>
                            <field name="is_local"/>
                        </group>
                        <group>
                            <field name="structured_output"/>
                            <field name="timeout"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <group string="Extra HTTP headers">
                        <field name="extra_headers" nolabel="1" colspan="2" placeholder='{"HTTP-Referer": "https://example.com"}'/>
                    </group>
                    <field name="stream_ids" readonly="1">
                        <list>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="model"/>
                            <field name="allow_cloud"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="bemade_llm_provider_view_search" model="ir.ui.view">
        <field name="name">bemade.llm.provider.search</field>
        <field name="model">bemade.llm.provider</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter name="local" string="On our infrastructure" domain="[('is_local', '=', True)]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_bemade_llm_provider" model="ir.actions.act_window">
        <field name="name">LLM Providers</field>
        <field name="res_model">bemade.llm.provider</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
