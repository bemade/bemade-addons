<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_invoice_product_code_form_inherit" model="ir.ui.view">
        <field name="name">account.move.form.customer.code</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='product_id']" position="attributes">
                <attribute name="context">{
                    'partner_id': parent.move_type in ('out_invoice', 'out_refund', 'out_receipt') and parent.partner_id,
                }</attribute>
            </xpath>
        </field>
    </record>
</odoo>
