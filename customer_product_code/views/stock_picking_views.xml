<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_picking_inherit_view" model="ir.ui.view">
        <field name="name">stock.picking.form.customer.code</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_ids']/list/field[@name='product_id']" position="attributes">
                <attribute name="context">{
                    'default_is_storable': True,
                    'partner_id': parent.picking_type_code == 'outgoing' and parent.partner_id,
                }</attribute>
            </xpath>
        </field>
    </record>
</odoo>
