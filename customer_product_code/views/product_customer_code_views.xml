<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_customer_code_list" model="ir.ui.view">
        <field name="name">product.customer.code.list</field>
        <field name="model">product.customer.code</field>
        <field name="arch" type="xml">
            <list>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="product_code"/>
                <field name="product_name"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_product_customer_code_form" model="ir.ui.view">
        <field name="name">product.customer.code.form</field>
        <field name="model">product.customer.code</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="product_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="product_code"/>
                            <field name="product_name"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_product_customer_code_filter" model="ir.ui.view">
        <field name="name">product.customer.code.search</field>
        <field name="model">product.customer.code</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_code" filter_domain="['|', ('product_code', 'ilike', self), ('product_name', 'ilike', self)]"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <separator/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_product" string="Product" context="{'group_by': 'product_id'}"/>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_product_customer_code_list" model="ir.actions.act_window">
        <field name="name">Customer Product Codes</field>
        <field name="res_model">product.customer.code</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_product_customer_code"
              action="action_product_customer_code_list"
              parent="sale.prod_config_main"
              groups="group_product_customer_code_manager"
              sequence="50"/>
</odoo>
