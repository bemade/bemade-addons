<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The line description carries the customer code; the product field keeps
         its standard name (sale_order_mode) so it does not show it twice. -->
    <record id="view_order_form_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.customer.code</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='product_id']" position="attributes">
                <attribute name="context">{
                    'default_lst_price': price_unit,
                    'default_uom_id': product_uom_id,
                    'partner_id': parent.partner_id,
                    'sale_order_mode': True,
                }</attribute>
            </xpath>
        </field>
    </record>
</odoo>
