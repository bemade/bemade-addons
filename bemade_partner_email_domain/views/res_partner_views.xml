<?xml version="1.0" ?>
<odoo>
    <record id="partner_email_domain_form" model="ir.ui.view">
        <field name="name">bemade_partner_email_domain.partner.email.domain.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <field name="company_type" position="after">
                <label
          for="is_subdivision"
          string="Division"
          invisible="not is_company"
        />
                <field name="is_subdivision" invisible="not is_company" />
            </field>
            <field name="website" position="before">
                <field
          name="email_domain"
          invisible="not is_company"
          placeholder="e.g. example.com"
        />
            </field>
            <field name="parent_id" position="attributes">
                <attribute
          name="invisible"
        >is_company and not is_subdivision</attribute>
            </field>
            <field name="parent_id" position="after">
                <field name="parent_set_by_email_domain" invisible="1" />
                <button
          name="action_detach_email_domain_parent"
          type="object"
          string="Detach"
          class="btn-link p-0"
          icon="fa-chain-broken"
          invisible="not parent_set_by_email_domain or not parent_id"
          help="This company was set from the email domain: remove it from this contact."
        />
            </field>
        </field>
    </record>

    <!-- Migrated from Odoo Studio customization during Odoo 18.0 migration - 2025-10-14 -->
    <record id="partner_email_domain_list" model="ir.ui.view">
        <field name="name">bemade_partner_email_domain.partner.email.domain.list</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree" />
        <field name="arch" type="xml">
            <!-- fixed width so the header (« Domaine de courriel ») is not
                 shrunk to the 80px char minimum -->
            <xpath expr="//field[@name='email']" position="after">
                <field name="email_domain" optional="show" width="140px" />
            </xpath>
        </field>
    </record>
</odoo>
