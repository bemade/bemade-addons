<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="partner_parent_suggestion_view_list" model="ir.ui.view">
        <field name="name">partner.parent.suggestion.list</field>
        <field name="model">partner.parent.suggestion</field>
        <field name="arch" type="xml">
            <list string="Unassigned contacts" create="0" delete="0">
                <header>
                    <button
            name="action_apply_assignments"
            type="object"
            string="Apply assignments"
            class="btn-primary"
            display="always"
          />
                </header>
                <field name="partner_id" readonly="1" />
                <field name="partner_email" readonly="1" />
                <field name="candidate_ids" column_invisible="1" />
                <field
          name="chosen_parent_id"
          string="Company"
          widget="email_domain_company_choice"
        />
                <field name="email_domain" optional="hide" />
                <field
          name="partner_create_uid"
          widget="many2one_avatar_user"
          optional="show"
        />
                <field name="partner_create_date" optional="show" />
                <field name="origin" optional="show" />
                <field name="source" optional="hide" />
            </list>
        </field>
    </record>

    <record id="partner_parent_suggestion_view_search" model="ir.ui.view">
        <field name="name">partner.parent.suggestion.search</field>
        <field name="model">partner.parent.suggestion</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id" />
                <field name="email_domain" />
                <field name="candidate_ids" string="Candidate Company" />
                <filter
          name="with_choice"
          string="Company chosen"
          domain="[('chosen_parent_id', '!=', False)]"
        />
                <filter
          name="without_choice"
          string="No choice yet"
          domain="[('chosen_parent_id', '=', False)]"
        />
                <separator />
                <filter
          name="no_candidate"
          string="No candidate"
          domain="[('candidate_ids', '=', False)]"
        />
                <group>
                    <filter
            name="group_source"
            string="Source"
            context="{'group_by': 'source'}"
          />
                </group>
            </search>
        </field>
    </record>

    <record id="action_partner_parent_suggestion" model="ir.actions.act_window">
        <field name="name">Unassigned contacts</field>
        <field name="res_model">partner.parent.suggestion</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p
        class="o_view_nocontent_smiling_face"
      >No contact is waiting for its company</p>
            <p>Contacts whose email domain matches several companies appear here.
               Click a company on each row, then Apply assignments.</p>
        </field>
    </record>

    <menuitem
    id="menu_partner_parent_suggestion"
    name="Unassigned contacts"
    parent="contacts.menu_contacts"
    action="action_partner_parent_suggestion"
    sequence="3"
  />
</odoo>
