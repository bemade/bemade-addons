<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-inherit="mail.AttachmentList" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o-mail-AttachmentButtons')]" position="inside">
            <button
        t-if="canConvertHeic(attachment)"
        class="o-bemade-ConvertHeic btn bg-500 w-100 h-100 o-p-1_5 d-flex justify-content-center align-items-center shadow-sm"
        t-on-click.stop="() => this.onClickConvertHeic(attachment)"
        title="Convert to JPEG"
      >
                <i
          class="fa fa-file-image-o o-text-white"
          role="img"
          aria-label="Convert to JPEG"
        />
            </button>
        </xpath>
    </t>
</templates>
