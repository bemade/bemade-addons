<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="task_template_form_view_fsm_prep" model="ir.ui.view">
        <field name="name">project.task.template.form.fsm.prep</field>
        <field name="model">project.task.template</field>
        <field name="inherit_id" ref="bemade_fsm.task_template_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='subtasks_page']" position="after">
                <page name="fsm_prep_page" string="To Bring">
                    <field name="fsm_prep_template_line_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="sequence" widget="handle" />
                            <field name="name" />
                            <field name="tool_id" options="{'no_create': True}" />
                            <field name="quantity" />
                        </list>
                    </field>
                    <div class="text-muted small">
                        Copied to the visit (the top-level task) when this template is
                        applied, with the lines of the sub-templates.
                    </div>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
