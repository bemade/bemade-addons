#. module: conversation_email_base
#. odoo-python
#: code:addons/conversation_email_base/models/conversation_transport.py:0
msgid ""
"%(transport)s's mail server does not support the IMAP MOVE command, so "
"messages cannot be archived or deleted from Odoo."
msgstr ""
"Le serveur de courrier de %(transport)s ne prend pas en charge la commande "
"IMAP MOVE : les messages ne peuvent pas être archivés ni supprimés depuis "
"Odoo."

#. module: conversation_email_base
#: model:ir.model.fields,field_description:conversation_email_base.field_conversation_transport__imap_archive_folder
msgid "Archive Folder"
msgstr "Dossier d'archives"

#. module: conversation_email_base
#. odoo-python
#: code:addons/conversation_email_base/models/conversation_transport.py:0
msgid "Configure the IMAP host and login before browsing %(transport)s."
msgstr ""
"Configurez le serveur IMAP et l'identifiant avant de consulter "
"%(transport)s."

#. module: conversation_email_base
#. odoo-python
#: code:addons/conversation_email_base/models/conversation_transport.py:0
msgid "Configure the SMTP host and login before sending from %(transport)s."
msgstr ""
"Configurez le serveur SMTP et l'identifiant avant d'envoyer depuis "
"%(transport)s."

