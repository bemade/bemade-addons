<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Subtypes are noupdate=1 so re-installing/upgrading the module does not
         disturb existing follower subscriptions or default flags that admins
         may have customized. -->
    <data noupdate="1">
        <record id="subtype_patient_injury_external_update" model="mail.message.subtype">
            <field name="name">Patient File Update (External)</field>
            <field name="res_model">sports.patient.injury</field>
            <field name="default" eval="True"/>
            <field name="internal" eval="False"/>
            <field name="sequence" eval="4"/>
            <field name="hidden" eval="False"/>
            <field name="description"></field>
        </record>
        <record id="subtype_patient_injury_internal_update" model="mail.message.subtype">
            <field name="name">Patient File Update (For Treatment Professionals)</field>
            <field name="res_model">sports.patient.injury</field>
            <field name="default" eval="True"/>
            <field name="internal" eval="False"/>
            <field name="sequence" eval="4"/>
            <field name="hidden" eval="False"/>
            <field name="description">Internal notes updates for treatment professionals</field>
        </record>
        <record id="subtype_patient_external_update" model="mail.message.subtype">
            <field name="name">Patient File Update (External)</field>
            <field name="res_model">sports.patient</field>
            <field name="default" eval="True"/>
            <field name="internal" eval="False"/>
            <field name="sequence" eval="4"/>
            <field name="hidden" eval="False"/>
            <field name="description"></field>
        </record>
        <record id="subtype_patient_internal_update" model="mail.message.subtype">
            <field name="name">Patient File Update (Internal)</field>
            <field name="res_model">sports.patient</field>
            <field name="default" eval="True"/>
            <field name="internal" eval="True"/>
            <field name="sequence" eval="4"/>
            <field name="hidden" eval="False"/>
        </record>
    </data>

    <!-- Mail templates are updatable so body_html / subject corrections flow
         through on a regular module upgrade. -->
    <data>
        <record id="mail_template_patient_injury_status_update" model="mail.template">
            <field name="name">Patient Status Update</field>
            <field name="model_id" ref="bemade_sports_clinic.model_sports_patient_injury"/>
            <field name="subject">Patient Injury Status Update for {{ object.patient_name }}</field>
            <field name="body_html" type="html">
                <p>An update has been posted to the injury record for <t t-out="object.patient_name"/>'s injury<t t-if="object.diagnosis">with
                    the diagnosis of <strong t-out="object.diagnosis"/></t>. Click
                    <a t-attf-href="{{ user.company_id.website }}/my/player?player_id={{ object.patient_id.id }}">here</a> to view the injury details.
                </p>
            </field>
        </record>
        <record id="mail_template_patient_injury_new_internal_note" model="mail.template">
            <field name="name">Patient Status Update</field>
            <field name="model_id" ref="bemade_sports_clinic.model_sports_patient_injury"/>
            <field name="subject">Internal Note Updated for Patient {{ object.patient_name }}</field>
            <field name="body_html" type="html">
                <p>A new internal note has been posted to the injury record for <t t-out="object.patient_name"/>'s injury<t t-if="object.diagnosis">with
                    the diagnosis of <strong t-out="object.diagnosis"/></t>.
                </p>
                <div>
                    <p><strong>New Note: </strong></p>
                    <div><t t-out="object.internal_notes"/></div>
                </div>
            </field>
        </record>
        <record id="mail_template_patient_status_update" model="mail.template">
            <field name="name">Patient Status Update</field>
            <field name="model_id" ref="bemade_sports_clinic.model_sports_patient"/>
            <field name="subject">Patient Status Update for {{ object.name}}</field>
            <field name="body_html" type="html">
                <p>An update has been posted to the record for <t t-out="object.name"/>. Click
                    <a t-attf-href="{{ user.company_id.website }}/my/player?player_id={{ object.id }}">here</a> to view the details.
                </p>
            </field>
        </record>
        <record id="mail_template_patient_new_internal_note" model="mail.template">
            <field name="name">Patient Status Update</field>
            <field name="model_id" ref="bemade_sports_clinic.model_sports_patient"/>
            <field name="subject">Internal Note Updated for Patient {{ object.name}}</field>
            <field name="body_html" type="html">
                <p>A new internal note has been posted to the  record for <t t-out="object.name"/>'s.
                </p>
                <div>
                    <p><strong>New Note: </strong></p>
                    <div><t t-out="object.team_info_notes"/></div>
                </div>
            </field>
        </record>
        <!-- Task 1269: PHI-free aggregated urgent-notification summary.
             Bound to res.partner (the recipient) but driven entirely by the
             per-recipient render context (ctx.urgent_teams / urgent_team_count)
             the cron passes in. Law 25: counts, team names, short-notice event
             name/time and dashboard links ONLY — never a player name or any
             clinical/injury detail. Bilingual FR/EN body, matching the
             cancellation-notice approach. -->
        <record id="mail_template_urgent_summary" model="mail.template">
            <field name="name">Urgent Aggregated Updates (PHI-free)</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="subject">FitCrew — mises à jour urgentes / urgent updates</field>
            <field name="body_html" type="html">
                <div>
                    <p>Bonjour, / Hello,</p>
                    <p>Activité urgente sur vos équipes : / Urgent activity on your teams:</p>
                    <t t-foreach="ctx.get('urgent_teams') or []" t-as="team">
                        <div style="margin-bottom:12px;">
                            <p><strong t-out="team['name']"/></p>
                            <ul>
                                <li t-if="team['status_changes']">
                                    <t t-out="team['status_changes']"/> changement(s) de statut de jeu / play-status change(s)
                                </li>
                                <li t-if="team['new_injuries']">
                                    <t t-out="team['new_injuries']"/> nouvelle(s) blessure(s) / new injury/injuries
                                </li>
                                <t t-foreach="team['events'] or []" t-as="ev">
                                    <li>
                                        Nouvel événement à court préavis / Short-notice new event:
                                        <strong t-out="ev['name']"/>
                                        <t t-if="ev.get('date_label') or ev['date_start']"> — <t t-out="ev.get('date_label') or format_datetime(ev['date_start'])"/></t>
                                    </li>
                                </t>
                            </ul>
                            <p t-if="team['url']">
                                <a t-att-href="team['url']">Tableau de bord / Team dashboard</a>
                            </p>
                        </div>
                    </t>
                    <p style="color:#888;font-size:12px;">
                        Aucune donnée médicale n'est incluse. / No medical data is included.
                    </p>
                </div>
            </field>
        </record>
        <!-- Task 1268: per-user daily MORNING BRIEFING (digest epic slice D).
             Bound to res.partner (the recipient) but driven entirely by the
             per-recipient render context (ctx.digest_teams / digest_events) the
             cron passes in. Law 25: per-team counts, signed 24h deltas,
             team/event names and dashboard links ONLY — never a player name or
             any clinical/injury detail. Bilingual FR/EN body. -->
        <record id="mail_template_morning_digest" model="mail.template">
            <field name="name">Daily Morning Briefing (PHI-free)</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="subject">FitCrew — sommaire quotidien / daily briefing</field>
            <field name="body_html" type="html">
                <div>
                    <p>Bonjour, / Hello,</p>
                    <p>Votre sommaire quotidien d'équipe : / Your daily team briefing:</p>
                    <p style="color:#888;font-size:12px;">
                        Changements des dernières <t t-out="ctx.get('digest_window_hours') or 24"/> h /
                        Changes over the last <t t-out="ctx.get('digest_window_hours') or 24"/> h.
                    </p>
                    <t t-foreach="ctx.get('digest_teams') or []" t-as="team">
                        <div style="margin-bottom:12px;">
                            <p><strong t-out="team['name']"/></p>
                            <div t-if="team.get('announcement')" style="margin:6px 0;">
                                <p style="margin:0 0 2px 0;">
                                    <strong>Annonce de l'équipe / Team announcement<t t-if="team.get('announcement_is_expired')"> (expirée / expired)</t>:</strong>
                                </p>
                                <p style="white-space:pre-wrap;margin:0;" t-out="team['announcement']"/>
                            </div>
                            <ul>
                                <li>
                                    <t t-out="team['red']"/> indisponible(s) / no-play<t t-out="team['red_delta_str']"/>
                                    ·
                                    <t t-out="team['yellow']"/> limité(s) / limited<t t-out="team['yellow_delta_str']"/>
                                </li>
                                <li t-if="team['new_injuries']">
                                    <t t-out="team['new_injuries']"/> nouvelle(s) blessure(s) (<t t-out="ctx.get('digest_window_hours') or 24"/> h) / new injury/injuries
                                </li>
                                <li t-if="team['changes']">
                                    <t t-out="team['changes']"/> joueur(s) avec changements (<t t-out="ctx.get('digest_window_hours') or 24"/> h) / player(s) with changes
                                </li>
                                <li t-if="team['pending_verify']">
                                    <t t-out="team['pending_verify']"/> vérification(s) de blessure en attente / injury verification(s) pending
                                </li>
                                <li t-if="team['pending_removal']">
                                    <t t-out="team['pending_removal']"/> demande(s) de retrait de joueur / player removal request(s)
                                </li>
                            </ul>
                            <p t-if="team['url']">
                                <a t-att-href="team['url']">Tableau de bord / Team dashboard</a>
                            </p>
                        </div>
                    </t>
                    <t t-if="ctx.get('digest_events')">
                        <div style="margin-bottom:12px;">
                            <p><strong>Événements à venir (7 j) / Upcoming events (7d):</strong></p>
                            <ul>
                                <t t-foreach="ctx.get('digest_events') or []" t-as="ev">
                                    <li>
                                        <strong t-out="ev['name']"/>
                                        <t t-if="ev.get('date_label') or ev['date_start']"> — <t t-out="ev.get('date_label') or format_datetime(ev['date_start'])"/></t>
                                    </li>
                                </t>
                            </ul>
                            <p style="color:#888;font-size:12px;">
                                Les événements non listés sont hors de notre plan de couverture, avisez-nous. /
                                Events not listed are outside our coverage plan — please advise us.
                            </p>
                        </div>
                    </t>
                    <p style="color:#888;font-size:12px;">
                        Aucune donnée médicale n'est incluse. / No medical data is included.
                    </p>
                </div>
            </field>
        </record>
        <record id="mail_template_event_cancelled" model="mail.template">
            <field name="name">Event Cancelled - Assigned Staff Notice</field>
            <field name="model_id" ref="bemade_sports_clinic.model_sports_event"/>
            <field name="subject">Event cancelled: {{ object.name }}</field>
            <!-- Bilingual body (owner call, dev-review 2026-07-04 round 2):
                 mail.template body_html is whole-value translated, so static
                 per-language bodies would have to be maintained as full
                 duplicates — a single FR/EN body is simpler and serves the
                 mixed-language staff. The subject IS per-language (po). -->
            <field name="body_html" type="html">
                <p>L'événement auquel vous étiez assigné a été annulé. /
                   The event you were assigned to has been cancelled.</p>
                <ul>
                    <li><strong>Événement / Event:</strong> <t t-out="object.name or ''"/></li>
                    <li t-if="object.date_start"><strong>Date:</strong>
                        <t t-out="format_datetime(object.date_start) or ''"/></li>
                    <li t-if="object.team_ids"><strong>Équipe(s) / Team(s):</strong>
                        <t t-out="', '.join(object.team_ids.mapped('name'))"/></li>
                    <li t-if="ctx.get('cancel_reason')"><strong>Raison / Reason:</strong>
                        <t t-out="ctx.get('cancel_reason')"/></li>
                </ul>
            </field>
        </record>
    </data>
</odoo>
