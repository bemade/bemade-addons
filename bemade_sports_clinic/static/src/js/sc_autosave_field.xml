<?xml version="1.0" encoding="UTF-8"?>
<!-- Task 1542 (epic #1535), extended by tasks 1539 and 1582 (replace editor) and the
     2026-10-14 review (date inputs save once complete) — see sc_autosave_field.js. -->
<templates xml:space="preserve">
    <t t-name="bemade_sports_clinic.ScAutosaveField">
        <div class="o_sc_field o_sc_autosave" t-att-data-sc-autosave="props.mode or 'draft'"
             t-att-hidden="isHidden ? 'hidden' : undefined"
             t-att-data-sc-field="props.field or props.name"
             t-att-data-sc-state="state.status" t-att-data-sc-restored="state.restored ? '1' : '0'">
            <label class="o_sc_field_label" t-att-for="props.inputId">
                <span t-esc="props.label"/>
                <span t-if="statusLabel" t-attf-class="o_sc_save_state o_sc_save_state_{{ state.status }}" role="status" t-esc="statusLabel"/>
                <button t-if="canClear" type="button"
                        class="o_sc_link_btn o_sc_clear_btn" t-on-click="clear">Clear</button>
                <button t-if="props.historySheet and !isReplace" type="button" class="o_sc_link_btn o_sc_field_history"
                        t-att-data-sc-sheet-open="props.historySheet" t-esc="props.historyLabel"/>
            </label>
            <div t-if="state.restored" class="o_sc_banner o_sc_draft_banner" role="status">
                <strong class="o_sc_banner_title">Draft restored</strong>
                <span>Your unpublished text was kept on this device.</span>
                <button type="button" class="o_sc_link_btn" t-on-click="discardDraft">Discard the draft</button>
            </div>
            <div t-if="state.conflict" class="o_sc_banner o_sc_banner_warn o_sc_conflict_banner" role="alert">
                <strong class="o_sc_banner_title">Changed elsewhere</strong>
                <span t-esc="conflictText"/>
                <div class="o_sc_banner_actions">
                    <button type="button" class="o_sc_btn o_sc_btn_ghost o_sc_btn_sm" t-on-click="keepMine">Keep mine</button>
                    <button type="button" class="o_sc_btn o_sc_btn_ghost o_sc_btn_sm" t-on-click="takeTheirs">Take theirs</button>
                </div>
            </div>
            <!-- Task 1600: an existing name / date of birth changes only once confirmed. -->
            <div t-if="state.identity" class="o_sc_banner o_sc_banner_warn o_sc_identity_banner" role="alert">
                <strong class="o_sc_banner_title" t-esc="state.identity.message"/>
                <span class="o_sc_identity_change" t-esc="identityChange"/>
                <span>The change will be noted in the player's file.</span>
                <div class="o_sc_banner_actions">
                    <button type="button" class="o_sc_btn o_sc_btn_primary o_sc_btn_sm o_sc_identity_confirm" t-on-click="confirmIdentity">Confirm</button>
                    <button type="button" class="o_sc_btn o_sc_btn_ghost o_sc_btn_sm o_sc_identity_cancel" t-on-click="cancelIdentity">Cancel</button>
                </div>
            </div>
            <!-- Task 1582: the « replace » editor — the current text read-only
                 above an EMPTY « New note » editor; saving replaces the text. -->
            <t t-if="isReplace">
                <div t-if="state.current" class="o_sc_replace_current" data-sc-replace="current">
                    <span class="o_sc_replace_caption">Current text</span>
                    <div class="o_sc_replace_current_text o_sc_pre" t-esc="state.current"/>
                    <small t-if="state.hint" class="o_sc_hint" t-esc="state.hint"/>
                </div>
                <div class="o_sc_replace_new_head">
                    <span class="o_sc_replace_caption">New note</span>
                    <button t-if="state.current and !state.value and !props.disabled" type="button"
                            class="o_sc_link_btn o_sc_replace_reuse" t-on-click="reuseCurrent">Reuse current text</button>
                </div>
                <textarea t-ref="input" class="o_sc_input o_sc_textarea" rows="4" data-sc-replace="new"
                          t-att-id="props.inputId" t-att-name="props.name" t-att-placeholder="props.placeholder"
                          t-att-disabled="props.disabled"
                          t-model="state.value" t-on-input="onInput" t-on-blur="commit"/>
                <small class="o_sc_hint o_sc_replace_hint">
                    <span>Replaces the previous text; the old one is kept in the history.</span>
                    <button t-if="props.historySheet" type="button" class="o_sc_link_btn o_sc_field_history"
                            t-att-data-sc-sheet-open="props.historySheet" t-esc="props.historyLabel"/>
                </small>
            </t>
            <textarea t-elif="type === 'textarea'" t-ref="input" class="o_sc_input o_sc_textarea" rows="4"
                      t-att-id="props.inputId" t-att-name="props.name" t-att-placeholder="props.placeholder"
                      t-att-required="props.required" t-att-disabled="props.disabled"
                      t-model="state.value" t-on-input="onInput" t-on-blur="commit"/>
            <select t-elif="type === 'select'" t-ref="input" class="o_sc_input o_sc_select"
                    t-att-id="props.inputId" t-att-name="props.name" t-att-required="props.required"
                    t-att-disabled="props.disabled" t-model="state.value" t-on-change="onChange">
                <t t-foreach="options" t-as="opt" t-key="opt_index">
                    <option t-att-value="opt[0]" t-esc="opt[1]"/>
                </t>
            </select>
            <div t-elif="type === 'segmented'" t-ref="input" class="o_sc_segmented o_sc_segmented_full o_sc_seg_input"
                 role="group" t-att-id="props.inputId" t-att-aria-label="props.label">
                <t t-foreach="options" t-as="opt" t-key="opt_index">
                    <button type="button" t-att-data-sc-value="opt[0]" t-att-disabled="props.disabled"
                            t-att-aria-pressed="state.value === opt[0] ? 'true' : 'false'"
                            t-on-click="() => this.onPick(opt[0])" t-esc="opt[1]"/>
                </t>
                <input t-if="props.name" type="hidden" t-att-name="props.name" t-att-value="state.value"/>
            </div>
            <!-- tags (owner review 2026-10-10): the value is the CSV of the
                 chosen option keys — removable chips + a search box; each add /
                 remove saves (server) or fills the form's hidden input (form).
                 Task 1608: focusing the box opens the FULL list (browse),
                 grouped, scrollable, keyboard navigable; typing narrows it. -->
            <div t-elif="type === 'tags'" class="o_sc_tags_field" t-att-data-sc-tags-open="state.open ? '1' : '0'"
                 t-on-focusout="onTagsFocusout" t-on-keydown="onTagKeydown">
                <ul class="o_sc_tags" t-att-aria-label="props.label">
                    <li t-foreach="chosenOptions" t-as="opt" t-key="opt[0]" class="o_sc_tag">
                        <span t-esc="opt[1]"/>
                        <button type="button" class="o_sc_tag_remove" t-att-disabled="props.disabled"
                                t-att-aria-label="removeLabel(opt[1])" t-att-title="removeLabel(opt[1])"
                                t-on-click="() => this.onCheck(opt[0], false)">×</button>
                    </li>
                </ul>
                <input t-ref="input" type="search" class="o_sc_input o_sc_tags_search" autocomplete="off"
                       role="combobox" aria-autocomplete="list"
                       t-att-aria-expanded="state.open ? 'true' : 'false'" t-att-aria-controls="tagsListId"
                       t-att-aria-activedescendant="tagsActiveId"
                       t-att-id="props.inputId" t-att-placeholder="props.placeholder"
                       t-att-disabled="props.disabled" t-model="state.query" t-on-input="onTagsInput"
                       t-on-focus="openTags" t-on-click="openTags"/>
                <ul t-if="state.open and tagRows.length" t-ref="list" class="o_sc_tags_options" role="listbox"
                    tabindex="-1" t-att-id="tagsListId" t-att-aria-label="props.label"
                    t-on-mousedown.prevent="() => {}">
                    <t t-foreach="tagRows" t-as="row" t-key="row.key">
                        <li t-if="row.heading" role="presentation" class="o_sc_tags_group" t-esc="row.label"/>
                        <li t-else="" role="option" t-att-id="tagsListId + '_' + row.index"
                            t-att-data-sc-tags-index="row.index"
                            t-att-aria-selected="row.index === state.active ? 'true' : 'false'">
                            <button type="button" tabindex="-1" t-att-data-sc-value="row.value"
                                    t-attf-class="o_sc_tags_option #{row.index === state.active ? 'o_sc_tags_option_active' : ''}"
                                    t-on-click="(ev) => this.addTag(row.value, ev)" t-esc="row.label"/>
                        </li>
                    </t>
                </ul>
                <small t-elif="state.open and state.query.trim()" class="o_sc_hint" t-esc="noMatchLabel"/>
            </div>
            <div t-elif="type === 'date_na'" class="o_sc_date_na">
                <input t-ref="input" class="o_sc_input" type="date" t-att-id="props.inputId"
                       t-att-name="props.name" t-att-value="dateValue" t-att-disabled="isNa or props.disabled"
                       t-att-required="!isNa and props.required"
                       t-on-input="(ev) => { this.state.value = ev.target.value; this.onInput(); }"
                       t-on-change="(ev) => { this.state.value = ev.target.value; this.onChange(); }"
                       t-on-blur="commit" t-on-keydown="onDateKeydown" t-on-pointerdown="onDatePointer"/>
                <label class="o_sc_check">
                    <input type="checkbox" t-att-name="props.naName" value="1" t-att-checked="isNa"
                           t-att-disabled="props.disabled" t-on-change="onNaToggle"/>
                    <span t-esc="naLabel"/>
                </label>
            </div>
            <input t-else="" t-ref="input" class="o_sc_input" t-att-type="type"
                   t-att-id="props.inputId" t-att-name="props.name" t-att-placeholder="props.placeholder"
                   t-att-required="props.required" t-att-disabled="props.disabled"
                   t-model="state.value" t-on-input="onInput" t-on-change="onChange" t-on-blur="commit"
                   t-on-keydown="onDateKeydown" t-on-pointerdown="onDatePointer"/>
            <small t-if="state.hint and !isReplace" class="o_sc_hint" t-esc="state.hint"/>
            <div t-if="state.message" class="o_sc_field_message" role="status" t-esc="state.message"/>
            <div t-if="state.error" class="o_sc_field_message o_sc_field_error" role="alert" t-esc="state.error"/>
        </div>
    </t>
</templates>
