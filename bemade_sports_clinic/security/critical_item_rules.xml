<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Task 1654: critical medical items follow the player's team access.
         Deliberately NOT noupdate (created / refreshed on every upgrade).
         Coaches only read (ACL); clinic admins see every player's items. -->
    <record id="critical_item_staffed_teams" model="ir.rule">
        <field name="name">Critical items: players of the staffed teams</field>
        <field name="model_id" ref="model_sports_patient_critical_item"/>
        <field name="groups" eval="[(6, 0, [ref('base.group_portal'), ref('base.group_user')])]"/>
        <field name="domain_force">[('patient_id.team_ids.staff_ids.user_ids', 'in', user.id)]</field>
    </record>
    <record id="critical_item_clinic_admin" model="ir.rule">
        <field name="name">Critical items: clinic administrators see all</field>
        <field name="model_id" ref="model_sports_patient_critical_item"/>
        <field name="groups" eval="[(6, 0, [ref('bemade_sports_clinic.group_sports_clinic_admin'), ref('base.group_system')])]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
