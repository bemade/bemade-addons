<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Quick Note record rules (task 1244).

    Owner-scoping here is VISIBILITY HYGIENE, not confidentiality: the point is
    that nobody's inbox is polluted by anyone else's scratch notes. Clinic
    administrator read access across all notes is deliberate and is what makes
    the stale-note escalation actionable.

    Note that this is a plain <data> block: these are brand-new records, and
    ir.rule records without noupdate are refreshed on every upgrade, so a later
    edit here needs no post-migrate either.
-->
<odoo>
    <data>

        <!-- A therapist sees, edits and deletes ONLY their own quick notes. -->
        <record id="sports_quick_note_portal_tp_rule" model="ir.rule">
            <field name="name">Portal Treatment Professional: Own Quick Notes</field>
            <field name="model_id" ref="model_sports_quick_note"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('bemade_sports_clinic.group_portal_treatment_professional'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Clinic administrators may READ every note (owner decision), so the
             stale-note escalation they receive can actually be acted on. Write,
             create and unlink stay off — see ir.model.access.csv, which grants
             them read only. -->
        <record id="sports_quick_note_admin_read_rule" model="ir.rule">
            <field name="name">Clinic Administrator: Read All Quick Notes</field>
            <field name="model_id" ref="model_sports_quick_note"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('bemade_sports_clinic.group_sports_clinic_admin'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

    </data>
</odoo>
