<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Task 1541 (P4): the legacy clinic portal pages are gone; this file
         keeps the shared fragments the app, the backend digests and the
         digest e-mails render (portal_card_injury_detail,
         dashboard_change_item / dashboard_change_items). -->
    <data>
        <!-- Task 1385: shared static injury-detail block for the homogenized
             card's expandable section. Renders ONE active injury from a JSON-safe
             detail dict (built by sports.patient._card_injury_detail), so the
             LIVE card and the frozen snapshot card render identically. Expects
             `inj` (the detail dict) and optional `changed` (recent-change flag). -->
        <template id="portal_card_injury_detail">
            <!-- Task 1385 (CR-A): the injury name links to its detail/edit page
                 (portal edit route by default; the internal digest passes
                 `backend_link` to point at the backend form instead). A newly
                 reported injury carries a "Nouvelle" flag here rather than a
                 redundant change-feed row (CR-A #5). The "Active" stage label is
                 dropped — everything in this static section is active by
                 construction (CR-A #1). -->
            <t t-set="injury_href"
               t-value="('/web#id=%s&amp;model=sports.patient.injury&amp;view_type=form' % inj['injury_id']) if backend_link else ((('/my/injury/edit?injury_id=%s&amp;team_id=%s' % (inj['injury_id'], team.id)) if team else ('/my/injury/edit?injury_id=%s' % inj['injury_id'])))"/>
            <div class="border rounded p-2 mb-2 small o_sc_injury_detail">
                <div class="d-flex justify-content-between align-items-start gap-2">
                    <div class="fw-bold">
                        <i class="fa fa-medkit me-1" aria-hidden="true"/>
                        <a t-att-href="injury_href" class="text-decoration-none">
                            <t t-esc="inj['diagnosis'] or 'Injury'"/>
                        </a>
                    </div>
                    <div class="d-flex align-items-start gap-1 flex-wrap">
                        <span t-if="inj.get('is_new')" class="badge bg-warning text-dark o_sc_injury_new" title="New injury">
                            <i class="fa fa-bolt me-1" aria-hidden="true"/>New
                        </span>
                        <span t-if="changed" class="badge bg-warning text-dark o_sc_injury_changed" title="Recent change">
                            <i class="fa fa-bolt me-1" aria-hidden="true"/>Recent change
                        </span>
                    </div>
                </div>
                <div t-if="inj['body_location'] or inj['injury_type'] or inj['severity']" class="text-muted">
                    <t t-if="inj['body_location']"><span t-esc="inj['body_location']"/></t>
                    <t t-if="inj['injury_type']"><t t-if="inj['body_location']"> · </t><span t-esc="inj['injury_type']"/></t>
                    <t t-if="inj['severity']"> · <span t-esc="inj['severity']"/></t>
                </div>
                <div t-if="inj['injury_date'] or inj['predicted_resolution_date'] or inj['resolution_date']" class="text-muted">
                    <t t-if="inj['injury_date']"><span>Injured since:</span> <span t-esc="inj['injury_date']"/></t>
                    <t t-if="inj['predicted_resolution_date']"> · <span>Predicted resolution:</span> <span t-esc="inj['predicted_resolution_date']"/></t>
                    <t t-if="inj['resolution_date']"> · <span>Resolved:</span> <span t-esc="inj['resolution_date']"/></t>
                </div>
                <!-- Task 1385 (CR-D2): external + internal notes in the static
                     active-injury detail. The dict is already audience-scoped by
                     the builder/snapshot (coach: external only; TP: internal +
                     external), so internal_notes is simply absent for a coach. -->
                <div t-if="inj.get('external_notes')" class="mt-1">
                    <span class="fw-bold">External notes:</span>
                    <span style="white-space: pre-wrap;" t-esc="inj['external_notes']"/>
                </div>
                <div t-if="inj.get('internal_notes')" class="mt-1">
                    <span class="fw-bold">Internal notes:</span>
                    <span style="white-space: pre-wrap;" t-esc="inj['internal_notes']"/>
                </div>
                <!-- App shell detail (owner layout 2026-10-11): this injury's
                     own changes inside its card. Absent on the legacy card. -->
                <div t-if="inj.get('items')" class="mt-2 o_sc_injury_changes">
                    <t t-call="bemade_sports_clinic.dashboard_change_items">
                        <t t-set="items" t-value="inj['items']"/>
                        <t t-set="synopsis" t-value="False"/>
                        <t t-set="show_position" t-value="False"/>
                        <t t-set="position" t-value="False"/>
                        <t t-set="hide_injury_suffix" t-value="True"/>
                    </t>
                </div>
            </div>
        </template>

        <!-- Task 1272 (re-plan): shared change-DIGEST fragment. Renders one
             change-item (a field that changed in the window + its CURRENT value,
             de-duped). Used by BOTH the portal dashboard cards and the backend
             single-column kanban (via ir.qweb render into the dashboard_digest_html
             field), so both surfaces read identically. Long free-text collapses
             behind a native <details> "see more" (no JS / bootstrap needed,
             so it works in the backend html widget too). -->
        <template id="dashboard_change_item">
            <!-- expects `it` (one change-item dict) in scope -->
            <div class="d-flex align-items-start gap-2 dashboard-digest-item">
                <i t-attf-class="fa {{ it['icon'] }} mt-1 text-muted" aria-hidden="true"/>
                <div class="flex-grow-1">
                    <div>
                        <span class="fw-bold" t-esc="it['label']"/>
                        <!-- Injury context suffix. Live items carry an `injury`
                             recordset; a stored digest snapshot (task 1267) carries
                             a plain `injury_diagnosis` string instead (no recordset
                             survives serialization), so prefer that when present. -->
                        <t t-if="it['category'] != 'new_injury' and not hide_injury_suffix">
                            <t t-set="digest_diag" t-value="it.get('injury_diagnosis') or (it['injury'].diagnosis if it.get('injury') else False)"/>
                            <t t-if="digest_diag">
                                <span class="text-muted small"> — <t t-esc="digest_diag"/></span>
                            </t>
                        </t>
                        <!-- Task 1582: a note is ONE « current state » text —
                             its change reads as the new text alone. -->
                        <span t-if="it.get('category') == 'note'" class="badge text-bg-light border ms-1 fw-normal dashboard-digest-new-note">New note</span>
                    </div>
                    <t t-if="it.get('sub_items')">
                        <ul class="list-unstyled ms-1 mb-0">
                            <t t-foreach="it['sub_items']" t-as="sub">
                                <li>
                                    <span class="text-muted"><t t-esc="sub['label']"/>: </span>
                                    <t t-if="sub['is_long']">
                                        <details>
                                            <summary><span class="digest-preview"><t t-esc="sub['preview']"/> </span><span class="text-primary small"><span class="digest-see-more">see more</span><span class="digest-see-less">see less</span></span></summary>
                                            <div class="mt-1" style="white-space: pre-wrap;" t-esc="sub['value']"/>
                                        </details>
                                    </t>
                                    <span t-else="" style="white-space: pre-wrap;" t-esc="sub['value']"/>
                                </li>
                            </t>
                        </ul>
                    </t>
                    <t t-elif="it['is_long']">
                        <details>
                            <summary><span class="digest-preview"><t t-esc="it['preview']"/> </span><span class="text-primary small"><span class="digest-see-more">see more</span><span class="digest-see-less">see less</span></span></summary>
                            <div class="mt-1" style="white-space: pre-wrap;" t-esc="it['value']"/>
                        </details>
                    </t>
                    <t t-else="">
                        <!-- Task 1385 (CR-A #4): show the delta as
                             « ancienne → nouvelle » when a pre-window value is
                             known; gracefully fall back to the new value alone. -->
                        <t t-if="it.get('old_value') and it.get('category') != 'note'">
                            <div style="white-space: pre-wrap;"><span class="text-muted text-decoration-line-through" t-esc="it['old_value']"/> <i class="fa fa-arrow-right mx-1 small" aria-hidden="true"/> <span t-esc="it['value']"/></div>
                        </t>
                        <t t-else="">
                            <div style="white-space: pre-wrap;" t-esc="it['value']"/>
                        </t>
                    </t>
                </div>
            </div>
        </template>

        <!-- Task 1272 (condense round 2): the per-player card was "a long
             article" (every changed field with its full value inline). Now the
             DEFAULT view is a collapsed per-category natural-language SYNOPSIS
             (built from the SAME role-scoped items list -> Law-25 safe: a coach
             synopsis cannot name a hidden injury or internal note), wrapped in a
             native <details> whose EXPAND is the full render, unchanged. Same
             no-JS collapse pattern as "see more". Per-player control (each
             card its own <details>). Renders identically on both surfaces. -->
        <template id="dashboard_change_items">
            <!-- expects `items` (list of change-item dicts); optional
                 `synopsis` (list of short phrase strings for the collapsed
                 summary), `show_position` + `position`. Task 1381: optional
                 `show_player_status` flag gates an internal-only player-status
                 block (`predicted_return_date` + `training_recommendation`)
                 rendered ahead of the changelog; portal callers leave the flag
                 falsy so the block stays off the portal card (that's #1385). -->
            <div class="dashboard-digest">
                <t t-if="show_position and position">
                    <div class="mb-2 small text-muted">
                        <i class="fa fa-map-marker me-1" aria-hidden="true"/>
                        <span class="fw-bold">Position: </span>
                        <t t-esc="position"/>
                    </div>
                </t>
                <t t-if="show_player_status">
                    <!-- Task 1385 (CR-A #3 / CR-B): training recommendation first,
                         then predicted return (inverted from the original order). -->
                    <t t-if="training_recommendation and training_recommendation.strip()">
                        <div class="mb-1 small">
                            <i class="fa fa-clipboard me-1" aria-hidden="true"/>
                            <span class="fw-bold">Training recommendation: </span>
                            <span style="white-space: pre-wrap;" t-esc="training_recommendation"/>
                        </div>
                    </t>
                    <t t-if="predicted_return_date">
                        <div class="mb-2 small">
                            <i class="fa fa-calendar-check-o me-1" aria-hidden="true"/>
                            <span class="fw-bold">Predicted return: </span>
                            <span t-if="predicted_return_overdue" class="o_pk_overdue"><span t-out="predicted_return_date" t-options="{'widget': 'date'}"/><t t-call="bemade_portal_kit.pk_overdue_flag"/></span>
                            <span t-else="" t-out="predicted_return_date" t-options="{'widget': 'date'}"/>
                        </div>
                    </t>
                    <!-- Task 1385 (CR-A #5): the internal digest also drops the
                         "Nouvelle blessure" feed row, so surface standing active
                         injuries here (new ones flagged), linking to the backend
                         form. Only rendered when the caller supplies them. -->
                    <t t-if="active_injuries">
                        <t t-foreach="active_injuries" t-as="inj">
                            <t t-call="bemade_sports_clinic.portal_card_injury_detail">
                                <t t-set="changed" t-value="inj.get('changed')"/>
                                <t t-set="backend_link" t-value="True"/>
                            </t>
                        </t>
                    </t>
                </t>
                <t t-if="items">
                    <t t-if="synopsis">
                        <details class="dashboard-digest-collapsible">
                            <summary class="dashboard-digest-synopsis">
                                <span class="dashboard-digest-synopsis-text">
                                    <t t-foreach="synopsis" t-as="phrase"><t t-esc="phrase"/><t t-if="not phrase_last">. </t></t>
                                </span>
                                <span class="text-primary small ms-1"><span class="digest-see-more">see details</span><span class="digest-see-less">hide details</span></span>
                            </summary>
                            <ul class="list-unstyled mb-0 mt-2">
                                <t t-foreach="items" t-as="it">
                                    <li class="mb-2">
                                        <t t-call="bemade_sports_clinic.dashboard_change_item"/>
                                    </li>
                                </t>
                            </ul>
                        </details>
                    </t>
                    <t t-else="">
                        <ul class="list-unstyled mb-0">
                            <t t-foreach="items" t-as="it">
                                <li class="mb-2">
                                    <t t-call="bemade_sports_clinic.dashboard_change_item"/>
                                </li>
                            </t>
                        </ul>
                    </t>
                </t>
                <t t-else="">
                    <div class="text-muted fst-italic small">No tracked changes in this window.</div>
                </t>
            </div>
        </template>
    </data>
</odoo>
