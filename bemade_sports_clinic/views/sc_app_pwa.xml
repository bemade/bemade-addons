<?xml version="1.0" encoding="utf-8"?>
<!--
    Task 5201 (kit P6): the installable app is bemade_portal_kit_pwa's. Fit
    Crew keeps its own wording on the install and offline pages (health
    data; the offline page is shared by staff and clients) through the
    pages' slots; the name, colours
    and icons are the company's app fields (models/sc_app_pwa.py).
-->
<odoo>
    <template id="sc_pwa_install_texts" name="Sports Clinic App: install page wording"
              inherit_id="bemade_portal_kit_pwa.pk_app_install">
        <xpath expr="//t[@name='pk_install_promise']" position="replace">
            <t name="pk_install_promise">Full screen, an icon on your home screen, instant opening. Health data is never stored on the device.</t>
        </xpath>
        <xpath expr="//t[@name='pk_install_footnote']" position="replace">
            <t name="pk_install_footnote">Without a connection the app only shows an offline page: no team or player data is kept on the device.</t>
        </xpath>
    </template>

    <template id="sc_pwa_offline_texts" name="Sports Clinic App: offline page wording"
              inherit_id="bemade_portal_kit_pwa.pk_app_offline">
        <xpath expr="//t[@name='pk_offline_message']" position="replace">
            <!-- Review round 2 (#1795): one page for every user of the
                 installed app (the kit serves the default app's, data-free,
                 cached on the device): worded for staff and clients alike.
                 Reworded enough that an upgrade does not carry the old
                 French over (Odoo keeps a translation for a term >= 90 %
                 similar). -->
            <t name="pk_offline_message">You need a connection to use Le Fit Crew. Your drafts are kept on this device and come back when you open the page again.</t>
        </xpath>
    </template>
</odoo>
