<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="teams_view_search" model="ir.ui.view">
            <field name="name">teams.view.search</field>
            <field name="model">sports.team</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="parent_id" string="Parent Organization"/>
                    <field name="head_coach_id"/>
                    <field name="head_therapist_id"/>
                    <filter context="{'group_by': 'parent_id'}" name="groupby_parent_id"/>
                    <filter context="{'group_by': 'head_coach_id'}" name="groupby_head_coach_id"/>
                    <filter context="{'group_by': 'head_therapist_id'}" name="groupby_head_therapist_id"/>
                </search>
            </field>
        </record>
        <record id="sports_team_view_kanban" model="ir.ui.view">
            <field name="name">sports.team.view.kanban</field>
            <field name="model">sports.team</field>
            <field name="arch" type="xml">
                <kanban archivable="false" default_group_by="parent_id" default_order="name" group_create="false" group_delete="false">
                    <field name="name"/>
                    <field name="parent_id"/>
                    <field name="head_coach_name"/>
                    <field name="head_therapist_name"/>
                    <field name="injured_count"/>
                    <field name="healthy_count"/>
                    <templates>
                        <t t-name="card">
                            <div t-attf-class="oe_kanban_content oe_kanban_global_click">
                                <div>
                                    <strong class="o_kanban_record_title">
                                        <span>
                                            <field name="name"/>
                                        </span>
                                    </strong>
                                </div>
                                <div>
                                    <span class="o_kanban_record_subtitle">
                                        <field name="parent_id"/>
                                    </span>
                                </div>
                                <div>
                                    <span>
                                        Head coach:
                                        <field name="head_coach_name"/>
                                    </span>
                                </div>
                                <div>
                                    <span>
                                        Head therapist:
                                        <field name="head_therapist_name"/>
                                    </span>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <span class="text-success">
                                            Healthy:
                                            <field name="healthy_count"/>
                                        </span>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <span t-attf-class="{{record.injured_count.value != 0 ? 'text-danger' : ''}}">
                                            Injured:
                                            <field name="injured_count"/>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>
        <record id="sports_team_view_list" model="ir.ui.view">
            <field name="name">sports.team.view.list</field>
            <field name="model">sports.team</field>
            <field name="arch" type="xml">
                <list string="Sports Teams">
                    <field name="name"/>
                    <field name="parent_id"/>
                    <field name="head_coach_id"/>
                    <field name="head_therapist_id"/>
                    <field name="player_count"/>
                    <field name="injured_count"/>
                </list>
            </field>
        </record>
        <!-- Task 1272 (re-plan): single-column, full-width kanban of the
             recently-active players for the team Dashboard tab. One roomy card
             per row (full-width via the o_sports_dashboard_kanban class + backend
             SCSS); each card renders the TP-scoped CHANGE DIGEST (dashboard_digest_html)
             — the fields that changed in the window with their current value,
             de-duped — instead of raw counts. Ordered by the TP dashboard score
             (most concerning first) via _compute_dashboard_active_patients. -->
        <record id="sports_patient_view_kanban_dashboard" model="ir.ui.view">
            <field name="name">sports.patient.view.kanban.dashboard</field>
            <field name="model">sports.patient</field>
            <field name="arch" type="xml">
                <kanban class="o_sports_dashboard_kanban" create="false"
                        records_draggable="false" group_create="false"
                        default_order="dashboard_score_tp desc">
                    <field name="first_name"/>
                    <field name="last_name"/>
                    <field name="stage"/>
                    <field name="position"/>
                    <field name="active_injury_count"/>
                    <field name="dashboard_score_tp"/>
                    <field name="dashboard_digest_html"/>
                    <templates>
                        <t t-name="card">
                            <!-- Task 1272 (round 4, defect 1): opening the patient
                                 form is not the dashboard's purpose. In Odoo 19 a kanban
                                 record card opens its form on click regardless of the
                                 pre-16 oe_kanban_global_click class (removed round 3),
                                 so removing that alone did NOT stop the popup. The web
                                 KanbanRecord.onGlobalClick handler bails out (no
                                 openRecord) when ev.target.closest() matches its
                                 CANCEL_GLOBAL_CLICK selector — which includes
                                 ".oe_kanban_action" — WITHOUT preventDefault. Marking the
                                 whole card with oe_kanban_action therefore cancels the
                                 record-open on any click while the native <details>
                                 toggle still fires at the target. No JS, keeps styling. -->
                            <div class="o_sports_dashboard_card oe_kanban_action p-2">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <!-- Round 5: the card-wide oe_kanban_action (above) cancels the
                                         record-open on ANY click, which also killed the *intended* way to
                                         open the patient form. Restore ONE explicit open path: the player
                                         name is an <a type="open"> action link, so clicking the name opens
                                         the form while clicking the digest still only expands/collapses. -->
                                    <strong class="o_kanban_record_title">
                                        <a type="open" role="button" class="text-reset" style="cursor: pointer;"><field name="last_name"/>, <field name="first_name"/></a>
                                    </strong>
                                    <span t-attf-class="badge {{ record.stage.raw_value == 'no_play' ? 'text-bg-danger' : record.stage.raw_value == 'practice_ok' ? 'text-bg-warning' : 'text-bg-success' }}">
                                        <field name="stage"/>
                                    </span>
                                </div>
                                <field name="dashboard_digest_html" widget="html"/>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>
        <!-- Task 1272: embedded list of the team's upcoming (7-day) events. -->
        <record id="sports_event_view_list_team_dashboard" model="ir.ui.view">
            <field name="name">sports.event.view.list.team.dashboard</field>
            <field name="model">sports.event</field>
            <field name="arch" type="xml">
                <list string="Upcoming Events" create="false"
                      decoration-muted="state == 'cancelled'">
                    <field name="name"/>
                    <field name="event_type"/>
                    <field name="date_start"/>
                    <field name="date_end" optional="hide"/>
                    <field name="state"/>
                </list>
            </field>
        </record>
        <record id="sports_team_view_form" model="ir.ui.view">
            <field name="name">sports.team.view.form</field>
            <field name="model">sports.team</field>
            <field name="arch" type="xml">
                <form>
                    <field invisible="1" name="id"/>
                    <header>
                        <!-- Visibility only; the real, per-team permission check
                             lives in sports.patient.remove_from_team. -->
                        <button name="%(action_team_player_removal)d"
                                string="Remove Players"
                                type="action"
                                class="btn-primary"
                                groups="base.group_system,bemade_sports_clinic.group_sports_clinic_treatment_professional"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box"/>
                        <div class="oe_title">
                            <h1>
                                <field name="name"/>
                            </h1>
                        </div>
                        <group string="Team Information">
                            <group>
                                <field name="parent_id"/>
                                <field name="player_count"/>
                                <field name="injured_count"/>
                                <field name="show_position_on_dashboard"/>
                            </group>
                            <group>
                                <field name="staff_ids">
                                    <list>
                                        <field name="sequence" widget="handle"/>
                                        <field name="name"/>
                                        <field name="role"/>
                                        <field name="mobile" widget="phone"/>
                                        <field name="silent_notifications" optional="hide"/>
                                        <field column_invisible="True" name="has_portal_access"/>
                                        <field column_invisible="True" name="partner_id"/>
                                        <button class="oe_highlight" groups="bemade_sports_clinic.group_sports_clinic_admin,base.group_system" icon="fa-user-plus" invisible="has_portal_access == True" name="action_grant_portal_access" title="Grant Portal Access" type="object"/>
                                        <button class="oe_highlight" groups="bemade_sports_clinic.group_sports_clinic_admin,base.group_system" icon="fa-ban" invisible="has_portal_access == False" name="action_revoke_portal_access" title="Revoke Portal Access" type="object"/>
                                    </list>
                                </field>
                            </group>
                        </group>
                        <notebook>
                            <page name="dashboard" string="Dashboard">
                                <!-- Task 1270: team announcement (TP-authored,
                                     all-staff visible). Optional soft deadline;
                                     stays until dismissed. -->
                                <field name="announcement_is_expired" invisible="1"/>
                                <field name="announcement_author_id" invisible="1"/>
                                <!-- Task 1380: Law 25 warning is now an onchange
                                     popup (see _onchange_announcement_law25_warning),
                                     not a permanent banner. -->
                                <!-- Task 1380 (CR-C): the announcement history is a
                                     single button next to Archive inside the header,
                                     replacing the old <details> disclosure line. It
                                     is still a JS-free native <details> — the summary
                                     is just styled as a button — so it toggles the
                                     same history list with no client code. Task 1385
                                     (CR-D4): UI text is English source; French is
                                     supplied by i18n/fr_CA.po (owner standard). -->
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <span class="fw-bold">Team announcement</span>
                                    <span class="badge text-bg-secondary" invisible="not announcement_is_expired">Expired</span>
                                    <div class="ms-auto d-flex align-items-center gap-2">
                                        <details class="d-inline-block" invisible="not note_history_ids">
                                            <summary class="btn btn-sm btn-outline-secondary" style="list-style:none;cursor:pointer;">
                                                <i class="fa fa-history me-1"/>History
                                            </summary>
                                            <field name="note_history_ids" nolabel="1" readonly="1" class="mt-2">
                                                <list create="false" edit="false" delete="false">
                                                    <field name="note_datetime"/>
                                                    <field name="author_id"/>
                                                    <field name="action"/>
                                                    <field name="body"/>
                                                </list>
                                            </field>
                                        </details>
                                        <button name="action_dismiss_announcement" type="object"
                                                string="Archive" class="btn-sm btn-secondary"
                                                invisible="not announcement"
                                                confirm="Archive this announcement from the dashboard?"/>
                                    </div>
                                </div>
                                <field name="announcement" nolabel="1"
                                       placeholder="Write an announcement for all team staff…"/>
                                <div class="d-flex flex-wrap align-items-center gap-3 mb-3">
                                    <label for="announcement_deadline" class="fw-normal mb-0">Valid until (optional):</label>
                                    <field name="announcement_deadline" nolabel="1"/>
                                    <span class="text-muted small" invisible="not announcement_date">
                                        Posted on <field name="announcement_date" readonly="1" nolabel="1" class="d-inline"/>
                                    </span>
                                </div>
                                <!-- Team-health header: red/yellow/green counts
                                     by stage (task 1272). -->
                                <div class="d-flex flex-wrap gap-2 mb-3" name="team_health">
                                    <span class="badge fs-6 text-bg-danger">
                                        <i class="fa fa-ban me-1"/>
                                        <field name="stage_no_play_count" readonly="1"/> No Play
                                    </span>
                                    <span class="badge fs-6 text-bg-warning" style="color:#000;">
                                        <i class="fa fa-exclamation-triangle me-1"/>
                                        <field name="stage_practice_ok_count" readonly="1"/> Practice OK
                                    </span>
                                    <span class="badge fs-6 text-bg-success">
                                        <i class="fa fa-check me-1"/>
                                        <field name="stage_healthy_count" readonly="1"/> Healthy
                                    </span>
                                </div>
                                <separator string="Recent Player Changes"/>
                                <!-- Single-column full-width kanban digest (task 1272 re-plan).
                                     dashboard_show_position carries the per-team toggle into the
                                     patient digest compute so position shows only when enabled. -->
                                <field name="dashboard_active_patient_ids" nolabel="1"
                                       readonly="1" mode="kanban"
                                       context="{'kanban_view_ref': 'bemade_sports_clinic.sports_patient_view_kanban_dashboard', 'dashboard_show_position': show_position_on_dashboard}"/>
                                <separator string="Upcoming Events (next 7 days)"/>
                                <field name="dashboard_upcoming_event_ids" nolabel="1"
                                       readonly="1"
                                       context="{'list_view_ref': 'bemade_sports_clinic.sports_event_view_list_team_dashboard'}"/>
                            </page>
                            <page name="players" string="Players">
                                <field name="patient_ids" nolabel="1"
                                       context="{'list_view_ref': 'bemade_sports_clinic.sports_patient_view_list_embedded'}"/>
                            </page>
                            <page name="user_access"
                                  string="User Access"
                                  groups="bemade_sports_clinic.group_sports_clinic_admin,base.group_system">
                                <field name="allowed_user_ids"/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter reload_on_post="True"/>
                </form>
            </field>
        </record>
        <record id="sports_team_staff_view_form" model="ir.ui.view">
            <field name="name">sports.team.staff.view.form</field>
            <field name="model">sports.team.staff</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="partner_id"/>
                                <field name="parent_id"/>
                                <field name="role"/>
                            </group>
                            <group>
                                <field name="mobile" widget="phone"/>
                                <field name="email" widget="email"/>
                                <field name="silent_notifications"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>
