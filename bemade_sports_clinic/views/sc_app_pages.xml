<?xml version="1.0" encoding="utf-8"?>
<!--
    Task 1538 (epic #1535) — P1a pages of the portal app shell: the app home
    (« Tableau de bord », task 1623; was « Équipes »), the teams list and
    « Plus ». Rendered only with the system
    switch on (see controllers/app_shell.py); today's templates are untouched.
    Section visibility is asked from the registry with sc_can(<key>) — never
    from groups.
-->
<odoo>

    <!-- /my/home (shell) — « Tableau de bord »: task 1624 moved it to
         views/sc_app_dashboard.xml (configurable widget sections). -->

    <!-- One team row (/my/teams; task 1624: no longer on the home). Variable: row
         (_sc_team_row). Task 1592: a link row (sc_link_row) so the activity
         clock chip is its own link; data-sc-team-id on the main link. -->
    <template id="sc_team_list_row" name="App shell: team list row">
        <t t-call="bemade_portal_kit.pk_link_row">
            <t t-set="href" t-value="row['url']"/>
            <t t-set="dot" t-value="row['status']"/>
            <t t-set="title" t-value="row['title']"/>
            <t t-set="subtitle" t-value="row['subtitle']"/>
            <t t-set="main_attrs" t-value="{'data-sc-team-id': row['id']}"/>
            <t t-call="bemade_sports_clinic.sc_activity_clock">
                <t t-set="clock" t-value="row.get('clock')"/>
            </t>
        </t>
    </template>

    <!-- /my/teams (shell) — every team, sticky sort (task 1401) kept -->
    <template id="sc_app_teams" name="Sports Clinic App: teams">
        <t t-call="bemade_sports_clinic.sc_app_layout">
            <t t-set="pk_title">My teams</t>
            <t t-set="pk_active_nav" t-value="'teams'"/>

            <!-- A refused team (1577 review): the clean, translated message. -->
            <t t-if="error" t-call="bemade_portal_kit.pk_banner">
                <t t-set="flash_error" t-value="True"/>
                <t t-set="tone" t-value="'warn'"/>
                <t t-out="error"/>
            </t>

            <form method="get" action="/my/teams" class="o_pk_search" role="search">
                <input type="hidden" name="sort" t-att-value="sort_mode"/>
                <label for="sc_teams_search" class="o_pk_field_label">Search</label>
                <div class="o_pk_search_row">
                    <input type="search" id="sc_teams_search" name="search" class="o_pk_input"
                           placeholder="Team or organization" t-att-value="search or ''"/>
                    <button type="submit" class="o_pk_btn o_pk_btn_ghost">Search</button>
                </div>
            </form>

            <!-- Task 1607: the sort in the list header (a menu, same control
                 on every list); no add on this list. -->
            <t t-call="bemade_portal_kit.pk_list_header">
                <t t-set="header_section" t-value="'teams.header'"/>
                <t t-set="sc_sort_activity">Recent activity</t>
                <t t-set="sc_sort_alpha">Alphabetical</t>
                <t t-set="sc_sort_mine">My order</t>
                <t t-set="sorts" t-value="sc_sort_options('sort', [('activity', sc_sort_activity), ('alpha', sc_sort_alpha)] + ([('mine', sc_sort_mine)] if can_rank else []), sort_mode)"/>
                <t t-set="sort_id" t-value="'sc_teams_sort'"/>
                <t t-set="sort_label">Sort teams</t>
                <t t-set="sort_section" t-value="'teams.sort'"/>
            </t>

            <div t-if="teams" class="o_pk_list">
                <t t-foreach="teams" t-as="team">
                    <t t-set="row" t-value="sc_team_row(team, True, sc_team_clocks)"/>
                    <div t-attf-class="o_pk_row_wrap #{'o_pk_row_wrap_reorder' if sort_mode == 'mine' else ''}"
                         t-attf-id="team-#{team.id}">
                        <t t-call="bemade_sports_clinic.sc_team_list_row"/>
                        <!-- « My order »: the up/down posts of task 1401 (no drag in the shell). -->
                        <div t-if="sort_mode == 'mine'" class="o_pk_reorder">
                            <form action="/my/teams/reorder" method="post">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <input type="hidden" name="team_id" t-att-value="team.id"/>
                                <input type="hidden" name="direction" value="up"/>
                                <input type="hidden" name="search" t-att-value="search or ''"/>
                                <input type="hidden" name="page" t-att-value="page or 1"/>
                                <button type="submit" class="o_pk_icon_btn" aria-label="Move up" title="Move up">
                                    <t t-call="bemade_portal_kit.pk_icon"><t t-set="icon" t-value="'up'"/></t>
                                </button>
                            </form>
                            <form action="/my/teams/reorder" method="post">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <input type="hidden" name="team_id" t-att-value="team.id"/>
                                <input type="hidden" name="direction" value="down"/>
                                <input type="hidden" name="search" t-att-value="search or ''"/>
                                <input type="hidden" name="page" t-att-value="page or 1"/>
                                <button type="submit" class="o_pk_icon_btn" aria-label="Move down" title="Move down">
                                    <t t-call="bemade_portal_kit.pk_icon"><t t-set="icon" t-value="'down'"/></t>
                                </button>
                            </form>
                        </div>
                    </div>
                </t>
            </div>
            <t t-else="" t-call="bemade_portal_kit.pk_empty_state">
                <t t-set="message">No team matches.</t>
            </t>

            <div t-if="pager and pager.get('page_count', 0) &gt; 1" class="o_pk_pager">
                <t t-call="portal.pager"/>
            </div>
        </t>
    </template>

    <!-- Task 5200 (kit P5): « Plus » (/my/app/more) and « Paramètres »
         (/my/app/settings) are the kit's pages (bemade_portal_kit.pk_app_more
         / pk_app_settings, drawn on sc_app_layout). The clinic adds: -->

    <!-- « Plus »: the brand footnote. -->
    <template id="sc_app_more_footnote" inherit_id="bemade_portal_kit.pk_app_more"
              name="Sports Clinic App: more, footnote">
        <xpath expr="//t[@name='pk_more_extra']" position="before">
            <p class="o_pk_footnote">Le Fit Crew</p>
        </xpath>
    </template>

    <!-- « Paramètres »: task 1665, the morning summary opt-out, for every app
         role (the user's own preference; default on). Priority 8: applied
         before the other extensions of the page (the bookings addon inserts
         its section after this one, //section[@id='sc_morning_summary']). -->
    <template id="sc_app_settings_morning_summary" inherit_id="bemade_portal_kit.pk_app_settings"
              name="Sports Clinic App: settings, morning summary" priority="8">
        <xpath expr="//t[@name='pk_settings_extra']" position="before">
            <section class="o_pk_section" id="sc_morning_summary" data-pk-section="settings.morning_summary">
                <form method="post" action="/my/app/pref" class="o_pk_card o_pk_switch_card">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <input type="hidden" name="redirect" value="/my/app/settings"/>
                    <t t-call="bemade_portal_kit.pk_switch">
                        <t t-set="sw_name" t-value="'digest_daily_enabled'"/>
                        <t t-set="sw_value" t-value="'1'"/>
                        <t t-set="sw_off" t-value="'0'"/>
                        <t t-set="sw_checked" t-value="request.env.user.digest_daily_enabled"/>
                        <t t-set="sw_attrs" t-value="{'data-pk-switch-submit': '1'}"/>
                        <t t-set="sw_label">Receive the daily summary by email</t>
                    </t>
                </form>
            </section>
        </xpath>
    </template>

</odoo>
