<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <!-- Task 1267: backend history of the team dashboard daily digest
             snapshots. Read-only audit surface; snapshots are written by the
             capture cron and removed by the purge cron. -->
        <record id="sports_team_digest_view_list" model="ir.ui.view">
            <field name="name">sports.team.digest.view.list</field>
            <field name="model">sports.team.digest</field>
            <field name="arch" type="xml">
                <list create="false" default_order="snapshot_date desc">
                    <field name="snapshot_date"/>
                    <field name="team_id"/>
                    <field name="player_count"/>
                    <field name="change_count"/>
                    <field name="new_injury_count"/>
                    <field name="note_update_count"/>
                    <field name="stage_no_play_count" string="No Play"/>
                    <field name="stage_practice_ok_count" string="Practice OK"/>
                    <field name="stage_healthy_count" string="Healthy"/>
                    <field name="captured_at"/>
                    <field name="timezone" optional="hide"/>
                </list>
            </field>
        </record>

        <record id="sports_team_digest_view_form" model="ir.ui.view">
            <field name="name">sports.team.digest.view.form</field>
            <field name="model">sports.team.digest</field>
            <field name="arch" type="xml">
                <form create="false" edit="false">
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name" readonly="1"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="team_id" readonly="1"/>
                                <field name="snapshot_date" readonly="1"/>
                                <field name="captured_at" readonly="1"/>
                                <field name="timezone" readonly="1"/>
                            </group>
                            <group>
                                <field name="player_count" readonly="1"/>
                                <field name="change_count" readonly="1"/>
                                <field name="new_injury_count" readonly="1"/>
                                <field name="note_update_count" readonly="1"/>
                            </group>
                        </group>
                        <group string="Team Health At Capture">
                            <group>
                                <field name="stage_no_play_count" readonly="1"/>
                                <field name="stage_practice_ok_count" readonly="1"/>
                                <field name="stage_healthy_count" readonly="1"/>
                            </group>
                        </group>
                        <separator string="Captured Changes (internal view)"/>
                        <field name="digest_html" widget="html" readonly="1" nolabel="1"/>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="sports_team_digest_view_search" model="ir.ui.view">
            <field name="name">sports.team.digest.view.search</field>
            <field name="model">sports.team.digest</field>
            <field name="arch" type="xml">
                <search>
                    <field name="team_id"/>
                    <field name="snapshot_date"/>
                    <filter name="has_new_injury" string="Has New Injury"
                            domain="[('new_injury_count', '>', 0)]"/>
                    <filter name="group_team" string="Team"
                            context="{'group_by': 'team_id'}"/>
                    <filter name="group_date" string="Snapshot Date"
                            context="{'group_by': 'snapshot_date'}"/>
                </search>
            </field>
        </record>

        <record id="action_view_team_digest" model="ir.actions.act_window">
            <field name="name">Team Digests</field>
            <field name="res_model">sports.team.digest</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="sports_team_digest_view_search"/>
            <field name="context">{'create': False}</field>
        </record>

        <menuitem id="sports_clinic_team_digests"
                  name="Team Digests"
                  parent="sports_clinic_staff_menu"
                  groups="bemade_sports_clinic.group_sports_clinic_treatment_professional,bemade_sports_clinic.group_sports_clinic_admin"
                  action="action_view_team_digest"
                  sequence="30"/>

        <!-- Add the retention field + a digest-history smart button to the team form. -->
        <record id="sports_team_view_form_digest" model="ir.ui.view">
            <field name="name">sports.team.view.form.digest</field>
            <field name="model">sports.team</field>
            <field name="inherit_id" ref="sports_team_view_form"/>
            <field name="arch" type="xml">
                <!-- The base form's button box lacks name="button_box", so Odoo 19
                     renders it (and any smart button) inline above the title instead
                     of in the top-right box. Name it so smart buttons dock correctly. -->
                <xpath expr="//div[hasclass('oe_button_box')]" position="attributes">
                    <attribute name="name">button_box</attribute>
                </xpath>
                <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                    <button name="action_view_digests" type="object"
                            class="oe_stat_button" icon="fa-history">
                        <field name="digest_count" widget="statinfo" string="Digests"/>
                    </button>
                </xpath>
                <xpath expr="//field[@name='show_position_on_dashboard']" position="after">
                    <field name="digest_retention_days"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
