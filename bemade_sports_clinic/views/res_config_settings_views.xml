<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <record id="view_res_config_settings_bemade_sports_clinic" model="ir.ui.view">
      <field name="name">res.config.settings.view.form.bemade_sports_clinic</field>
      <field name="model">res.config.settings</field>
      <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
      <field name="arch" type="xml">
        <xpath expr="//app[@name='general_settings']" position="inside">
          <block title="Sports Clinic Invoicing" id="bemade_sports_clinic_settings">
            <setting string="Therapist Coverage Product (Vendor PO)" help="Default product used for therapist coverage on Purchase Orders">
              <div class="content-group">
                <field name="product_event_coverage_vendor_id"/>
              </div>
            </setting>
            <setting string="Therapist Travel Product (Vendor PO)" help="Default product used for therapist travel on Purchase Orders">
              <div class="content-group">
                <field name="product_event_travel_vendor_id"/>
              </div>
            </setting>
            <setting string="Clinic Product (Vendor PO)" help="Product used for clinic events on Vendor Purchase Orders">
              <div class="content-group">
                <field name="product_event_clinic_vendor_id"/>
              </div>
            </setting>
            <setting string="Material Report Recipient" help="Email address pre-filled in the portal Add Timesheet notice inviting therapists to report personal material used, for client re-invoicing.">
              <div class="content-group">
                <field name="material_report_email"/>
              </div>
            </setting>

            <setting string="Coverage Product (Customer Invoice)" help="Default product used for event coverage on Customer Invoices">
              <div class="content-group">
                <field name="product_event_coverage_customer_id"/>
              </div>
            </setting>
            <setting string="Travel Product (Customer Invoice)" help="Default product used for travel time on Customer Invoices">
              <div class="content-group">
                <field name="product_event_travel_customer_id"/>
              </div>
            </setting>
            <setting string="Clinic Product (Customer Invoice)" help="Product used for clinic events on Customer Invoices/Quotations">
              <div class="content-group">
                <field name="product_event_clinic_customer_id"/>
              </div>
            </setting>

            <setting string="Digest Capture Time" help="Team-local clock time (HH:MM) at/after which each team's daily dashboard-digest snapshot is captured.">
              <div class="content-group">
                <field name="digest_capture_time" placeholder="00:00"/>
              </div>
            </setting>
            <setting string="Digest Default Timezone" help="Fallback timezone (e.g. America/Toronto) used to resolve a team's local capture date when its organization partner has no timezone set.">
              <div class="content-group">
                <field name="digest_default_timezone" placeholder="America/Toronto"/>
              </div>
            </setting>
            <setting string="Morning Briefing Send Time" help="User-local clock time (HH:MM) at/after which each staff member's daily PHI-free morning briefing is sent, in their own timezone.">
              <div class="content-group">
                <field name="digest_morning_send_time" placeholder="07:00"/>
              </div>
            </setting>
            <setting string="Dashboard Activity Window (hours)" help="Recency window (hours) for the team dashboard, its portal view and the morning briefing's change counts (e.g. 24 / 48 / 72). The daily digest snapshot stays a fixed 24h slice regardless. Floored at 1h.">
              <div class="content-group">
                <field name="dashboard_activity_window_hours" placeholder="24"/>
              </div>
            </setting>

            <setting string="Quick Note Staleness (days)" help="Age in days after which an undismissed quick note raises a reminder for its owner and a summary reminder for the clinic administrators. Quick notes are never auto-deleted.">
              <div class="content-group">
                <field name="quick_note_stale_days" placeholder="365"/>
              </div>
            </setting>

            <setting string="Unregistered Kiosk Sign-ins Retention (days)" help="Days after a clinic ends before its unresolved kiosk sign-ins (name and date of birth typed by a player who matched no file) are purged. Linked, created or removed rows are not concerned. 0 = never purge.">
              <div class="content-group">
                <field name="kiosk_unregistered_retention_days" placeholder="7"/>
              </div>
            </setting>

            <setting string="Legacy Per-Change Emails" help="When off (default), the three legacy per-change follower emails (play-status, injury edit, internal note) are suppressed in favour of the aggregated 5-minute urgent notification and the dashboard/daily digest. Turn on to restore the old one-email-per-change behaviour.">
              <field name="legacy_change_emails_enabled"/>
            </setting>

            <setting string="Urgent Notifications — Last Run" help="Watermark for the 5-minute urgent-notification cron. Rewind it to re-scan an earlier window.">
              <div class="content-group">
                <field name="urgent_notify_last_run"/>
              </div>
            </setting>

            <setting string="Sports Clinic Maintenance" help="Recompute followers and team staff group memberships for all sports clinic records.">
              <div class="content-group">
                <button name="action_recompute_sports_followers_and_groups"
                        type="object"
                        string="Recompute Followers &amp; Groups"
                        class="btn btn-secondary"
                        groups="base.group_system,bemade_sports_clinic.group_sports_clinic_admin"/>
              </div>
            </setting>

            <setting string="Sports Clinic Group Maintenance" help="Recompute only team staff group memberships (no follower updates).">
              <div class="content-group">
                <button name="action_recompute_sports_groups_only"
                        type="object"
                        string="Recompute Groups Only"
                        class="btn btn-secondary"
                        groups="base.group_system,bemade_sports_clinic.group_sports_clinic_admin"/>
              </div>
            </setting>
          </block>
        </xpath>
      </field>
    </record>

  </data>
</odoo>
