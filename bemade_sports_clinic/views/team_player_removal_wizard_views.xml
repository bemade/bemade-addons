<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Wizard Form View -->
        <record id="view_team_player_removal_wizard_form" model="ir.ui.view">
            <field name="name">sports.team.player.removal.wizard.form</field>
            <field name="model">sports.team.player.removal.wizard</field>
            <field name="arch" type="xml">
                <form string="Remove Players">
                    <sheet>
                        <div class="alert alert-info" role="alert">
                            Tick the players to take off this team, then click Remove.
                            Removing a player from their last team starts their
                            retention clock, but does not archive them — they stay
                            in the active player list.
                        </div>
                        <group>
                            <field name="team_id"/>
                            <field name="select_all"/>
                        </group>
                        <field name="line_ids"
                               nolabel="1"
                               context="{'list_view_ref': 'bemade_sports_clinic.view_team_player_removal_line_list'}"/>
                    </sheet>
                    <footer>
                        <button string="Remove" type="object" name="action_remove" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Dedicated List View for Lines -->
        <record id="view_team_player_removal_line_list" model="ir.ui.view">
            <field name="name">sports.team.player.removal.line.list</field>
            <field name="model">sports.team.player.removal.line</field>
            <field name="arch" type="xml">
                <list editable="bottom" string="Players" create="false" delete="false">
                    <field name="selected"/>
                    <!-- force_save is REQUIRED: the web client drops readonly fields from the
                         create/write payload, so without it the transient wizard persists each
                         line with a NULL patient_id (not-null violation) and action_remove, which
                         reads patient_id, can never run. Do not remove. -->
                    <field name="patient_id" readonly="1" force_save="1"/>
                </list>
            </field>
        </record>

        <!-- Window Action -->
        <record id="action_team_player_removal" model="ir.actions.act_window">
            <field name="name">Remove Players</field>
            <field name="res_model">sports.team.player.removal.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>
