<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>

    <!-- Wizard form view -->
    <!-- Lightweight tree for timesheet selection in wizard -->
    <record id="view_timesheet_tree_for_invoicing_wizard" model="ir.ui.view">
      <field name="name">sports.event.timesheet.tree.invoicing_wizard</field>
      <field name="model">sports.event.timesheet</field>
      <field name="arch" type="xml">
        <list string="Timesheets" create="0" edit="0" delete="0">
          <field name="user_id" string="Therapist"/>
          <field name="coverage_duration" widget="float_time" string="Coverage (h)"/>
          <field name="travel_duration" widget="float_time" string="Travel (h)"/>
        </list>
      </field>
    </record>

    <record id="view_sports_event_invoicing_wizard_form" model="ir.ui.view">
      <field name="name">sports.event.invoicing.wizard.form</field>
      <field name="model">sports.event.invoicing.wizard</field>
      <field name="arch" type="xml">
        <form string="Invoice Event Timesheets">
          <group>
            <field name="event_id" readonly="1"/>
            <field name="partner_id" readonly="1"/>
            <field name="team_id" readonly="1"/>
            <field name="customer_invoice_id"
                   context="{'default_move_type': 'out_invoice', 'default_partner_id': partner_id}"
                   options="{'no_quick_create': True, 'no_create_edit': True}"/>
          </group>
          <group string="Planned Times">
            <group>
              <field name="duration" readonly="1"/>
            </group>
            <group>
              <field name="therapist_duration" readonly="1"/>
            </group>
          </group>
          <group string="Timesheets">
            <field name="timesheet_ids" nolabel="1">
              <list string="Timesheets" create="0" edit="1" delete="0" editable="bottom">
                <field name="user_id" string="Therapist"/>
                <field name="coverage_duration" widget="float_time" string="Coverage (h)"/>
                <field name="travel_duration" widget="float_time" string="Travel (h)"/>
              </list>
            </field>
          </group>
          <group>
            <field name="description" placeholder="Description for created lines..."/>
          </group>
          <footer>
            <button name="action_process" type="object" string="Process" class="btn-primary"/>
            <button special="cancel" string="Cancel" class="btn-secondary"/>
          </footer>
        </form>
      </field>
    </record>

    <!-- Action to open wizard -->
    <record id="action_sports_event_invoicing_wizard" model="ir.actions.act_window">
      <field name="name">Invoice Timesheets</field>
      <field name="res_model">sports.event.invoicing.wizard</field>
      <field name="view_mode">form</field>
      <field name="target">new</field>
      <field name="context">{'default_event_id': active_id}</field>
      <field name="view_id" ref="view_sports_event_invoicing_wizard_form"/>
    </record>

  </data>
</odoo>
