<?xml version="1.0" encoding="utf-8"?>
<!--
    Task 1538 (epic #1535) — the Fit Crew portal app shell layout.

    Rendered ONLY through AppShellMixin._sc_render / the app routes, i.e. when
    the system switch is on and the viewer holds an app role. It replaces
    portal.portal_layout for the migrated sports-clinic /my pages; nothing
    inherits the stock layouts, so today's portal is untouched.

    Task 5345 (kit P3c2): the shell itself is the kit's app layout
    (bemade_portal_kit.pk_app_layout: rail, app bar, crumbs, content, user
    menu, theme toggle, form guard texts, toast host). This template keeps
    its xmlid and its callers and only fills the kit's slots with the Fit
    Crew pieces: the brand and logo, the activity clock, the
    medical sheets and the injury-resolve and proposal dialogs. Task 5200
    (kit P5): the help « ? », the search (magnifier and sheet) and the user
    menu's « Aide » are the kit layout's own; the kit's pages (settings,
    More, account, security) are drawn on this layout too.

    Page values (t-set in the t-call body), read by the kit:
      pk_title          app-bar title (also the <title>)
      pk_active_nav     registry key of the active tab / rail entry
      pk_page_key       optional « <model>:<id> » of the page's record (task
                        1611): the title and the crumb are read fragments
                        (<key>:appbar / :crumb) a save of that record
                        refreshes
      pk_content_class  extra classes of the content area
    The navigation (pk_rail, pk_tabs, pk_parent_url, pk_crumbs, pk_context)
    and the user's values come from AppShellMixin._sc_app_values (task 1579:
    the parent registry, portal.kit.pk_resolve) — pages never set them.
-->
<odoo>

    <template id="sc_app_layout" name="Sports Clinic App Layout">
        <t t-call="bemade_portal_kit.pk_app_layout">
            <!-- The Fit Crew brand: the rail name, the home (the dashboard)
                 and the browser bar colour of each theme (task 1602). -->
            <t t-set="sc_home_label">Dashboard</t>
            <t t-set="pk_brand" t-value="{'name': 'Le Fit Crew', 'home_url': '/my/home', 'home_label': sc_home_label,
                                          'theme_colors': {'dark': '#120e12', 'light': '#243925'}}"/>
            <t t-set="pk_brand_mark"><t t-call="bemade_sports_clinic.sc_logo_mark"/></t>
            <!-- pk_confirm.js: a page whose access ended goes back home, the
                 players list (a referrer on the same player is skipped). -->
            <t t-set="pk_home_url" t-value="'/my/players'"/>
            <t t-set="pk_home_same_params" t-value="'player_id'"/>
            <!-- Task 5200 (kit P5): the theme toggle, the settings item, the
                 « ? » help, the search and the user menu's « Aide » are the
                 kit's (pk_pref_url, pk_theme_field, pk_settings_url,
                 pk_help, pk_search from PortalKitShell._pk_shell_values). -->
            <!-- Task 1658: the clinic's refusals also come back in ?ts_error=
                 (the timesheet routes). -->
            <t t-set="pk_guard_params" t-value="'error ts_error'"/>
            <!-- Task 1542: installable app (scope /, task 1543). Task 5201 (kit
                 P6): its head (manifest, iOS icon and title) is
                 bemade_portal_kit_pwa's, added to the kit layout's head;
                 the Fit Crew name and icons are the company's app fields.
                 Task 1540: Teko / DM Sans are self-hosted (@font-face in
                 sc_tokens.scss) — no Google Fonts request. -->
            <t t-set="pk_appbar_actions">
                <!-- Task 1592: the activity clock (the slot the theme toggle
                     left, #1602; both fit when the choice is on). The red
                     badge = MY overdue activities, fetched by
                     pk_live_count.js from a light JSON route (at once, then
                     every 60 s while the tab is visible) — never computed
                     on every page; hidden at 0.
                     Task 1622: its href carries the page it is tapped on
                     (sc_from) — the activities page's way back. -->
                <t t-if="sc_activity_clock">
                    <t t-set="sc_clock_label">My activities</t>
                    <t t-set="sc_clock_badge_label">Overdue activities</t>
                    <a t-att-href="sc_clock_url"
                       class="o_pk_icon_btn o_sc_appbar_clock" data-sc-activity-clock-bar="1"
                       t-att-title="sc_clock_label">
                        <t t-call="bemade_portal_kit.pk_icon"><t t-set="icon" t-value="'clock'"/></t>
                        <span class="visually-hidden" t-out="sc_clock_label"/>
                        <span class="o_sc_appbar_badge" hidden="hidden"
                              data-pk-live-count-url="/my/activities/overdue/count"
                              data-pk-live-poll="60" data-pk-live-eager="1" data-pk-live-hide-zero="1"
                              t-att-title="sc_clock_badge_label">0</span>
                    </a>
                </t>
            </t>
            <t t-set="pk_layout_sheets">
                <!-- Task 1652: the popups of the red medical pills on this
                     page's player cards — once per player, outside every
                     read fragment (they hold islands). Rendered after the
                     page body, which lists the players. -->
                <t t-if="sc_card_med_patients and sc_can('patient.medical_alerts')">
                    <t t-set="sc_card_med_is_tp" t-value="sc_card_med_tp()"/>
                    <t t-foreach="sc_card_med_patients()" t-as="sc_card_med_patient">
                        <t t-call="bemade_sports_clinic.sc_medical_sheets">
                            <t t-set="patient" t-value="sc_card_med_patient"/>
                            <t t-set="scope" t-value="'card'"/>
                            <t t-set="tp" t-value="sc_card_med_is_tp"/>
                            <t t-set="editable" t-value="sc_card_med_is_tp"/>
                        </t>
                    </t>
                </t>
                <!-- Task 1604: « Resolve » confirms the resolution date
                     (sc_injury_quick.js fills the injury and posts to
                     /my/injury/<id>/resolve). Therapists only. -->
                <dialog t-if="sc_can('injury.stage.edit')" id="sc_injury_resolve_sheet" class="o_pk_sheet"
                        aria-labelledby="sc_injury_resolve_sheet_title">
                    <div class="o_pk_sheet_head">
                        <h2 class="o_pk_sheet_title" id="sc_injury_resolve_sheet_title">Resolve this injury?</h2>
                        <button type="button" class="o_pk_icon_btn" data-pk-sheet-close="1" aria-label="Close" title="Close">
                            <t t-call="bemade_portal_kit.pk_icon"><t t-set="icon" t-value="'close'"/></t>
                        </button>
                    </div>
                    <div class="o_pk_sheet_body">
                        <form class="o_pk_form" data-sc-injury-resolve-form="1" data-pk-guard="1" data-pk-guard-rules='[{"type":"not_future","field":"resolution_date","key":"future"}]'>
                            <p class="o_pk_confirm_message" data-sc-injury-resolve-name="1"/>
                            <div class="o_pk_field">
                                <label class="o_pk_field_label" for="sc_injury_resolve_date">Resolution Date</label>
                                <input type="date" id="sc_injury_resolve_date" name="resolution_date" class="o_pk_input" required="required"
                                       t-att-value="sc_today_iso" t-att-max="sc_today_iso"/>
                            </div>
                            <p class="o_pk_field_message o_pk_field_error" role="alert" data-sc-injury-resolve-error="1" hidden="hidden">The injury could not be resolved.</p>
                            <div class="o_pk_form_actions">
                                <button type="button" class="o_pk_btn o_pk_btn_ghost" data-pk-sheet-close="1">Cancel</button>
                                <button type="submit" class="o_pk_btn o_pk_btn_primary" data-sc-injury-resolve-confirm="1">Resolve</button>
                            </div>
                            <span hidden="hidden" data-pk-guard-msg="future">The resolution date cannot be in the future.</span>
                            <t t-call="bemade_portal_kit.pk_form_guard_slots"><t t-set="guard_id" t-value="'sc_injury_resolve'"/></t>
                        </form>
                    </div>
                </dialog>
                <!-- Task 1603: the follow-up proposal sheet (sc_proposal.js
                     fills it from a save's ``propose``, or from the
                     proposal a POST round-trip left: data-sc-proposal). -->
                <dialog id="sc_proposal_sheet" class="o_pk_sheet o_sc_proposal_sheet"
                        aria-labelledby="sc_proposal_sheet_title"
                        t-att-data-sc-proposal="sc_proposal_json or None">
                    <div class="o_pk_sheet_head">
                        <h2 class="o_pk_sheet_title" id="sc_proposal_sheet_title" data-sc-proposal-title="1"/>
                        <button type="button" class="o_pk_icon_btn" data-pk-sheet-close="1" aria-label="Close" title="Close">
                            <t t-call="bemade_portal_kit.pk_icon"><t t-set="icon" t-value="'close'"/></t>
                        </button>
                    </div>
                    <div class="o_pk_sheet_body">
                        <p class="o_sc_proposal_message" data-sc-proposal-message="1"/>
                        <ul class="o_sc_proposal_items" data-sc-proposal-items="1"/>
                        <p class="o_pk_field_message o_pk_field_error" role="alert" data-sc-proposal-error="1" hidden="hidden">The changes could not be applied.</p>
                        <div class="o_pk_banner_actions o_sc_proposal_actions">
                            <button type="button" class="o_pk_btn o_pk_btn_primary" data-sc-proposal-apply="1">Apply</button>
                            <button type="button" class="o_pk_btn o_pk_btn_ghost" data-sc-proposal-dismiss="1">Dismiss</button>
                        </div>
                    </div>
                </dialog>
            </t>
            <t t-out="0"/>
        </t>
    </template>

    <!-- Task 5345 (kit P3c2): the user menu's popup is the kit's
         (bemade_portal_kit.pk_user_menu_popup); the user guide item comes
         through the layout's pk_user_menu_extra slot. -->

</odoo>
