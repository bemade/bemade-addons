<?xml version="1.0" encoding="utf-8"?>
<!--
    Task 1539 (epic #1535) — activities on the portal app shell: the shared
    list + sheets (player page, team page, /my/activities and its wrappers)
    and the activity pages (list, create, edit, detail).

    Every sheet posts to the SAME route as today's modals (CSRF token in each
    form, task 1544); the legacy partials (activity_list_table,
    portal_activity_reassign_modal, portal_activity_add_header,
    portal_activity_assignee_access_warning) stay unchanged for the legacy
    pages — their inline scripts are replaced, in the shell only, by
    static/src/js/sc_activities.js. Assignable users come from
    _activity_assignable_users_for (task 1500). No inline script / style.
-->
<odoo>

    <!--
        Activity rows. Variables: activities, today_date, show_assignee,
        can_reassign, empty_message.
    -->
    <template id="sc_activity_list" name="App shell: activity list">
        <div t-if="activities" class="o_sc_list" data-sc-section="activities.list">
            <t t-foreach="activities" t-as="activity">
                <!-- Task 1595: computed in the controller, access-gated
                     (was a non-sudo browse here). -->
                <t t-set="related_links" t-value="sc_activity_related(activity)"/>
                <t t-call="bemade_sports_clinic.sc_activity_row"/>
            </t>
        </div>
        <t t-else="" t-call="bemade_sports_clinic.sc_empty_state">
            <t t-set="message" t-value="empty_message"/>
        </t>
    </template>

    <!--
        The row-action sheets (one of each per page; sc_activities.js fills
        activity_id from the clicked row). Variables: return_url,
        available_users, can_reassign, today.
    -->
    <template id="sc_activity_sheets" name="App shell: activity sheets">
        <t t-call="bemade_sports_clinic.sc_sheet">
            <t t-set="sheet_id" t-value="'sc_activity_complete_sheet'"/>
            <t t-set="title">Complete Activity</t>
            <t t-set="lazy_url" t-value="False"/>
            <form method="post" action="/my/activity/complete" class="o_sc_form" data-sc-form="activity.complete">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <input type="hidden" name="activity_id" value=""/>
                <input type="hidden" name="return_url" t-att-value="return_url"/>
                <div class="o_sc_field">
                    <label for="sc_activity_feedback" class="o_sc_field_label">Feedback (optional)</label>
                    <textarea id="sc_activity_feedback" name="feedback" class="o_sc_input o_sc_textarea" rows="3"/>
                </div>
                <div class="o_sc_form_actions">
                    <button type="button" class="o_sc_btn o_sc_btn_ghost" data-sc-sheet-close="1">Cancel</button>
                    <button type="submit" class="o_sc_btn o_sc_btn_primary">Complete Activity</button>
                </div>
            </form>
        </t>
        <t t-call="bemade_sports_clinic.sc_sheet">
            <t t-set="sheet_id" t-value="'sc_activity_reschedule_sheet'"/>
            <t t-set="title">Reschedule Activity</t>
            <t t-set="lazy_url" t-value="False"/>
            <form method="post" action="/my/activity/reschedule" class="o_sc_form" data-sc-form="activity.reschedule">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <input type="hidden" name="activity_id" value=""/>
                <input type="hidden" name="return_url" t-att-value="return_url"/>
                <div class="o_sc_field">
                    <label for="sc_activity_new_deadline" class="o_sc_field_label">New Due Date</label>
                    <input type="date" id="sc_activity_new_deadline" name="new_deadline" class="o_sc_input"
                           required="required" t-att-min="today"/>
                </div>
                <div class="o_sc_form_actions">
                    <button type="button" class="o_sc_btn o_sc_btn_ghost" data-sc-sheet-close="1">Cancel</button>
                    <button type="submit" class="o_sc_btn o_sc_btn_primary">Reschedule</button>
                </div>
            </form>
        </t>
        <t t-call="bemade_sports_clinic.sc_sheet">
            <t t-set="sheet_id" t-value="'sc_activity_cancel_sheet'"/>
            <t t-set="title">Cancel Activity</t>
            <t t-set="lazy_url" t-value="False"/>
            <form method="post" action="/my/activity/cancel" class="o_sc_form" data-sc-form="activity.cancel">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <input type="hidden" name="activity_id" value=""/>
                <input type="hidden" name="return_url" t-att-value="return_url"/>
                <p class="o_sc_confirm_message">Are you sure you want to cancel this activity? This action cannot be undone.</p>
                <div class="o_sc_form_actions">
                    <button type="button" class="o_sc_btn o_sc_btn_ghost" data-sc-sheet-close="1">No</button>
                    <button type="submit" class="o_sc_btn o_sc_btn_danger">Yes, Cancel Activity</button>
                </div>
            </form>
        </t>
        <t t-if="can_reassign" t-call="bemade_sports_clinic.sc_sheet">
            <t t-set="sheet_id" t-value="'sc_activity_reassign_sheet'"/>
            <t t-set="title">Reassign Activity</t>
            <t t-set="lazy_url" t-value="False"/>
            <form method="post" action="/my/activity/reassign" class="o_sc_form" data-sc-form="activity.reassign">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <input type="hidden" name="activity_id" value=""/>
                <input type="hidden" name="return_url" t-att-value="return_url"/>
                <p class="o_sc_meta"><span>Currently assigned to:</span> <strong data-sc-current-assignee="1"/></p>
                <div class="o_sc_field">
                    <label for="sc_activity_new_user" class="o_sc_field_label">Assign to:</label>
                    <select id="sc_activity_new_user" name="new_user_id" class="o_sc_input o_sc_select" required="required">
                        <option value="">Select a person…</option>
                        <t t-foreach="available_users" t-as="au">
                            <option t-att-value="au.id" t-out="au.name"/>
                        </t>
                    </select>
                </div>
                <div class="o_sc_form_actions">
                    <button type="button" class="o_sc_btn o_sc_btn_ghost" data-sc-sheet-close="1">Cancel</button>
                    <button type="submit" class="o_sc_btn o_sc_btn_primary">Reassign Activity</button>
                </div>
            </form>
        </t>
    </template>

    <!--
        « Ajouter une activité » — an inline card at the top of the tab, like
        « Add Emergency Contact » / « Upload Document » (owner review
        2026-10-10: same UX across the tabs; was a button opening a dialog).
        Variables: add_model, add_res_id, add_return_url, add_team_id,
        activity_types, assignable_users, default_activity_type_id, today.
    -->
    <template id="sc_activity_add_sheet" name="App shell: add activity (inline)">
        <!-- Task 1607: opened by the list header's « + Ajouter ». -->
        <t t-call="bemade_sports_clinic.sc_list_header">
            <t t-set="header_section" t-value="'activity.add.header'"/>
            <t t-set="add_label">Add Activity</t>
            <t t-set="add_panel" t-value="'sc_activity_add'"/>
            <t t-set="add_key" t-value="'activity.add'"/>
        </t>
        <details class="o_sc_card o_sc_disclosure o_sc_list_add_panel" id="sc_activity_add" data-sc-section="activity.add">
            <summary class="o_sc_disclosure_summary">
                <t t-call="bemade_sports_clinic.sc_icon"><t t-set="icon" t-value="'plus'"/></t>
                <span>Add Activity</span>
            </summary>
            <form action="/my/activity/save" method="post" class="o_sc_form" data-sc-form="activity.add">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <input type="hidden" name="model" t-att-value="add_model"/>
                <input type="hidden" name="res_id" t-att-value="add_res_id"/>
                <input type="hidden" name="return_url" t-att-value="add_return_url"/>
                <input t-if="add_team_id" type="hidden" name="team_id" t-att-value="add_team_id"/>
                <div class="o_sc_field">
                    <label for="sc_add_activity_type" class="o_sc_field_label">Activity Type</label>
                    <select id="sc_add_activity_type" name="activity_type_id" class="o_sc_input o_sc_select" required="required">
                        <t t-foreach="activity_types" t-as="atype">
                            <option t-att-value="atype.id" t-out="atype.name"
                                    t-att-selected="'selected' if atype.id == default_activity_type_id else None"/>
                        </t>
                    </select>
                </div>
                <div class="o_sc_field">
                    <label for="sc_add_activity_summary" class="o_sc_field_label">Summary</label>
                    <input type="text" id="sc_add_activity_summary" name="summary" class="o_sc_input" required="required"
                           placeholder="Brief description of the activity"/>
                </div>
                <div class="o_sc_field">
                    <label for="sc_add_activity_deadline" class="o_sc_field_label">Due Date</label>
                    <input type="date" id="sc_add_activity_deadline" name="date_deadline" class="o_sc_input" required="required"
                           t-att-min="today" t-att-value="today"/>
                </div>
                <div class="o_sc_field">
                    <label for="sc_add_activity_user" class="o_sc_field_label">Assigned To</label>
                    <select id="sc_add_activity_user" name="user_id" class="o_sc_input o_sc_select" required="required">
                        <t t-foreach="assignable_users" t-as="au">
                            <option t-att-value="au.id" t-out="au.name"
                                    t-att-selected="'selected' if au.id == request.env.user.id else None"/>
                        </t>
                    </select>
                </div>
                <div class="o_sc_form_actions">
                    <button type="submit" class="o_sc_btn o_sc_btn_primary">Add Activity</button>
                </div>
            </form>
        </details>
    </template>

    <!-- Task 1607: the activities page's list header — « + Ajouter » (the
         add-activity page, was the app bar's « Add Activity »). -->
    <template id="sc_activities_header" name="App shell: activities list header">
        <t t-call="bemade_sports_clinic.sc_list_header">
            <t t-set="header_section" t-value="'activities.header'"/>
            <t t-if="sc_add_activity_url">
                <t t-set="add_label">Add Activity</t>
                <t t-set="add_url" t-value="sc_add_activity_url"/>
                <t t-set="add_key" t-value="'activity.add'"/>
            </t>
        </t>
    </template>

    <!-- /my/activities (+ ?model=&res_id= context views, /my/team/activities,
         /my/event/activities) in the shell. -->
    <template id="sc_app_activities" name="Sports Clinic App: activities">
        <t t-call="bemade_sports_clinic.sc_app_layout">
            <t t-set="sc_title" t-value="sc_nav_labels['activities']"/>
            <t t-set="sc_active_nav" t-value="'activities'"/>
            <t t-call="bemade_sports_clinic.sc_flash_banners"/>
            <t t-set="sc_can_reassign" t-value="show_assignee and sc_can('activities.reassign')"/>
            <t t-if="simplified">
                <t t-call="bemade_sports_clinic.sc_activities_header"/>
                <t t-call="bemade_sports_clinic.sc_activity_list">
                    <t t-set="show_assignee" t-value="True"/>
                    <t t-set="can_reassign" t-value="sc_can_reassign"/>
                    <t t-set="empty_message">No activities found</t>
                </t>
            </t>
            <t t-else="">
                <t t-call="bemade_sports_clinic.sc_page_tabs">
                    <t t-set="tabs" t-value="sc_activity_tabs"/>
                    <t t-set="active" t-value="sc_activity_active_tab"/>
                </t>
                <t t-call="bemade_sports_clinic.sc_activities_header"/>
                <t t-foreach="sc_activity_tabs" t-as="atab">
                    <section class="o_sc_tab_panel" t-att-data-sc-tab-panel="atab[0]" role="tabpanel"
                             t-att-hidden="None if sc_activity_active_tab == atab[0] else 'hidden'">
                        <t t-call="bemade_sports_clinic.sc_activity_list">
                            <t t-set="activities" t-value="sc_activity_groups[atab[0]]"/>
                            <t t-set="show_assignee" t-value="show_assignee"/>
                            <t t-set="can_reassign" t-value="sc_can_reassign"/>
                            <t t-set="empty_message">No activities found</t>
                        </t>
                    </section>
                </t>
            </t>
            <t t-call="bemade_sports_clinic.sc_activity_sheets">
                <t t-set="return_url" t-value="sc_activities_return"/>
                <t t-set="can_reassign" t-value="sc_can_reassign"/>
            </t>
        </t>
    </template>

    <!-- /my/activity/create and /my/activity/<id>/edit (shell): the same
         POST routes as today (/my/activity/save, /my/activity/update). -->
    <template id="sc_app_activity_form" name="Sports Clinic App: activity form">
        <t t-call="bemade_sports_clinic.sc_app_layout">
            <t t-if="activity">
                <t t-set="sc_title">Edit Activity</t>
                <t t-set="sc_form_back" t-value="'/my/activity/%s' % activity.id"/>
            </t>
            <t t-else="">
                <t t-set="sc_title">Add Activity</t>
                <t t-set="sc_form_back" t-value="return_url"/>
            </t>
            <t t-set="sc_active_nav" t-value="'activities'"/>
            <t t-call="bemade_sports_clinic.sc_flash_banners"/>
            <form t-att-action="'/my/activity/update' if activity else '/my/activity/save'" method="post"
                  class="o_sc_card o_sc_form" data-sc-form="activity.form">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <t t-if="activity">
                    <input type="hidden" name="activity_id" t-att-value="activity.id"/>
                    <input type="hidden" name="return_url" t-att-value="sc_form_back"/>
                </t>
                <t t-else="">
                    <input type="hidden" name="model" t-att-value="model"/>
                    <input type="hidden" name="res_id" t-att-value="res_id"/>
                    <input type="hidden" name="return_url" t-att-value="return_url"/>
                    <input t-if="team_id" type="hidden" name="team_id" t-att-value="team_id"/>
                    <input t-if="clinic_event" type="hidden" name="clinic_id" t-att-value="clinic_event.id"/>
                </t>
                <div class="o_sc_field">
                    <label for="sc_act_type" class="o_sc_field_label">Activity Type</label>
                    <select id="sc_act_type" name="activity_type_id" class="o_sc_input o_sc_select" required="required">
                        <t t-set="sc_selected_type" t-value="activity.activity_type_id.id if activity else default_activity_type_id"/>
                        <t t-foreach="activity_types" t-as="atype">
                            <option t-att-value="atype.id" t-out="atype.name"
                                    t-att-selected="'selected' if atype.id == sc_selected_type else None"/>
                        </t>
                    </select>
                </div>
                <div class="o_sc_field">
                    <label for="sc_act_summary" class="o_sc_field_label">Summary</label>
                    <input type="text" id="sc_act_summary" name="summary" class="o_sc_input" required="required"
                           t-att-value="activity.summary if activity else ''"/>
                </div>
                <div class="o_sc_field">
                    <label for="sc_act_deadline" class="o_sc_field_label">Due Date</label>
                    <input type="date" id="sc_act_deadline" name="date_deadline" class="o_sc_input" required="required"
                           t-att-value="activity.date_deadline.isoformat() if activity else today"/>
                </div>
                <div class="o_sc_field">
                    <label for="sc_act_user" class="o_sc_field_label">Assigned To</label>
                    <t t-set="sc_users" t-value="available_users if activity else assignable_users"/>
                    <t t-set="sc_selected_user" t-value="activity.user_id.id if activity else default_user_id"/>
                    <select id="sc_act_user" name="user_id" class="o_sc_input o_sc_select" required="required"
                            data-sc-assignee-select="1" t-att-data-sc-no-access="sc_no_access_ids">
                        <t t-foreach="sc_users" t-as="au">
                            <option t-att-value="au.id" t-out="au.name"
                                    t-att-selected="'selected' if au.id == sc_selected_user else None"/>
                        </t>
                    </select>
                    <div class="o_sc_banner o_sc_banner_warn" data-sc-assignee-warning="1" hidden="hidden" role="status">
                        This person is not on the staff of this team and may not be able to open the activity.
                    </div>
                </div>
                <div class="o_sc_field">
                    <label for="sc_act_note" class="o_sc_field_label">Notes</label>
                    <textarea id="sc_act_note" name="note" class="o_sc_input o_sc_textarea" rows="4"
                              t-out="(activity and activity.note and activity.note.striptags()) or ''"/>
                </div>
                <div class="o_sc_form_actions">
                    <a t-att-href="sc_form_back" class="o_sc_btn o_sc_btn_ghost">Cancel</a>
                    <button type="submit" class="o_sc_btn o_sc_btn_primary" data-sc-action="activity.form.submit">Save</button>
                </div>
            </form>
        </t>
    </template>

    <!-- /my/activity/<id> (shell) -->
    <template id="sc_app_activity_detail" name="Sports Clinic App: activity detail">
        <t t-call="bemade_sports_clinic.sc_app_layout">
            <t t-set="sc_title" t-value="activity.summary or activity.activity_type_id.name"/>
            <!-- Task 1611: a save refreshes the title, the state chip and the
                 read view in place (and the app bar's overdue badge). -->
            <t t-set="sc_page_key" t-value="'mail.activity:%s' % activity.id"/>
            <t t-set="sc_active_nav" t-value="'activities'"/>
            <t t-call="bemade_sports_clinic.sc_flash_banners"/>
            <t t-set="act_state" t-value="'overdue' if activity.date_deadline &lt; today_date else ('today' if activity.date_deadline == today_date else 'planned')"/>
            <!-- Owner review 2026-10-11: the pencil edit paradigm — the
                 activity is edited in place (was a separate edit page); the
                 type stays read-only, as the edit route always treated it. -->
            <section t-attf-class="o_sc_card #{'o_sc_edit_card' if sc_activity_editable else ''}" data-sc-section="activity.detail"
                     t-att-data-sc-edit-card="'activity' if sc_activity_editable else None">
                <div class="o_sc_edit_card_head">
                    <span class="o_sc_chips" t-att-data-sc-fragment="sc_fragment_key(activity, 'chips')">
                        <span t-if="act_state == 'overdue'" class="o_sc_chip o_sc_chip_red">Overdue</span>
                        <span t-elif="act_state == 'today'" class="o_sc_chip o_sc_chip_yellow">Today</span>
                        <span t-else="" class="o_sc_chip o_sc_chip_ghost">Planned</span>
                    </span>
                    <t t-if="sc_activity_editable">
                        <t t-set="sc_edit_label">Edit</t>
                        <button type="button" class="o_sc_icon_btn" data-sc-edit-toggle="1" aria-expanded="false"
                                t-att-aria-label="sc_edit_label" t-att-title="sc_edit_label">
                            <t t-call="bemade_sports_clinic.sc_icon"><t t-set="icon" t-value="'edit'"/></t>
                        </button>
                    </t>
                </div>
                <div data-sc-edit-view="read" t-att-data-sc-fragment="sc_fragment_key(activity, 'read')">
                    <dl class="o_sc_kv">
                        <dt>Summary</dt><dd><span t-att-data-sc-display="sc_display_key(activity, 'summary')" t-out="activity.summary or '—'"/></dd>
                        <dt>Activity Type</dt><dd><span t-field="activity.activity_type_id"/></dd>
                        <dt>Due Date</dt><dd><span t-att-data-sc-display="sc_display_key(activity, 'date_deadline')" t-field="activity.date_deadline" t-options="{'widget': 'date'}"/></dd>
                        <dt>Assigned To</dt><dd><span t-att-data-sc-display="sc_display_key(activity, 'user_id')" t-out="activity.sudo().user_id.name"/></dd>
                        <!-- Task 1595: the same access-gated links as the row. -->
                        <t t-if="sc_related_links">
                            <dt>Related Record</dt>
                            <dd class="o_sc_row_links" data-sc-section="activity.related">
                                <t t-call="bemade_sports_clinic.sc_row_links"><t t-set="links" t-value="sc_related_links"/></t>
                            </dd>
                        </t>
                        <!-- Task 1595: « Créée le ». -->
                        <dt>Created</dt>
                        <dd><span data-sc-activity-created="1" t-field="activity.create_date" t-options="{'widget': 'datetime', 'hide_seconds': True}"/></dd>
                    </dl>
                    <div t-if="activity.note" class="o_sc_activity_note"><div t-field="activity.note"/></div>
                </div>
                <div t-if="sc_activity_editable" class="o_sc_fields" data-sc-edit-view="edit" hidden="hidden">
                    <t t-set="lbl">Summary</t>
                    <t t-call="bemade_sports_clinic.sc_field_autosave"><t t-set="props" t-value="sc_field_props(activity, 'summary', lbl)"/></t>
                    <t t-set="lbl">Due Date</t>
                    <t t-call="bemade_sports_clinic.sc_field_autosave"><t t-set="props" t-value="sc_field_props(activity, 'date_deadline', lbl, 'date')"/></t>
                    <t t-set="lbl">Assigned To</t>
                    <t t-call="bemade_sports_clinic.sc_field_autosave"><t t-set="props" t-value="sc_field_props(activity, 'user_id', lbl, 'select', options=sc_activity_user_options)"/></t>
                    <t t-set="lbl">Note</t>
                    <t t-call="bemade_sports_clinic.sc_field_autosave"><t t-set="props" t-value="sc_field_props(activity, 'note', lbl, 'textarea', clearable=True)"/></t>
                    <t t-call="bemade_sports_clinic.sc_edit_card_done"/>
                </div>
            </section>
            <section t-if="attachments" class="o_sc_section">
                <t t-call="bemade_sports_clinic.sc_section_header"><t t-set="title">Attachments</t></t>
                <div class="o_sc_list">
                    <t t-foreach="attachments" t-as="attachment">
                        <a t-attf-href="/my/activity/#{activity.id}/attachment/#{attachment.id}" download=""
                           class="o_sc_entity_row" t-att-data-sc-attachment="attachment.id">
                            <span class="o_sc_row_lead"><t t-call="bemade_sports_clinic.sc_icon"><t t-set="icon" t-value="'documents'"/></t></span>
                            <span class="o_sc_row_text">
                                <span class="o_sc_row_title" t-field="attachment.name"/>
                                <span class="o_sc_row_subtitle" t-out="sc_file_size(attachment.file_size)"/>
                            </span>
                        </a>
                    </t>
                </div>
            </section>
            <!-- Task 1589: Cancel / Reschedule / Done only for who may act on
                 the activity (the routes re-check). -->
            <div t-if="sc_activity_editable" class="o_sc_actionbar">
                <button type="button" class="o_sc_btn o_sc_btn_ghost" data-sc-sheet-open="sc_activity_cancel_sheet"
                        t-att-data-sc-activity-id="activity.id" data-sc-action="activity.cancel">Cancel</button>
                <button type="button" class="o_sc_btn o_sc_btn_ghost"
                        data-sc-sheet-open="sc_activity_reschedule_sheet" t-att-data-sc-activity-id="activity.id"
                        data-sc-action="activity.reschedule">Reschedule</button>
                <button type="button" class="o_sc_btn o_sc_btn_primary" data-sc-sheet-open="sc_activity_complete_sheet"
                        t-att-data-sc-activity-id="activity.id" data-sc-action="activity.complete">Done</button>
            </div>
            <t t-call="bemade_sports_clinic.sc_activity_sheets">
                <t t-set="return_url" t-value="sc_related_url or '/my/activities'"/>
