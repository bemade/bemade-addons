<?xml version="1.0" encoding="utf-8"?>
<!--
    Task 1540 (epic #1535, P3) — therapist tools on the portal app shell:
    timesheets (/my/sc/timesheets), the notepad (/my/notepad) and the team
    daily digests (/my/team/<t>/digest/<d>, /my/team/<t>/digest-history).

    Every form posts to the SAME route as today's page (CSRF token in each).
    The digest content is today's team_digest_render, UNCHANGED (also
    rendered by the backend), inside a shell card. The digest-history modal
    fragment (also the P1b team-page sheet) is untouched. No inline script /
    style.
-->
<odoo>

    <!-- /my/sc/timesheets (shell) -->
    <template id="sc_app_timesheets" name="Sports Clinic App: timesheets">
        <t t-call="bemade_sports_clinic.sc_app_layout">
            <t t-set="sc_title" t-value="sc_nav_labels['timesheets']"/>
            <t t-set="sc_active_nav" t-value="'timesheets'"/>
            <t t-call="bemade_sports_clinic.sc_flash_banners"/>

            <!-- Owner review 2026-10-14: applied on change (sc_forms.js); group
                 by in its own labelled group (it is not a filter). Task 1607:
                 the sort is in the list header, the form keeps its choice. -->
            <form method="get" action="/my/sc/timesheets" class="o_sc_filters o_sc_filters_compact" data-sc-section="timesheets.filters"
                  data-sc-autosubmit="1">
                <input t-if="sortby" type="hidden" name="sortby" t-att-value="sortby"/>
                <!-- Task 1617: open on every visit (still collapsible; no
                     remembered state — collapsing lasts for that visit). -->
                <details class="o_sc_disclosure" open="open">
                    <summary class="o_sc_disclosure_summary">
                        <t t-call="bemade_sports_clinic.sc_icon"><t t-set="icon" t-value="'filter'"/></t>
                        <span>Filters</span>
                    </summary>
                    <div class="o_sc_filter_grid">
                        <div class="o_sc_field">
                            <label for="sc_ts_search" class="o_sc_field_label">Search</label>
                            <input type="search" id="sc_ts_search" name="search" class="o_sc_input" t-att-value="search or ''"/>
                        </div>
                        <div class="o_sc_field">
                            <label for="sc_ts_from" class="o_sc_field_label">From</label>
                            <input type="date" id="sc_ts_from" name="date_from" class="o_sc_input" t-att-value="date_from or ''"/>
                        </div>
                        <div class="o_sc_field">
                            <label for="sc_ts_to" class="o_sc_field_label">To</label>
                            <input type="date" id="sc_ts_to" name="date_to" class="o_sc_input" t-att-value="date_to or ''"/>
                        </div>
                        <div class="o_sc_field">
                            <label for="sc_ts_team" class="o_sc_field_label">Team</label>
                            <select id="sc_ts_team" name="team_id" class="o_sc_input o_sc_select">
                                <option value="">All teams</option>
                                <t t-foreach="teams" t-as="team_opt">
                                    <option t-att-value="team_opt.id" t-att-selected="'selected' if team_id == team_opt.id else None" t-out="team_opt.name"/>
                                </t>
                            </select>
                        </div>
                        <!-- Owner review 2026-10-11: the legacy portal's other filters. -->
                        <div class="o_sc_field">
                            <label for="sc_ts_org" class="o_sc_field_label">Organization</label>
                            <select id="sc_ts_org" name="organization_id" class="o_sc_input o_sc_select">
                                <option value="">All organizations</option>
                                <t t-foreach="organizations" t-as="org_opt">
                                    <option t-att-value="org_opt.id" t-att-selected="'selected' if organization_id == org_opt.id else None" t-out="org_opt.name"/>
                                </t>
                            </select>
                        </div>
                    </div>
                    <fieldset class="o_sc_filter_group" data-sc-section="timesheets.group">
                        <legend class="o_sc_filter_group_title">Group by</legend>
                        <div class="o_sc_filter_grid">
                            <div class="o_sc_field">
                                <label for="sc_ts_group" class="o_sc_field_label">Group by</label>
                                <select id="sc_ts_group" name="group_by" class="o_sc_input o_sc_select">
                                    <option value="" t-att-selected="'selected' if not group_by else None">None</option>
                                    <option value="date" t-att-selected="'selected' if group_by == 'date' else None">Date</option>
                                    <option value="organization" t-att-selected="'selected' if group_by == 'organization' else None">Organization</option>
                                    <option value="team" t-att-selected="'selected' if group_by == 'team' else None">Team</option>
                                </select>
                            </div>
                        </div>
                    </fieldset>
                    <div class="o_sc_form_actions">
                        <a href="/my/sc/timesheets" class="o_sc_btn o_sc_btn_ghost">Reset</a>
                        <button type="submit" class="o_sc_btn o_sc_btn_primary" data-sc-autosubmit-fallback="1">Apply filters</button>
                    </div>
                </details>
            </form>

            <!-- Task 1607: the sort, condensed to the right of the list header
                 (was in the filter panel). -->
            <t t-call="bemade_sports_clinic.sc_list_header">
                <t t-set="header_section" t-value="'timesheets.header'"/>
                <t t-set="sc_sort_date">Date (asc)</t>
                <t t-set="sc_sort_date_desc">Date (desc)</t>
                <t t-set="sc_sort_team">Team</t>
                <t t-set="sc_sort_org">Organization</t>
                <t t-set="sc_sort_state">Status</t>
                <t t-set="sorts" t-value="sc_sort_options('sortby', [('date', sc_sort_date), ('date_desc', sc_sort_date_desc), ('team', sc_sort_team), ('org', sc_sort_org), ('state', sc_sort_state)], sortby or 'date')"/>
                <t t-set="sort_id" t-value="'sc_timesheets_sort'"/>
                <t t-set="sort_label">Sort timesheets</t>
                <t t-set="sort_section" t-value="'timesheets.sort'"/>
            </t>
            <!-- Task 1611: a read-fragment list — a time change moves the card
                 to its date group (headings and order as after a reload). -->
            <div t-if="sc_timesheet_groups" class="o_sc_list" data-sc-section="timesheets.list"
                 data-sc-fragment="page:timesheets:list" data-sc-fragment-mode="list">
                <section t-foreach="sc_timesheet_groups" t-as="group" class="o_sc_group" t-att-data-sc-group="group['key']">
                    <h3 class="o_sc_group_title" t-out="group['label']"/>
                    <t t-foreach="group['rows']" t-as="row">
                        <t t-call="bemade_sports_clinic.sc_timesheet_card">
                            <t t-set="show_event" t-value="True"/>
                        </t>
                    </t>
                </section>
            </div>
            <div t-elif="sc_timesheet_rows" class="o_sc_list" data-sc-section="timesheets.list"
                 data-sc-fragment="page:timesheets:list" data-sc-fragment-mode="list">
                <t t-foreach="sc_timesheet_rows" t-as="row">
                    <t t-call="bemade_sports_clinic.sc_timesheet_card">
                        <t t-set="show_event" t-value="True"/>
                    </t>
                </t>
            </div>
            <t t-else="" t-call="bemade_sports_clinic.sc_empty_state">
                <t t-set="message">No timesheets yet.</t>
            </t>
            <t t-call="bemade_sports_clinic.sc_timesheet_sheets">
                <t t-set="rows" t-value="sc_timesheet_rows"/>
                <t t-set="return_url" t-value="sc_timesheets_return"/>
            </t>
            <div t-if="pager and pager.get('page_count', 0) &gt; 1" class="o_sc_pager">
                <t t-call="portal.pager"/>
            </div>
        </t>
    </template>

    <!--
        The notepad's optional link selects. Variables: prefix (id prefix),
        selected (dict: team_id, patient_id, injury_id, event_id).
    -->
    <template id="sc_notepad_links" name="App shell: notepad links">
        <div class="o_sc_filter_grid">
            <div class="o_sc_field">
                <label class="o_sc_field_label" t-att-for="'%s_team' % prefix">Team</label>
                <select name="team_id" t-att-id="'%s_team' % prefix" class="o_sc_input o_sc_select">
                    <option value="">—</option>
                    <t t-foreach="teams" t-as="team_opt">
                        <option t-att-value="team_opt.id" t-att-selected="'selected' if selected.get('team_id') == team_opt.id else None" t-out="team_opt.name"/>
                    </t>
                </select>
            </div>
            <div class="o_sc_field">
                <label class="o_sc_field_label" t-att-for="'%s_patient' % prefix">Player</label>
                <t t-set="combo_empty_label">—</t>
                <t t-call="bemade_sports_clinic.portal_patient_combo">
                    <t t-set="combo_name" t-value="'patient_id'"/>
                    <t t-set="combo_id" t-value="'%s_patient' % prefix"/>
                    <t t-set="combo_class" t-value="'o_sc_input o_sc_select'"/>
                    <t t-set="combo_patients" t-value="patients"/>
                    <t t-set="combo_selected_id" t-value="selected.get('patient_id')"/>
                </t>
            </div>
            <div class="o_sc_field">
                <label class="o_sc_field_label" t-att-for="'%s_injury' % prefix">Injury</label>
                <select name="injury_id" t-att-id="'%s_injury' % prefix" class="o_sc_input o_sc_select">
                    <option value="">—</option>
                    <t t-foreach="injuries" t-as="injury_opt">
                        <option t-att-value="injury_opt.id" t-att-selected="'selected' if selected.get('injury_id') == injury_opt.id else None" t-out="injury_opt.display_name"/>
                    </t>
                </select>
            </div>
            <div class="o_sc_field">
                <label class="o_sc_field_label" t-att-for="'%s_event' % prefix">Event</label>
                <select name="event_id" t-att-id="'%s_event' % prefix" class="o_sc_input o_sc_select">
                    <option value="">—</option>
                    <t t-foreach="events" t-as="event_opt">
                        <option t-att-value="event_opt.id" t-att-selected="'selected' if selected.get('event_id') == event_opt.id else None" t-out="event_opt.name"/>
                    </t>
                </select>
            </div>
        </div>
    </template>

    <!-- A note card. Variables: row, archived. -->
    <template id="sc_quick_note_card" name="App shell: quick note card">
        <!-- Owner review 2026-10-11: the pencil edit paradigm — an open note
             is edited in place (was an « Edit » sheet with « Save »). -->
        <article t-attf-class="o_sc_card o_sc_quick_note #{'o_sc_edit_card' if not archived else ''}"
                 t-att-data-sc-quick-note-id="row['id']" t-att-id="'note-%s' % row['id']"
                 t-att-data-sc-edit-card="('quick-note-%s' % row['id']) if not archived else None">
            <div class="o_sc_edit_card_head">
                <p class="o_sc_meta" t-out="row['when']"/>
                <t t-if="not archived">
                    <t t-set="sc_edit_label">Edit</t>
                    <button type="button" class="o_sc_icon_btn" data-sc-edit-toggle="1" aria-expanded="false"
                            t-att-aria-label="sc_edit_label" t-att-title="sc_edit_label" data-sc-action="note.edit">
                        <t t-call="bemade_sports_clinic.sc_icon"><t t-set="icon" t-value="'edit'"/></t>
                    </button>
                </t>
            </div>
            <!-- Task 1611: the text and the link chips, a read fragment. -->
            <div data-sc-edit-view="read" t-att-data-sc-fragment="sc_fragment_key(row['record'], 'read')">
                <p class="o_sc_note_text o_sc_pre" t-out="row['note']"/>
                <div t-if="row['chips']" class="o_sc_chips">
                    <t t-foreach="row['chips']" t-as="chip">
                        <span class="o_sc_chip o_sc_chip_ghost" t-out="chip"/>
                    </t>
                </div>
            </div>
            <div t-if="not archived" class="o_sc_fields" data-sc-edit-view="edit" hidden="hidden">
                <t t-set="lbl">Note</t>
                <t t-call="bemade_sports_clinic.sc_field_autosave"><t t-set="props" t-value="sc_field_props(row['record'], 'note', lbl, 'textarea')"/></t>
                <t t-set="lbl">Team</t>
                <t t-call="bemade_sports_clinic.sc_field_autosave"><t t-set="props" t-value="sc_field_props(row['record'], 'team_id', lbl, 'select', options=sc_qn_options['team_id'])"/></t>
                <t t-set="lbl">Player</t>
                <t t-call="bemade_sports_clinic.sc_field_autosave"><t t-set="props" t-value="sc_field_props(row['record'], 'patient_id', lbl, 'select', options=sc_qn_options['patient_id'])"/></t>
                <t t-set="lbl">Injury</t>
                <t t-call="bemade_sports_clinic.sc_field_autosave"><t t-set="props" t-value="sc_field_props(row['record'], 'injury_id', lbl, 'select', options=sc_qn_options['injury_id'])"/></t>
                <t t-set="lbl">Event</t>
                <t t-call="bemade_sports_clinic.sc_field_autosave"><t t-set="props" t-value="sc_field_props(row['record'], 'event_id', lbl, 'select', options=sc_qn_options['event_id'])"/></t>
                <t t-call="bemade_sports_clinic.sc_edit_card_done"/>
            </div>
            <div class="o_sc_card_actions">
                <t t-if="archived">
                    <form t-att-action="'/my/notepad/%s/restore' % row['id']" method="post" class="o_sc_inline_form">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <button type="submit" class="o_sc_btn o_sc_btn_ghost o_sc_btn_sm" data-sc-action="note.restore">Restore</button>
                    </form>
                </t>
                <t t-else="">
                    <form t-att-action="'/my/notepad/%s/archive' % row['id']" method="post" class="o_sc_inline_form">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <button type="submit" class="o_sc_btn o_sc_btn_ghost o_sc_btn_sm" data-sc-action="note.archive">Done</button>
                    </form>
                </t>
                <button type="button" class="o_sc_btn o_sc_btn_danger o_sc_btn_sm" t-att-data-sc-sheet-open="'sc_qn_delete_%s' % row['id']"
                        data-sc-action="note.delete">Delete</button>
            </div>
        </article>
        <t t-call="bemade_sports_clinic.sc_confirm_sheet">
            <t t-set="sheet_id" t-value="'sc_qn_delete_%s' % row['id']"/>
            <t t-set="title">Delete the note</t>
            <t t-set="message">Delete this note for good?</t>
            <t t-set="action" t-value="'/my/notepad/%s/delete' % row['id']"/>
            <t t-set="hidden" t-value="{}"/>
            <t t-set="confirm_label">Delete</t>
            <t t-set="danger" t-value="True"/>
        </t>
    </template>

    <!-- /my/notepad (shell) -->
    <template id="sc_app_notepad" name="Sports Clinic App: notepad">
        <t t-call="bemade_sports_clinic.sc_app_layout">
            <t t-set="sc_title" t-value="sc_nav_labels['notepad']"/>
            <t t-set="sc_active_nav" t-value="'notepad'"/>
            <t t-call="bemade_sports_clinic.sc_flash_banners"/>
            <div t-if="success == 'note_added'" t-att-data-sc-draft-clear="sc_quick_note_prefix" hidden="hidden"/>

            <!-- Task 1607: « + Ajouter » right above the notes opens / closes
                 the quick-add form (docked open, as before). -->
            <t t-call="bemade_sports_clinic.sc_list_header">
                <t t-set="header_section" t-value="'notepad.header'"/>
                <t t-set="add_label">Add a note</t>
                <t t-set="add_panel" t-value="'sc_notepad_add'"/>
                <t t-set="add_open" t-value="True"/>
                <t t-set="add_key" t-value="'notepad.add'"/>
            </t>
            <details class="o_sc_card o_sc_list_add_panel" id="sc_notepad_add" data-sc-section="notepad.add" open="open">
                <summary class="o_sc_disclosure_summary"><span>Quick note</span></summary>
            <form action="/my/notepad/add" method="post" class="o_sc_form" id="quick-add" data-sc-form="note.add">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <t t-set="sc_qn_label">Quick note</t>
                <t t-set="sc_qn_placeholder">Type a note to self…</t>
                <t t-call="bemade_sports_clinic.sc_field_autosave">
                    <t t-set="props" t-value="sc_draft_props(sc_quick_note_prefix + 'note', 'note', sc_qn_label, 'textarea', placeholder=sc_qn_placeholder, required=True)"/>
                </t>
                <details class="o_sc_disclosure">
                    <summary class="o_sc_disclosure_summary"><span>Link this note (optional)</span></summary>
                    <t t-call="bemade_sports_clinic.sc_notepad_links">
                        <t t-set="prefix" t-value="'sc_qn_new'"/>
                        <t t-set="selected" t-value="{}"/>
                    </t>
                </details>
                <div class="o_sc_form_actions">
                    <button type="submit" class="o_sc_btn o_sc_btn_primary" data-sc-action="note.add">Add</button>
                </div>
            </form>
            </details>

            <div t-if="sc_note_rows" class="o_sc_list" data-sc-section="notepad.list">
                <t t-foreach="sc_note_rows" t-as="row">
                    <t t-call="bemade_sports_clinic.sc_quick_note_card">
                        <t t-set="archived" t-value="False"/>
                    </t>
                </t>
            </div>
            <t t-else="" t-call="bemade_sports_clinic.sc_empty_state">
                <t t-set="message">No note yet.</t>
            </t>

            <section class="o_sc_section" data-sc-section="notepad.archived">
                <t t-if="show_archived">
                    <t t-call="bemade_sports_clinic.sc_section_header">
                        <t t-set="title">Archived notes</t>
                        <t t-set="more_url" t-value="'/my/notepad'"/>
                        <t t-set="more_label">Hide</t>
                    </t>
                    <div t-if="sc_archived_rows" class="o_sc_list">
                        <t t-foreach="sc_archived_rows" t-as="row">
                            <t t-call="bemade_sports_clinic.sc_quick_note_card">
                                <t t-set="archived" t-value="True"/>
                            </t>
                        </t>
                    </div>
                    <t t-else="" t-call="bemade_sports_clinic.sc_empty_state">
                        <t t-set="message">No archived note.</t>
                    </t>
                </t>
                <a t-elif="archived_count" href="/my/notepad?show_archived=1" class="o_sc_btn o_sc_btn_ghost o_sc_btn_sm"
                   data-sc-action="notepad.archived">
                    <span>Archived notes</span>
                    <span class="o_sc_chip o_sc_chip_ghost" t-out="archived_count"/>
                </a>
            </section>
        </t>
    </template>

    <!-- /my/team/<t>/digest/<d> (shell) -->
    <template id="sc_app_team_digest" name="Sports Clinic App: team digest">
        <t t-call="bemade_sports_clinic.sc_app_layout">
            <t t-set="sc_title">Daily digest</t>
            <t t-set="sc_active_nav" t-value="'teams'"/>
            <!-- Task 1614: the legacy page's « Snapshot of … » line, and the
                 Bootstrap digest re-themed by o_sc_legacy (player names were
                 white on white in dark mode). -->
            <p class="o_sc_meta" data-sc-section="digest.snapshot" t-out="digest._sc_snapshot_line()"/>
            <div class="o_sc_card o_sc_legacy o_sc_digest_body" data-sc-section="digest.body">
                <t t-call="bemade_sports_clinic.team_digest_render">
                    <t t-set="players" t-value="players"/>
                    <t t-set="announcement" t-value="announcement"/>
                </t>
            </div>
            <a t-attf-href="/my/team/#{team.id}/digest-history" class="o_sc_btn o_sc_btn_ghost o_sc_btn_sm" data-sc-action="digest.history">
                <t t-call="bemade_sports_clinic.sc_icon"><t t-set="icon" t-value="'history'"/></t>
                <span>Digest history</span>
            </a>
        </t>
    </template>

    <!-- /my/team/<t>/digest/<d>/body (task 1614): one day's body alone, the
         lazy body of its row in the digest history. data-sc-lazy-filled keeps
         the shell's loader from swapping a day without links for « Nothing to
         show. »; an empty day carries .o_sc_empty (team_digest_render). -->
    <template id="sc_digest_body" name="Sports Clinic App: digest body fragment">
        <div class="o_sc_digest_fragment" data-sc-lazy-filled="1">
            <p class="o_sc_meta" data-sc-section="digest.snapshot" t-out="digest._sc_snapshot_line()"/>
            <t t-call="bemade_sports_clinic.team_digest_render">
                <t t-set="players" t-value="players"/>
                <t t-set="announcement" t-value="announcement"/>
            </t>
        </div>
    </template>

    <!-- /my/team/<t>/digest-history (shell, full page) -->
    <template id="sc_app_team_digest_history" name="Sports Clinic App: team digest history">
        <t t-call="bemade_sports_clinic.sc_app_layout">
            <t t-set="sc_title">Digest history</t>
            <t t-set="sc_active_nav" t-value="'teams'"/>
            <!-- Task 1614: each date expands in place; its body (the same
                 role re-gated team_digest_render as the day's page) is fetched
                 on first open. The subtitle = the day's counts. -->
            <div t-if="sc_digest_rows" class="o_sc_list" data-sc-section="digest.history">
                <t t-foreach="sc_digest_rows" t-as="row">
                    <details class="o_sc_expand o_sc_digest_row" t-att-data-sc-digest-row="row['id']"
                             t-att-data-sc-lazy-url="row['body_url']">
                        <summary class="o_sc_entity_row">
                            <span class="o_sc_row_lead"><t t-call="bemade_sports_clinic.sc_icon"><t t-set="icon" t-value="'summary'"/></t></span>
                            <span class="o_sc_row_text">
                                <span class="o_sc_row_title" t-out="row['label']"/>
                                <span class="o_sc_row_subtitle" t-out="row['subtitle']"/>
                            </span>
                            <span class="o_sc_row_trailing">
                                <t t-call="bemade_sports_clinic.sc_icon"><t t-set="icon" t-value="'down'"/></t>
                            </span>
                        </summary>
                        <div class="o_sc_expand_body">
                            <div class="o_sc_legacy o_sc_lazy_body">
                                <p class="o_sc_empty o_sc_lazy_loading">Loading…</p>
                            </div>
                            <a t-att-href="row['url']" class="o_sc_section_more" data-sc-action="digest.open"
                               t-att-data-sc-digest-id="row['id']">Open this day</a>
                        </div>
                    </details>
                </t>
            </div>
            <t t-else="" t-call="bemade_sports_clinic.sc_empty_state">
                <t t-set="message">No digest recorded yet.</t>
            </t>
            <div t-if="pager and pager.get('page_count', 0) &gt; 1" class="o_sc_pager">
                <t t-call="portal.pager"/>
            </div>
        </t>
    </template>

</odoo>
