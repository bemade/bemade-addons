<?xml version="1.0" encoding="utf-8"?>
<!--
    Task 1538 (epic #1535) — portal app shell components.

    Small QWeb partials styled by static/src/scss/sc_components.scss (brand
    tokens in sc_tokens.scss). Only rendered inside sc_app_layout, whose root
    carries .o_sc_app — every selector is scoped under it, so nothing here
    touches today's portal. No inline style / script in these templates.

    Calling convention: set the documented variables in the t-call body;
    ``0`` (the t-call body) is the trailing / extra content where noted.
-->
<odoo>

    <!-- Inline SVG icons (stroke = currentColor). ``icon``: a registry key. -->
    <template id="sc_icon" name="App shell: icon">
        <svg viewBox="0 0 24 24" class="o_sc_icon" aria-hidden="true" focusable="false">
            <t t-if="icon == 'teams'"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></t>
            <t t-elif="icon == 'players'"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></t>
            <t t-elif="icon == 'clinic'"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></t>
            <t t-elif="icon == 'activities'"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></t>
            <t t-elif="icon in ('bookings', 'calendar')"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></t>
            <t t-elif="icon == 'note'"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M8 13h8M8 17h5"/></t>
            <t t-elif="icon in ('timesheet', 'clock')"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></t>
            <t t-elif="icon == 'summary'"><path d="M4 19V5M4 19h16M8 15v-4M12 15V8M16 15v-6"/></t>
            <t t-elif="icon == 'account'"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></t>
            <t t-elif="icon == 'security'"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></t>
            <t t-elif="icon == 'settings'"><path d="M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M1 14h6M9 8h6M17 16h6"/></t>
            <t t-elif="icon == 'documents'"><path d="M3 7h18v13H3zM8 7V4h8v3"/></t>
            <t t-elif="icon == 'backend'"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></t>
            <t t-elif="icon == 'logout'"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/></t>
            <t t-elif="icon == 'back'"><path d="M15 18l-6-6 6-6"/></t>
            <t t-elif="icon == 'chevron'"><path d="M9 18l6-6-6-6"/></t>
            <t t-elif="icon == 'search'"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></t>
            <t t-elif="icon == 'moon'"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></t>
            <t t-elif="icon == 'sun'"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></t>
            <t t-elif="icon == 'up'"><path d="M18 15l-6-6-6 6"/></t>
            <t t-elif="icon == 'down'"><path d="M6 9l6 6 6-6"/></t>
            <t t-elif="icon == 'install'"><rect x="6" y="2" width="12" height="20" rx="2"/><path d="M12 7v7M9 11l3 3 3-3M10 18h4"/></t>
            <t t-elif="icon == 'history'"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5M12 7v5l3 2"/></t>
            <t t-elif="icon == 'megaphone'"><path d="M3 11v2a1 1 0 0 0 1 1h2l5 4V6L6 10H4a1 1 0 0 0-1 1zM15 9a3 3 0 0 1 0 6M18 6a7 7 0 0 1 0 12"/></t>
            <t t-elif="icon == 'plus'"><path d="M12 5v14M5 12h14"/></t>
            <t t-elif="icon == 'close'"><path d="M18 6L6 18M6 6l12 12"/></t>
            <t t-elif="icon == 'share'"><path d="M12 3v12M8 7l4-4 4 4"/><path d="M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-7"/></t>
            <t t-elif="icon == 'user'"><circle cx="12" cy="8" r="4"/><path d="M6 21v-1a6 6 0 0 1 12 0v1"/></t>
            <t t-elif="icon == 'archive'"><path d="M21 8v13H3V8"/><path d="M1 3h22v5H1z"/><path d="M10 12h4"/></t>
            <t t-elif="icon == 'edit'"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></t>
            <t t-elif="icon == 'trash'"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6"/></t>
            <t t-elif="icon == 'download'"><path d="M12 3v12M7 10l5 5 5-5M5 21h14"/></t>
            <t t-elif="icon == 'upload'"><path d="M12 21V9M7 14l5-5 5 5M5 3h14"/></t>
            <t t-elif="icon == 'injury'"><rect x="3" y="7" width="18" height="14" rx="2"/><path d="M8 7V4h8v3M12 11v6M9 14h6"/></t>
            <t t-elif="icon == 'phone'"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.9 2z"/></t>
            <t t-elif="icon == 'mail'"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></t>
            <t t-elif="icon == 'check'"><path d="M20 6L9 17l-5-5"/></t>
            <t t-elif="icon == 'filter'"><path d="M22 3H2l8 9.5V19l4 2v-8.5z"/></t>
            <t t-elif="icon == 'sort'"><path d="M7 4v16M3 16l4 4 4-4M17 20V4M13 8l4-4 4 4"/></t>
            <t t-else=""><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/></t>
        </svg>
    </template>

    <!-- The Fit Crew « F » mark: the silver chrome icon (brand « Effet Chrome / Argent »). -->
    <template id="sc_logo_mark" name="App shell: logo mark">
        <img src="/bemade_sports_clinic/static/src/img/sc_logo_chrome.png" class="o_sc_logo_mark" alt="" width="192" height="192"/>
    </template>

    <!--
        List row. Variables: href, title, subtitle, dot (red|yellow|green|False),
        lead (short text badge instead of a dot, e.g. an icon key via lead_icon),
        row_attrs (dict of extra attributes), chevron (default True),
        row_status / row_changed (player rows: sc_player_status_line).
        Body (0) = trailing chips.
    -->
    <template id="sc_entity_row" name="App shell: entity row">
        <a t-att-href="href" class="o_sc_entity_row" t-att="row_attrs or {}">
            <span t-if="dot" t-attf-class="o_sc_dot o_sc_tone_#{dot}" aria-hidden="true"/>
            <span t-elif="lead_icon" class="o_sc_row_lead"><t t-call="bemade_sports_clinic.sc_icon"><t t-set="icon" t-value="lead_icon"/></t></span>
            <span t-else="" class="o_sc_row_lead o_sc_row_lead_empty" aria-hidden="true"/>
            <span class="o_sc_row_text">
                <span class="o_sc_row_title" t-out="title"/>
                <span t-if="subtitle" class="o_sc_row_subtitle" t-out="subtitle"/>
                <t t-if="row_status or row_changed" t-call="bemade_sports_clinic.sc_player_status_line"/>
            </span>
            <span class="o_sc_row_trailing">
                <t t-out="0"/>
                <t t-if="chevron is not False" t-call="bemade_sports_clinic.sc_icon"><t t-set="icon" t-value="'chevron'"/></t>
            </span>
        </a>
    </template>

    <!-- Player row status line, under the name so it never crowds the row on
         a phone: the legacy card's Match / Practice badges, active-injury
         count and ⚡ recent-changes flag. Variables: row_status (from
         sports.patient._sc_row_status, optional), row_changed (bool). -->
    <template id="sc_player_status_line" name="App shell: player status line">
        <t t-set="sc_injuries_title">Active injuries</t>
        <span class="o_sc_row_status">
            <t t-if="row_status">
                <t t-foreach="row_status['pills']" t-as="pill">
                    <span t-attf-class="o_sc_status_pill o_sc_chip_#{pill['tone']}" t-att-title="pill['title']"><i t-if="pill['icon']" t-attf-class="fa #{pill['icon']}" aria-hidden="true"/> <t t-out="pill['label']"/></span>
                </t>
                <span t-if="row_status['injuries']" class="o_sc_injury_count" t-att-title="sc_injuries_title"><i class="fa fa-chain-broken" aria-hidden="true"/> <t t-out="row_status['injuries']"/></span>
            </t>
            <t t-if="row_changed" t-call="bemade_sports_clinic.sc_recent_pill"/>
        </span>
    </template>

    <!-- The legacy card's ⚡ « Changements récents » flag. -->
    <template id="sc_recent_pill" name="App shell: recent changes pill">
        <span class="o_sc_recent_pill"><i class="fa fa-bolt" aria-hidden="true"/> Recent changes</span>
    </template>

    <!-- Status chip. Variables: tone (red|yellow|green|mauve|ghost), label. -->
    <template id="sc_status_chip" name="App shell: status chip">
        <span t-attf-class="o_sc_chip o_sc_chip_#{tone or 'ghost'}" t-out="label"/>
    </template>

    <!-- Stat tile. Variables: tone (red|yellow|green), value, label. -->
    <template id="sc_stat_tile" name="App shell: stat tile">
        <div t-attf-class="o_sc_stat o_sc_tone_#{tone or 'neutral'}">
            <span class="o_sc_stat_value" t-out="value"/>
            <span class="o_sc_stat_label" t-out="label"/>
        </div>
    </template>

    <!-- Card. Body (0) = content. Variable: card_class (extra classes). -->
    <template id="sc_card" name="App shell: card">
        <div t-attf-class="o_sc_card #{card_class or ''}">
            <t t-out="0"/>
        </div>
    </template>

    <!-- Section header. Variables: title, more_url, more_label. -->
    <template id="sc_section_header" name="App shell: section header">
        <h2 class="o_sc_section_header">
            <span t-out="title"/>
            <a t-if="more_url" t-att-href="more_url" class="o_sc_section_more" t-out="more_label"/>
        </h2>
    </template>

    <!--
        Task 1607 — the list header: ONE line directly above a list, the same
        on every page (the app bar carries no list action any more).
        « + Ajouter » on the left — always that label; add_label (the full
        action, « Add Injury », « Create a player »…) is its accessible name —
        and the sort, condensed into a menu, on the right. Variables (all
        optional; nothing set renders nothing):
          add_label      the full action (aria-label / title)
          add_url        a link …
          add_sheet      … or the id of the sheet (dialog) it opens …
          add_panel      … or the id of the inline <details> it opens / closes
                         (the panel follows the header; sc_list_header.js)
          add_open       add_panel only: the panel renders open
          add_key        data-sc-action of the add control
          count          a short count text (« 12 player(s) »)
          sorts          [{key, label, url, active}] (sc_sort_options), the
                         menu's links; sort_id (unique on the page, the
                         popup's id), sort_label (« Sort players »),
                         sort_section (data-sc-section of the menu)
          header_section data-sc-section of the header line
          header_fragment its read-fragment key (task 1611), when a save
                         can change what it offers
    -->
    <template id="sc_list_header" name="App shell: list header">
        <div t-if="add_label or sorts or count or header_fragment" class="o_sc_list_header"
             t-att-data-sc-section="header_section or None"
             t-att-data-sc-fragment="header_fragment or None">
            <t t-if="add_label">
                <t t-set="sc_add_text">Add</t>
                <a t-if="add_url" t-att-href="add_url" class="o_sc_btn o_sc_btn_primary o_sc_btn_sm o_sc_list_add"
                   t-att-data-sc-action="add_key or None" t-att-aria-label="add_label" t-att-title="add_label">
                    <t t-call="bemade_sports_clinic.sc_icon"><t t-set="icon" t-value="'plus'"/></t>
                    <span class="o_sc_list_add_label" t-out="sc_add_text"/>
                </a>
                <button t-elif="add_sheet" type="button" class="o_sc_btn o_sc_btn_primary o_sc_btn_sm o_sc_list_add"
                        t-att-data-sc-sheet-open="add_sheet" t-att-data-sc-action="add_key or None"
                        t-att-aria-label="add_label" t-att-title="add_label">
                    <t t-call="bemade_sports_clinic.sc_icon"><t t-set="icon" t-value="'plus'"/></t>
                    <span class="o_sc_list_add_label" t-out="sc_add_text"/>
                </button>
                <button t-elif="add_panel" type="button" class="o_sc_btn o_sc_btn_primary o_sc_btn_sm o_sc_list_add"
                        t-att-aria-controls="add_panel" t-att-aria-expanded="'true' if add_open else 'false'"
                        data-sc-list-add-toggle="1" t-att-data-sc-action="add_key or None"
                        t-att-aria-label="add_label" t-att-title="add_label">
                    <t t-call="bemade_sports_clinic.sc_icon"><t t-set="icon" t-value="'plus'"/></t>
                    <span class="o_sc_list_add_label" t-out="sc_add_text"/>
                </button>
            </t>
            <span t-if="count" class="o_sc_meta o_sc_list_header_count" t-out="count"/>
            <div t-if="sorts" class="o_sc_sort_menu" t-att-data-sc-section="sort_section or None">
                <t t-set="sc_sort_current" t-value="([s for s in sorts if s['active']] or sorts)[0]"/>
                <button type="button" class="o_sc_sort_toggle" data-sc-menu-toggle="1" aria-haspopup="menu"
                        aria-expanded="false" t-att-aria-controls="sort_id">
                    <t t-call="bemade_sports_clinic.sc_icon"><t t-set="icon" t-value="'sort'"/></t>
                    <span class="visually-hidden" t-out="sort_label"/>
                    <span class="o_sc_sort_current" t-out="sc_sort_current['label']"/>
                </button>
                <div t-att-id="sort_id" class="o_sc_menu_popup o_sc_sort_popup" role="menu" data-sc-menu-popup="1"
                     t-att-aria-label="sort_label" hidden="hidden">
                    <a t-foreach="sorts" t-as="sort" t-att-href="sort['url']" role="menuitemradio"
                       class="o_sc_menu_item" t-att-data-sc-sort="sort['key']"
                       t-att-aria-checked="'true' if sort['active'] else 'false'">
                        <t t-call="bemade_sports_clinic.sc_icon"><t t-set="icon" t-value="'check'"/></t>
                        <span t-out="sort['label']"/>
                    </a>
                </div>
            </div>
        </div>
    </template>

    <!--
        Owner review 2026-10-10 — an inline-editable card: read view by
        default, ONE pencil (data-sc-edit-toggle) reveals the card's autosave
        fields (data-sc-edit-view="edit"), « Done » (data-sc-edit-done) hides
        them again (sc_app_ui.js). Read values carry data-sc-display hooks
        that a save updates in place. This is the card head. Variables:
        title, editable.
    -->
    <template id="sc_edit_card_head" name="App shell: edit card head">
        <div class="o_sc_edit_card_head">
            <h3 class="o_sc_edit_card_title" t-out="title"/>
            <button t-if="editable" type="button" class="o_sc_icon_btn" data-sc-edit-toggle="1"
                    aria-expanded="false" aria-label="Edit" title="Edit">
                <t t-call="bemade_sports_clinic.sc_icon"><t t-set="icon" t-value="'edit'"/></t>
            </button>
        </div>
    </template>

    <!-- « Done » of an edit card's edit view. -->
    <template id="sc_edit_card_done" name="App shell: edit card done">
        <div class="o_sc_form_actions">
            <button type="button" class="o_sc_btn o_sc_btn_primary o_sc_btn_sm" data-sc-edit-done="1">Done</button>
        </div>
    </template>

    <!-- A read-view row. Variables: label, record, field; optional
         href_kind ('tel' / 'mailto', task 1585): the value is a tap-to-call /
         tap-to-email link (no href while empty — « — » is not a link);
         data-sc-display-href lets a save move the href (sc_app_ui.js). -->
    <template id="sc_display_row" name="App shell: display row">
        <dt t-out="label"/>
        <dd>
            <t t-if="href_kind">
                <t t-set="sc_shown" t-value="sc_display(record, field)"/>
                <a class="o_sc_contact_link" t-att-href="sc_contact_href(href_kind, sc_shown)"
                   t-att-data-sc-display-href="href_kind"
                   t-att-data-sc-display="sc_display_key(record, field)" t-out="sc_shown or '—'"/>
            </t>
            <span t-else="" t-att-data-sc-display="sc_display_key(record, field)" t-out="sc_display(record, field) or '—'"/>
        </dd>
    </template>

    <!-- Empty state. Variable: message. -->
    <template id="sc_empty_state" name="App shell: empty state">
        <p class="o_sc_empty" t-out="message"/>
    </template>

    <!-- Task 1581: ONE history entry for every history of the shell (team
         announcement, training recommendation, injury notes):
         « <date> <time> · <Full Name> · <action chip> », then the body; an
         empty body reads « Cleared ». Built by AppShellMixin._sc_history_entry
         (same date-time format as the treatment notes, viewer's tz).
         Variable: entry = {when, author, action, tone, body, state, scope?}. -->
    <template id="sc_history_entry" name="App shell: history entry">
        <li class="o_sc_history_entry" t-att-data-sc-history-state="entry['state'] or None"
            t-att-data-sc-scope="entry.get('scope') or None">
            <div class="o_sc_meta o_sc_history_meta">
                <span class="o_sc_history_when" t-out="entry['when']"/>
                <t t-if="entry['author']"> · <span class="o_sc_history_author" t-out="entry['author']"/></t>
                <t t-if="entry['action']"> · <span t-attf-class="o_sc_chip o_sc_chip_#{entry['tone']}" t-out="entry['action']"/></t>
            </div>
            <p t-if="entry['body']" class="o_sc_pre o_sc_history_body" t-out="entry['body']"/>
            <p t-else="" class="o_sc_muted o_sc_history_cleared">Cleared</p>
        </li>
    </template>

    <!-- Task 1581: a history sheet's body (the lazy, fresh-on-every-open
         fragment): optional filters (0), the entries, or the empty state.
         Variables: entries, empty_message, section (data-sc-section). -->
    <template id="sc_history_list" name="App shell: history list">
        <div class="o_sc_history_fragment" t-att-data-sc-section="section or None">
            <t t-out="0"/>
            <ol t-if="entries" class="o_sc_history">
                <t t-foreach="entries" t-as="entry" t-call="bemade_sports_clinic.sc_history_entry"/>
            </ol>
            <p t-else="" class="o_sc_empty" t-out="empty_message"/>
        </div>
    </template>

    <!-- Banner. Variables: title, tone (info|warn). Body (0) = text. -->
    <template id="sc_banner" name="App shell: banner">
        <div t-attf-class="o_sc_banner o_sc_banner_#{tone or 'info'}" role="status">
            <strong t-if="title" class="o_sc_banner_title" t-out="title"/>
            <t t-out="0"/>
        </div>
    </template>

    <!--
        Task 1542 — bottom sheet (phone) / centred dialog (laptop), a native
        <dialog> opened by any [data-sc-sheet-open="<sheet_id>"] control
        (static/src/js/sc_app_ui.js). Variables: sheet_id, title,
        lazy_url (optional: body fetched once, on first open, through
        sc_fetch), lazy_fresh (optional: fetched again on every open, for a
        history the page itself can change). Body (0) = content (ignored when lazy_url is set; a
        loading line is shown until the fetch answers).
    -->
    <template id="sc_sheet" name="App shell: sheet">
        <dialog t-att-id="sheet_id" class="o_sc_sheet" t-att-aria-labelledby="'%s_title' % sheet_id"
                t-att-data-sc-lazy-url="lazy_url or None"
                t-att-data-sc-lazy-fresh="'1' if lazy_url and lazy_fresh else None">
            <div class="o_sc_sheet_head">
                <h2 class="o_sc_sheet_title" t-att-id="'%s_title' % sheet_id" t-out="title"/>
                <button type="button" class="o_sc_icon_btn" data-sc-sheet-close="1" aria-label="Close" title="Close">
                    <t t-call="bemade_sports_clinic.sc_icon"><t t-set="icon" t-value="'close'"/></t>
                </button>
            </div>
            <div t-attf-class="o_sc_sheet_body #{'o_sc_legacy' if lazy_url else ''}">
                <p t-if="lazy_url" class="o_sc_empty o_sc_lazy_loading">Loading…</p>
                <t t-else="" t-out="0"/>
            </div>
        </dialog>
    </template>

    <!--
        Task 1542 — segmented page tabs (deep-linkable). Variables: tabs =
        [(key, label, url[, aliases])], active (key). Task 1539: the optional
        4th item lists legacy #fragment names that open this tab (e.g. the
        player page's « #patient-info » after a POST round-trip). Every tab is a real link (the
        server renders the active panel); sc_app_ui.js switches panels in
        place and keeps ?tab= in the address bar. Panels:
        <section data-sc-tab-panel="key">.
    -->
    <template id="sc_page_tabs" name="App shell: page tabs">
        <nav t-attf-class="o_sc_segmented o_sc_segmented_full o_sc_page_tabs #{'o_sc_page_tabs_scroll' if len(tabs) &gt; 4 else ''}" role="tablist" data-sc-tabs="1">
            <t t-foreach="tabs" t-as="tab">
                <a t-att-href="tab[2]" role="tab" t-att-data-sc-tab="tab[0]"
                   t-att-data-sc-tab-aliases="tab[3] if len(tab) &gt; 3 and tab[3] else None"
                   t-att-aria-selected="'true' if tab[0] == active else 'false'"
                   t-att-aria-pressed="'true' if tab[0] == active else 'false'" t-out="tab[1]"/>
            </t>
        </nav>
    </template>


    <!--
        Task 1539 — read-only field (label + value) where the viewer may not
        edit. Variables: label, value, pre (keep line breaks), empty (text
        when no value, default « — »).
    -->
    <template id="sc_field_static" name="App shell: static field">
        <div class="o_sc_field o_sc_field_static">
            <span class="o_sc_field_label"><span t-out="label"/>
                <button t-if="history_sheet" type="button" class="o_sc_link_btn o_sc_field_history"
                        t-att-data-sc-sheet-open="history_sheet" t-out="history_label"/>
            </span>
            <p t-if="value" t-attf-class="o_sc_field_value #{'o_sc_pre' if pre else ''}" t-out="value"/>
            <p t-else="" class="o_sc_field_value o_sc_muted" t-out="empty or '—'"/>
            <small t-if="static_hint" class="o_sc_hint" t-out="static_hint"/>
        </div>
    </template>

    <!--
        Task 1539 — autosave field: the server-mode sc_autosave_field (label,
        « Effacer », save state, conflict banner). Variable: props (the JSON
        from sc_field_props(record, field, label, input_type, …) or
        sc_draft_props(key, name, label, …)).
    -->
    <template id="sc_field_autosave" name="App shell: autosave field">
        <owl-component name="bemade_sports_clinic.sc_autosave_field" t-att-props="props"/>
    </template>

    <!--
        Task 1539 — confirm sheet (delete an injury, a document, cancel an
        activity…): a sc_sheet holding ONE POST form. Variables: sheet_id,
        title, message, action, hidden (dict name -> value), confirm_label,
        danger (bool). Body (0) = extra fields inside the form.
    -->
    <template id="sc_confirm_sheet" name="App shell: confirm sheet">
        <t t-call="bemade_sports_clinic.sc_sheet">
            <t t-set="lazy_url" t-value="False"/>
            <form t-att-action="action" method="post" class="o_sc_form">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <t t-foreach="(hidden or {}).items()" t-as="hid">
                    <input type="hidden" t-att-name="hid[0]" t-att-value="hid[1]"/>
                </t>
                <p t-if="message" class="o_sc_confirm_message" t-out="message"/>
                <t t-out="0"/>
                <div class="o_sc_form_actions">
                    <button type="button" class="o_sc_btn o_sc_btn_ghost" data-sc-sheet-close="1">Cancel</button>
                    <button type="submit" t-attf-class="o_sc_btn #{'o_sc_btn_danger' if danger else 'o_sc_btn_primary'}"
                            data-sc-confirm-submit="1" t-out="confirm_label"/>
                </div>
            </form>
        </t>
    </template>

    <!--
        Task 1539 — document row. Variables: doc (sports.injury.document),
        download_url, delete_sheet (dialog id of the delete confirm, or
        False), meta (subtitle text). Task 1616: optional edit_toggle (the
        pencil of the enclosing per-document edit card) and fragment_key
        (the text is a read fragment refreshed by a save of the document).
    -->
    <template id="sc_document_row" name="App shell: document row">
        <div class="o_sc_entity_row o_sc_entity_row_static o_sc_doc_row" t-att-data-sc-document-id="doc.id">
            <span class="o_sc_row_lead"><t t-call="bemade_sports_clinic.sc_icon"><t t-set="icon" t-value="'documents'"/></t></span>
            <span class="o_sc_row_text" t-att-data-sc-fragment="fragment_key or None">
                <span class="o_sc_row_title" t-out="doc.name"/>
                <span class="o_sc_row_subtitle" t-out="meta"/>
                <span t-if="doc.description" class="o_sc_row_subtitle" t-out="doc.description"/>
            </span>
            <span class="o_sc_row_trailing">
                <button t-if="edit_toggle" type="button" class="o_sc_icon_btn" data-sc-edit-toggle="1"
                        aria-expanded="false" data-sc-action="documents.edit" aria-label="Edit" title="Edit">
                    <t t-call="bemade_sports_clinic.sc_icon"><t t-set="icon" t-value="'edit'"/></t>
                </button>
                <a t-att-href="download_url" class="o_sc_icon_btn" data-sc-action="documents.download"
                   aria-label="Download" title="Download">
                    <t t-call="bemade_sports_clinic.sc_icon"><t t-set="icon" t-value="'download'"/></t>
                </a>
                <button t-if="delete_sheet" type="button" class="o_sc_icon_btn o_sc_icon_btn_danger"
                        t-att-data-sc-sheet-open="delete_sheet" data-sc-action="documents.delete"
                        aria-label="Delete" title="Delete">
                    <t t-call="bemade_sports_clinic.sc_icon"><t t-set="icon" t-value="'trash'"/></t>
                </button>
            </span>
        </div>
    </template>

    <!--
        Task 1539 — treatment-note card: text, author initials + date, the
        « modifié » stamp, the linked injury. Variables: note, injury_url
        (link of the linked injury or False), edit_props (list of the JSON
        props of the note's server autosave fields — note, date, injury (task
        1587) — when the viewer may edit it, else False).
    -->
    <template id="sc_note_card" name="App shell: note card">
        <!-- Owner review 2026-10-11: an editable note is a pencil card. -->
        <article t-attf-class="o_sc_card o_sc_note_card #{'o_sc_edit_card' if edit_props else ''}" t-att-data-sc-note-id="note.id"
                 t-att-data-sc-edit-card="('note-%s' % note.id) if edit_props else None">
            <!-- Task 1611: the meta line and the « modified » stamp are read
                 fragments (a save of the note — or of its linked injury's
                 diagnosis — refreshes them in place). -->
            <div class="o_sc_meta o_sc_note_meta" t-att-data-sc-fragment="sc_fragment_key(note, 'meta')">
                <span t-out="note.portal_when_label"/>
                <span>·</span>
                <span class="o_sc_note_author" t-out="note.sudo().user_id.name"/>
                <t t-if="note.injury_id">
                    <span>·</span>
                    <a t-if="injury_url" t-att-href="injury_url" t-out="note.injury_id.diagnosis or note.injury_id.display_name"/>
                    <span t-else="" t-out="note.injury_id.diagnosis"/>
                </t>
                <t t-else="">
                    <span t-out="'·'"/>
                    <span>General note</span>
                </t>
            </div>
            <t t-if="edit_props">
                <t t-set="sc_edit_label">Edit</t>
                <div class="o_sc_note_body">
                    <p class="o_sc_pre o_sc_note_text" data-sc-edit-view="read"
                       t-att-data-sc-display="sc_display_key(note, 'note')" t-out="note.note"/>
                    <button type="button" class="o_sc_icon_btn" data-sc-edit-toggle="1" aria-expanded="false"
                            t-att-aria-label="sc_edit_label" t-att-title="sc_edit_label">
                        <t t-call="bemade_sports_clinic.sc_icon"><t t-set="icon" t-value="'edit'"/></t>
                    </button>
                </div>
                <div class="o_sc_fields" data-sc-edit-view="edit" hidden="hidden">
                    <t t-foreach="edit_props" t-as="field_props">
                        <t t-call="bemade_sports_clinic.sc_field_autosave">
                            <t t-set="props" t-value="field_props"/>
                        </t>
                    </t>
                    <t t-call="bemade_sports_clinic.sc_edit_card_done"/>
                </div>
            </t>
            <p t-else="" class="o_sc_pre o_sc_note_text" t-out="note.note"/>
            <div class="o_sc_note_stamp" t-att-data-sc-fragment="sc_fragment_key(note, 'stamp')">
                <p t-if="note.modified_label" class="o_sc_meta o_sc_note_modified" t-att-title="note.modified_by_name"
                   t-out="note.modified_label"/>
            </div>
        </article>
    </template>

    <!--
        Task 1595 — LINK ROW: a list row with ONE main link plus secondary
        links / chips, without nesting anchors. Shared by the activity rows
        and meant for the player rows with their team links + expand control
        (#1593) and the activities clock chip on player / team / event rows
        and injury cards (#1592).

        How it works: the row is a plain container (not an <a>); the TITLE is
        the main <a>, whose ::after is stretched over the whole row (the
        Bootstrap « stretched link » pattern, no JS) — a tap anywhere on the
        row opens ``href``. Every other <a> / <button> / <summary> / form
        control inside the row is layered above it, so it gets its own tap.
        Keyboard: the main link is one tab stop (its focus ring outlines the
        whole row), each secondary link / control its own; screen readers
        read the main link's text (the title), then the rest as plain text.

        Slots (variables set in the t-call body):
          href          main target (required)
          title         main link text (required)
          main_attrs    dict of extra attributes of the main <a> (data-*, aria-label…)
          title_parts   optional split title (owner review 2026-10-14): a list of
                        {text[, url, model]} segments; a segment with ``url`` is
                        its own link (e.g. the related record's name in an
                        activity title), layered above the main link, which
                        then carries the whole title as its aria-label (never
                        an <a> inside an <a>)
          subtitle      text or markup (a t-set body) under the title — never
                        put a link here, use ``links`` or ``meta``
          dot / lead_icon   leading dot tone (red|yellow|green) or sc_icon key, as sc_entity_row
          meta          optional markup under the subtitle (t-set body): chips,
                        status lines, extra links (layered above automatically)
          links         list of secondary links on their own line under the text:
                        dicts {label|name, url (False → plain text), icon (sc_icon
                        key, optional), title (tooltip, optional), model (data
                        attribute, optional)} — see sc_row_links
          row_class     extra classes of the row container
          row_attrs     dict of extra attributes of the row container
          chevron       trailing chevron (default True)
          body (0)      trailing content: chips, counts, icon buttons / links
                        (each clickable on its own, the rest of the row opens href)
    -->
    <template id="sc_link_row" name="App shell: link row">
        <div t-attf-class="o_sc_entity_row o_sc_link_row #{row_class or ''}" t-att="row_attrs or {}">
            <span t-if="dot" t-attf-class="o_sc_dot o_sc_tone_#{dot}" aria-hidden="true"/>
            <span t-elif="lead_icon" class="o_sc_row_lead"><t t-call="bemade_sports_clinic.sc_icon"><t t-set="icon" t-value="lead_icon"/></t></span>
            <span t-else="" class="o_sc_row_lead o_sc_row_lead_empty" aria-hidden="true"/>
            <span class="o_sc_row_text">
                <span t-if="title_parts and any(part.get('url') for part in title_parts)"
                      class="o_sc_row_title o_sc_row_title_split" data-sc-title-split="1">
                    <a t-att-href="href" class="o_sc_link_row_main" t-att-aria-label="title" t-att="main_attrs or {}"/>
                    <t t-foreach="title_parts" t-as="title_part">
                        <a t-if="title_part.get('url')" t-att-href="title_part['url']" class="o_sc_row_title_link"
                           t-att-data-sc-title-link="title_part.get('model') or '1'" t-out="title_part['text']"/>
                        <span t-else="" t-out="title_part['text']"/>
                    </t>
                </span>
                <a t-else="" t-att-href="href" class="o_sc_link_row_main o_sc_row_title" t-att="main_attrs or {}" t-out="title"/>
                <span t-if="subtitle" class="o_sc_row_subtitle" t-out="subtitle"/>
                <t t-if="meta" t-out="meta"/>
                <span t-if="links" class="o_sc_row_links" data-sc-row-links="1">
                    <t t-call="bemade_sports_clinic.sc_row_links"/>
                </span>
            </span>
            <span class="o_sc_row_trailing">
                <t t-out="0"/>
                <t t-if="chevron is not False" t-call="bemade_sports_clinic.sc_icon"><t t-set="icon" t-value="'chevron'"/></t>
            </span>
        </div>
    </template>

    <!-- Task 1595 — the secondary links of a link row (or any « record
         links » line, e.g. the activity detail's related record). Variable:
         links (see sc_link_row). A link without url is plain text. -->
    <template id="sc_row_links" name="App shell: row links">
        <t t-foreach="links" t-as="row_link">
            <t t-set="row_link_label" t-value="row_link.get('label') or row_link.get('name')"/>
            <a t-if="row_link.get('url')" t-att-href="row_link['url']" class="o_sc_row_link"
               t-att-title="row_link.get('title')" t-att-data-sc-row-link="row_link.get('model') or '1'">
                <t t-if="row_link.get('icon')" t-call="bemade_sports_clinic.sc_icon"><t t-set="icon" t-value="row_link['icon']"/></t>
                <span t-out="row_link_label"/>
            </a>
            <span t-else="" class="o_sc_row_link o_sc_row_link_plain" t-att-title="row_link.get('title')"
                  t-att-data-sc-row-link-plain="row_link.get('model') or '1'">
                <t t-if="row_link.get('icon')" t-call="bemade_sports_clinic.sc_icon"><t t-set="icon" t-value="row_link['icon']"/></t>
                <span t-out="row_link_label"/>
            </span>
        </t>
    </template>

    <!--
        Task 1593 — the legacy card's always-on lines of a player row: the
        training recommendation on ONE line (truncated; whole in the expanded
        detail) and « Retour prévu » for an injured player (the date, « — »
        when unset). Variable: row (_sc_player_row_extras keys).
    -->
    <template id="sc_player_row_lines" name="App shell: player row lines">
        <span t-if="row.get('training')" class="o_sc_row_line o_sc_row_training" data-sc-row-training="1">
            <i class="fa fa-graduation-cap" aria-hidden="true"/>
            <span class="o_sc_row_line_text" t-out="row['training']"/>
        </span>
        <span t-if="row.get('return_label')" class="o_sc_row_line o_sc_row_return" data-sc-row-return="1">
            <i class="fa fa-clock-o" aria-hidden="true"/>
            <span>Predicted return:</span>
            <span class="o_sc_row_line_value" t-out="row['return_label']"/>
        </span>
    </template>

    <!--
        Task 1593 — PLAYER ROW (roster, dashboard « to watch », /my/players):
        a link row (sc_link_row) carrying the legacy card's content — the
        name opens the player page, the teams are separate links (none on a
        team's own page), the Match / Practice / injuries status line, the
        training recommendation and « Retour prévu » lines, and a « Details »
        control that expands the active-injury detail UNDER the row,
        lazy-loaded from ``row['detail_url']`` (sc_app_ui.js) — never
        rendered for every row.

        Variables: row (from _sc_player_row / _sc_players_values: id, url,
        title, subtitle, dot, status, changed, pending_removal, training,
        return_label, team_links, detail_url), row_scope (a short key making
        the detail's id unique when one player is listed twice on a page).
        Body (0) = extra trailing chips.
    -->
    <template id="sc_player_row" name="App shell: player row">
        <t t-set="sc_row_detail_id" t-value="'sc-row-detail-%s-%s' % (row_scope or 'row', row['id'])"/>
        <div class="o_sc_row_group o_sc_player_row" t-att-data-sc-player-id="row['id']">
            <t t-call="bemade_sports_clinic.sc_link_row">
                <t t-set="href" t-value="row['url']"/>
                <t t-set="dot" t-value="row['dot']"/>
                <t t-set="title" t-value="row['title']"/>
                <t t-set="subtitle" t-value="row['subtitle']"/>
                <t t-set="links" t-value="row.get('team_links')"/>
                <t t-set="meta">
                    <t t-call="bemade_sports_clinic.sc_player_status_line">
                        <t t-set="row_status" t-value="row.get('status')"/>
                        <t t-set="row_changed" t-value="row.get('changed')"/>
                    </t>
                    <t t-call="bemade_sports_clinic.sc_player_row_lines"/>
                    <button t-if="row.get('detail_url')" type="button" class="o_sc_row_expand"
                            t-att-data-sc-row-expand="sc_row_detail_id" t-att-aria-controls="sc_row_detail_id"
                            aria-expanded="false">
                        <span>Details</span>
                        <t t-call="bemade_sports_clinic.sc_icon"><t t-set="icon" t-value="'down'"/></t>
                    </button>
                </t>
                <t t-call="bemade_sports_clinic.sc_activity_clock">
                    <t t-set="clock" t-value="row.get('clock')"/>
                </t>
                <t t-out="0"/>
                <t t-if="row.get('pending_removal')" t-call="bemade_sports_clinic.sc_status_chip">
                    <t t-set="tone" t-value="'ghost'"/>
                    <t t-set="label">Removal pending</t>
                </t>
            </t>
            <div t-if="row.get('detail_url')" t-att-id="sc_row_detail_id" class="o_sc_row_detail"
                 t-att-data-sc-lazy-url="row['detail_url']" data-sc-row-detail="1" hidden="hidden">
                <div class="o_sc_lazy_body">
                    <p class="o_sc_empty o_sc_lazy_loading">Loading…</p>
                </div>
            </div>
        </div>
    </template>

    <!--
        Task 1592 — ACTIVITY CLOCK chip of a player / team / event row or an
        injury card: a clock + the number of activities assigned to the
        viewer on that record (total), red when at least one of them is
        overdue, neutral otherwise; nothing at 0. A link to the record's own
        activities section. Variable: clock (_sc_activity_clocks: count,
        overdue, url, label), None / False = no chip. Put it in a link row's
        trailing body (sc_link_row lifts it above the row's main link) —
        never inside another <a>.
    -->
    <template id="sc_activity_clock" name="App shell: activity clock">
        <a t-if="clock and clock.get('count')" t-att-href="clock['url']"
           t-attf-class="o_sc_chip o_sc_activity_clock o_sc_chip_#{'red' if clock.get('overdue') else 'ghost'}"
           t-att-data-sc-activity-clock="clock['count']"
           t-att-data-sc-activity-overdue="str(clock.get('overdue') or 0)"
           t-att-aria-label="clock['label']" t-att-title="clock['label']">
            <t t-call="bemade_sports_clinic.sc_icon"><t t-set="icon" t-value="'clock'"/></t>
            <span t-out="clock['count']"/>
        </a>
    </template>

    <!--
        Task 1539 — activity row with its due-date state chip. Variables:
        activity, today_date, related_links (sc_activity_related: the
        access-gated related-record links, task 1595), show_assignee,
        can_reassign. Actions open the shared sheets (sc_activity_sheets)
        through sc_activities.js.
        Task 1595: a link row (sc_link_row) — the title opens the activity,
        the related player / team / event / injury link opens that record;
        the activity type shows in the subtitle when a summary is the title.
    -->
    <template id="sc_activity_row" name="App shell: activity row">
        <t t-set="act_state" t-value="'overdue' if activity.date_deadline &lt; today_date else ('today' if activity.date_deadline == today_date else 'planned')"/>
        <!-- ONE card, actions inside it (owner review 2026-10-10: same UX as
             the other tabs' cards). -->
        <div class="o_sc_card o_sc_activity" t-att-data-sc-activity-row="activity.id" t-att-data-sc-activity-state="act_state">
            <t t-call="bemade_sports_clinic.sc_link_row">
                <t t-set="href" t-value="'/my/activity/%s' % activity.id"/>
                <t t-set="title" t-value="activity.summary or activity.activity_type_id.name"/>
                <!-- Owner review 2026-10-14: the related record's name in the
                     title is a link to it too (same access-gated URL). -->
                <t t-set="title_parts" t-value="sc_activity_title_parts(title, related_links)"/>
                <t t-set="dot" t-value="'red' if act_state == 'overdue' else ('yellow' if act_state == 'today' else 'green')"/>
                <t t-set="subtitle">
                    <span t-if="activity.summary and activity.activity_type_id" class="o_sc_activity_type"
                          t-out="activity.activity_type_id.name"/>
                    <t t-if="activity.summary and activity.activity_type_id"> · </t>
                    <span t-field="activity.date_deadline" t-options="{'widget': 'date'}"/>
                    <t t-if="show_assignee and activity.user_id"> · <t t-out="activity.user_id.name"/></t>
                </t>
                <t t-set="links" t-value="related_links"/>
                <span t-if="act_state == 'overdue'" class="o_sc_chip o_sc_chip_red">Overdue</span>
                <span t-elif="act_state == 'today'" class="o_sc_chip o_sc_chip_yellow">Today</span>
                <span t-else="" class="o_sc_chip o_sc_chip_ghost">Planned</span>
            </t>
            <!-- Task 1589: actions only for who may act on the activity. -->
            <div t-if="sc_activity_can_act(activity)" class="o_sc_card_actions o_sc_activity_actions">
                <button type="button" class="o_sc_btn o_sc_btn_ghost o_sc_btn_sm" data-sc-sheet-open="sc_activity_complete_sheet"
                        t-att-data-sc-activity-id="activity.id" data-sc-action="activity.complete">
                    <t t-call="bemade_sports_clinic.sc_icon"><t t-set="icon" t-value="'check'"/></t>
                    <span>Done</span>
                </button>
                <button type="button" class="o_sc_btn o_sc_btn_ghost o_sc_btn_sm" data-sc-sheet-open="sc_activity_reschedule_sheet"
                        t-att-data-sc-activity-id="activity.id" data-sc-action="activity.reschedule">
                    <span>Reschedule</span>
                </button>
                <button t-if="can_reassign" type="button" class="o_sc_btn o_sc_btn_ghost o_sc_btn_sm"
                        data-sc-sheet-open="sc_activity_reassign_sheet" data-sc-action="activity.reassign"
                        t-att-data-sc-activity-id="activity.id" t-att-data-sc-current-user="activity.user_id.name or ''">
                    <span>Reassign</span>
                </button>
                <button type="button" class="o_sc_btn o_sc_btn_ghost o_sc_btn_sm" data-sc-sheet-open="sc_activity_cancel_sheet"
                        t-att-data-sc-activity-id="activity.id" data-sc-action="activity.cancel">
                    <span>Cancel</span>
                </button>
            </div>
        </div>
    </template>

</odoo>
