<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field
      name="name"
    >res.config.settings.view.form.inherit.mail_signature_position</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mail.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@id='discuss']" position="inside">
                <setting
          id="mail_signature_position_setting"
          string="Signature Position"
          company_dependent="1"
          help="Where your signature goes when you Reply All or Forward a message from the chatter."
        >
                    <field name="mail_signature_position" widget="radio" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
