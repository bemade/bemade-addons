#. module: bemade_mail_gateway
#: model_terms:ir.actions.act_window,help:bemade_mail_gateway.action_bemade_mail_gateway_token
msgid ""
"Tokens authenticate external mail relays (notably the\n"
"                    <code>odoo-mail-gateway</code> sidecar) into this Odoo's\n"
"                    <code>mail.thread.message_process</code>, without consuming\n"
"                    a billable user license."
msgstr ""
"Les jetons authentifient les relais courriel externes (notamment le\n"
"                    conteneur <code>odoo-mail-gateway</code>) auprès de\n"
"                    <code>mail.thread.message_process</code> de cet Odoo, sans consommer\n"
"                    de licence utilisateur facturable."

