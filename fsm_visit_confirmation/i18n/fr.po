"                                Confirmer la visite\n"
"                            </a>\n"
"                        </td>\n"
"                        <td style=\"border-style:none;box-sizing:border-box;border-left-width:0px;border-bottom-width:0px;border-right-width:0px;border-top-width:0px;padding:10px;text-align:center\">\n"
