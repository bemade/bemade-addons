"                            <t t-set=\"base_url\" t-value=\"object.get_base_url()\"></t>\n"
"                            <t t-set=\"lang\" t-value=\"object.work_order_contacts and object.work_order_contacts[0].lang or object.partner_id.lang or 'en_US'\"></t>\n"
