<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="helpdesk_team_view_form" model="ir.ui.view">
        <field name="name">helpdesk.team.form.mail.send.as</field>
        <field name="model">helpdesk.team</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_team_view_form" />
        <field name="arch" type="xml">
            <field name="alias_contact" position="after">
                <br />
                <label for="mail_send_as_alias_id" />
                <field
          name="mail_send_as_alias_id"
          placeholder="Team alias"
          options="{'no_create': True}"
        />
            </field>
        </field>
    </record>
</odoo>
