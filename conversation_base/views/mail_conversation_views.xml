<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="mail_conversation_view_form" model="ir.ui.view">
        <field name="name">mail.conversation.view.form</field>
        <field name="model">mail.conversation</field>
        <field name="arch" type="xml">
            <form string="Conversation">
                <header>
                    <button
            name="action_triage_handle"
            type="object"
            string="Handled"
            invisible="my_handled"
            help="Remove this conversation from your list only."
          />
                    <button
            name="action_triage_unhandle"
            type="object"
            string="Back to my list"
            invisible="not my_handled"
          />
                    <button
            name="action_triage_done"
            type="object"
            string="Done"
            class="btn-primary"
            invisible="state == 'done'"
            help="Close this conversation for the whole team."
          />
                    <button
            name="action_triage_reopen"
            type="object"
            string="Reopen"
            invisible="state != 'done'"
          />
                    <button
            name="action_triage_unsnooze"
            type="object"
            string="Unsnooze"
            invisible="not my_snoozed and state != 'snoozed'"
          />
                    <field name="my_handled" invisible="1" />
                    <field name="my_snoozed" invisible="1" />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="name" placeholder="Conversation subject..." />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="state" />
                            <field name="user_id" />
                            <field name="team_id" />
                        </group>
                        <group>
                            <field name="tag_ids" widget="many2many_tags" />
                            <field name="primary_transport_id" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Linked Records" name="links">
                            <field name="link_ids">
                                <list editable="bottom">
                                    <field name="res_model" />
                                    <field name="res_id" />
                                    <field name="reason" />
                                </list>
                            </field>
                        </page>
                        <page string="Participants" name="participants">
                            <field name="participant_ids">
                                <list editable="bottom">
                                    <field name="partner_id" />
                                    <field name="email" />
                                    <field name="kind" />
                                    <field name="role" />
                                </list>
                            </field>
                        </page>
                        <page string="Members" name="members">
                            <field name="member_ids">
                                <list editable="bottom">
                                    <field name="user_id" />
                                    <field name="is_handled" />
                                    <field name="unread" />
                                    <field name="snooze_until" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="mail_conversation_view_list" model="ir.ui.view">
        <field name="name">mail.conversation.view.list</field>
        <field name="model">mail.conversation</field>
        <field name="arch" type="xml">
            <list string="Conversations">
                <field name="name" />
                <field name="state" />
                <field name="user_id" />
                <field name="team_id" />
                <field name="tag_ids" widget="many2many_tags" />
            </list>
        </field>
    </record>

    <record id="mail_conversation_view_search" model="ir.ui.view">
        <field name="name">mail.conversation.view.search</field>
        <field name="model">mail.conversation</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field
          name="participant_ids"
          string="Contact"
          filter_domain="['|', ('participant_ids.email', 'ilike', self), ('participant_ids.partner_id', 'ilike', self)]"
        />
                <field name="user_id" />
                <field name="team_id" />
                <field name="tag_ids" />
                <field name="primary_transport_id" string="Channel" />
                <filter
          name="filter_my_inbox"
          string="My Inbox"
          domain="[('state', '=', 'open'), ('my_handled', '=', False), ('my_snoozed', '=', False)]"
        />
                <separator />
                <filter
          name="filter_open"
          string="Open"
          domain="[('state', '=', 'open')]"
        />
                <filter
          name="filter_waiting"
          string="Waiting"
          domain="[('state', '=', 'waiting')]"
        />
                <filter
          name="filter_done"
          string="Done"
          domain="[('state', '=', 'done')]"
        />
                <filter
          name="filter_snoozed_team"
          string="Snoozed (team)"
          domain="[('state', '=', 'snoozed')]"
        />
                <separator />
                <filter
          name="filter_my_handled"
          string="Handled by me"
          domain="[('my_handled', '=', True)]"
        />
                <filter
          name="filter_my_snoozed"
          string="Snoozed by me"
          domain="[('my_snoozed', '=', True)]"
        />
                <separator />
                <filter
          name="filter_unread"
          string="Unread"
          domain="[('my_unread', '=', True)]"
        />
                <filter
          name="filter_unanswered"
          string="Unanswered"
          domain="[('unanswered', '=', True)]"
        />
                <filter
          name="filter_unassigned"
          string="Unassigned"
          domain="[('unassigned', '=', True)]"
        />
                <filter
          name="filter_my"
          string="My Conversations"
          domain="[('user_id', '=', uid)]"
        />
                <filter
          name="filter_has_attachment"
          string="Has Attachment"
          domain="[('message_ids.attachment_ids', '!=', False)]"
        />
                <separator />
                <filter
          name="filter_last_activity"
          string="Last Activity"
          date="last_activity"
        />
                <group>
                    <filter
            name="groupby_state"
            string="State"
            context="{'group_by': 'state'}"
          />
                    <filter
            name="groupby_team"
            string="Team"
            context="{'group_by': 'team_id'}"
          />
                    <filter
            name="groupby_user"
            string="Assignee"
            context="{'group_by': 'user_id'}"
          />
                </group>
            </search>
        </field>
    </record>

    <record id="mail_conversation_action" model="ir.actions.act_window">
        <field name="name">Conversations</field>
        <field name="res_model">mail.conversation</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_my_inbox': 1, 'conversation_mark_read': 1}</field>
    </record>

    <menuitem id="menu_mail_conversation_root" name="Conversations" sequence="60" />
    <menuitem
    id="menu_mail_conversation"
    name="Conversations"
    parent="menu_mail_conversation_root"
    action="mail_conversation_action"
    sequence="10"
  />
</odoo>
