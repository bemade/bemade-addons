<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="conversation_base.SnoozeDialog">
        <Dialog title="title" size="'md'">
            <div class="o_conversation_snooze_dialog d-flex flex-column gap-2">
                <div class="d-flex flex-column gap-1">
                    <t t-foreach="presets" t-as="preset" t-key="preset.key">
                        <button
              type="button"
              class="btn btn-secondary text-start"
              t-attf-data-preset="{{ preset.key }}"
              t-on-click="() => this.confirm(preset.value)"
            >
                            <t t-esc="preset.label" />
                        </button>
                    </t>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span>Pick a date and time:</span>
                    <DateTimeInput
            type="'datetime'"
            value="state.custom"
            onApply.bind="onCustomChange"
            minDate="'today'"
          />
                </div>
                <div class="form-check">
                    <input
            type="checkbox"
            id="o_conversation_snooze_team"
            class="form-check-input"
            t-model="state.team"
          />
                    <label class="form-check-label" for="o_conversation_snooze_team">For the whole team</label>
                </div>
            </div>
            <t t-set-slot="footer">
                <button
          type="button"
          class="btn btn-primary o_conversation_snooze_confirm"
          t-on-click="() => this.confirm(state.custom)"
        >Snooze</button>
                <button type="button" class="btn btn-secondary" t-on-click="props.close">Cancel</button>
            </t>
        </Dialog>
    </t>
</templates>
