<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t
    t-name="conversation_base.TriageListView"
    t-inherit="web.ListView"
    t-inherit-mode="primary"
  >
        <xpath expr="//SelectionBox" position="after">
            <button
        type="button"
        class="btn btn-secondary o_conversation_snooze_selection"
        t-on-click="onClickSnooze"
      >Snooze…</button>
            <button
        type="button"
        class="btn btn-secondary o_conversation_assign_selection"
        t-on-click="onClickAssign"
      >Assign…</button>
        </xpath>
    </t>
</templates>
