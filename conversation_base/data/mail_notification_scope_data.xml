<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!-- Conversations only ever notify internal users, in-app. An admin can
         opt out by unticking "Conversation" in Settings > Discuss (the rule
         is archived, not deleted, so this record is not recreated). -->
    <record
    id="mail_notification_scope_mail_conversation"
    model="mail.notification.scope"
  >
        <field name="model_id" ref="model_mail_conversation" />
    </record>
</odoo>
