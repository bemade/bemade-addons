<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_form_inherit" model="ir.ui.view">
        <field name="name">res.partner.form.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <field name="company_type" position="after">
                <br/>
                <field name="is_odoo_user"/>
Odoo User
                <field name="is_odoo_partner"/>
Odoo Partner
                <br/>
                <div invisible="not is_odoo_partner">
                    <h3><field name="odoo_partner_type"/> Partner</h3>
                </div>
            </field>
            <group name="container_row_2" position="after">
                <group name="container_row_3" string="Odoo Partner Relations">
                    <field name="relation_left_ids" string="As Partner Of" nolabel="1">
                        <list>
                            <field name="right_partner_id" string="Customer" options="{'no_create': True}"/>
                            <field name="type_id"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="active" column_invisible="1"/>
                        </list>
                    </field>
                    <field name="relation_right_ids" string="As Client Of" nolabel="1">
                        <list>
                            <field name="left_partner_id" string="Partner" options="{'no_create': True}"/>
                            <field name="type_id"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="active" column_invisible="1"/>
                        </list>
                    </field>
                </group>
            </group>
        </field>

    </record>

    <record id="view_partner_tree_inherit" model="ir.ui.view">
        <field name="name">res.partner.tree.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="is_odoo_user"/>
                <field name="is_odoo_partner"/>
                <field name="odoo_partner_type"/>
            </xpath>
        </field>
    </record>

    <record id="view_partner_kanban_inherit" model="ir.ui.view">
        <field name="name">res.partner.kanban.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.res_partner_kanban_view"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="inside">
                <field name="odoo_partner_type"/>
                <field name="color"/>
            </xpath>
            <xpath expr="//t[@t-name='card']" position="attributes">
                <attribute name="t-attf-class">flex-row #{record.color.raw_value ? 'oe_kanban_color_' + record.color.raw_value : ''}</attribute>
            </xpath>
            <xpath expr="//field[@name='complete_name']" position="after">
                <span t-if="record.odoo_partner_type.raw_value" class="badge text-bg-info ms-2">
                    <field name="odoo_partner_type"/>
                </span>
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="view_res_partner_odoo_search">
        <field name="name">res.partner.odoo.search</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <filter name="type_company" position="after">
                <filter domain="[('is_odoo_partner','=','True')]" string="Odoo Partners" name="res_partner_odoo_partner_filter"/>
                <filter domain="[('is_odoo_user','=','True')]" string="Odoo Users" name="res_partner_odoo_user_filter"/>
            </filter>
        </field>
    </record>

</odoo>
