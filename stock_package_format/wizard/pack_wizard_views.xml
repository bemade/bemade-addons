<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="pack_wizard_view_form" model="ir.ui.view">
        <field name="name">stock.package.format.pack.wizard.form</field>
        <field name="model">stock.package.format.pack.wizard</field>
        <field name="arch" type="xml">
            <form string="Pack by format">
                <p class="text-muted">
                    One package per format unit, one lot per package. Add a row to split a
                    line between lots or formats.
                </p>
                <field name="move_ids" invisible="1" />
                <field name="picking_ids" invisible="1" />
                <field name="validate" invisible="1" />
                <field name="line_ids">
                    <list editable="bottom">
                        <field
              name="move_id"
              domain="[('id', 'in', parent.move_ids)]"
              options="{'no_create': True, 'no_open': True}"
            />
                        <field name="product_id" />
                        <field name="allowed_format_ids" column_invisible="True" />
                        <field
              name="format_uom_id"
              required="1"
              options="{'no_create': True, 'no_open': True}"
            />
                        <field name="package_count" />
                        <field name="quantity" />
                        <field name="product_uom_id" />
                        <field name="lot_name" required="1" />
                    </list>
                </field>
                <group>
                    <field name="print_labels" />
                </group>
                <footer>
                    <button
            name="action_confirm"
            type="object"
            class="btn-primary"
            string="Pack and validate"
            invisible="not validate"
          />
                    <button
            name="action_confirm"
            type="object"
            class="btn-primary"
            string="Pack"
            invisible="validate"
          />
                    <button special="cancel" string="Cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
