<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="open_wizard_view_form" model="ir.ui.view">
        <field name="name">stock.package.format.open.wizard.form</field>
        <field name="model">stock.package.format.open.wizard</field>
        <field name="arch" type="xml">
            <form string="Open packages">
                <group>
                    <field name="package_ids" widget="many2many_tags" readonly="1" />
                    <field name="reason" placeholder="e.g. Fill a customer tank" />
                </group>
                <footer>
                    <button
            name="action_confirm"
            type="object"
            class="btn-primary"
            string="Open"
          />
                    <button special="cancel" string="Cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
