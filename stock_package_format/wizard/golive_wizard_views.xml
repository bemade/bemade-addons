<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="golive_wizard_view_form" model="ir.ui.view">
        <field name="name">stock.package.format.golive.wizard.form</field>
        <field name="model">stock.package.format.golive.wizard</field>
        <field name="arch" type="xml">
            <form string="Pack existing stock">
                <p class="text-muted">
                    Count the product, then enter its packages: N × format with the lot
                    written on them. The loose stock is replaced by these packages through
                    an inventory adjustment. Loose stock you do not pack stays usable as loose.
                </p>
                <group>
                    <group>
                        <field name="product_id" options="{'no_create': True}" />
                        <field name="location_id" options="{'no_create': True}" />
                    </group>
                    <group>
                        <field name="loose_quantity" />
                        <field name="packed_quantity" />
                        <field name="product_uom_id" />
                    </group>
                </group>
                <field name="line_ids">
                    <list editable="bottom">
                        <field name="allowed_format_ids" column_invisible="True" />
                        <field
              name="format_uom_id"
              options="{'no_create': True, 'no_open': True}"
            />
                        <field name="package_count" />
                        <field name="lot_name" />
                        <field name="quantity" />
                    </list>
                </field>
                <field name="allowed_format_ids" invisible="1" />
                <group name="rest">
                    <group>
                        <field
              name="rest_format_uom_id"
              options="{'no_create': True, 'no_open': True}"
            />
                        <field
              name="rest_lot_name"
              invisible="not rest_format_uom_id"
              required="rest_format_uom_id and rest_package_count &gt; 0"
            />
                    </group>
                    <group invisible="not rest_format_uom_id">
                        <field name="rest_package_count" />
                        <field name="rest_leftover" />
                    </group>
                </group>
                <p class="text-muted" invisible="not rest_format_uom_id">
                    After the rows, the loose stock left is packed into
                    <field name="rest_package_count" class="oe_inline fw-bold" />
                    whole package(s) of the rest format;
                    <field name="rest_leftover" class="oe_inline fw-bold" />
                    <field
            name="product_uom_id"
            class="oe_inline"
            options="{'no_open': True}"
          />
                    stay(s) loose.
                </p>
                <footer>
                    <button
            name="action_confirm"
            type="object"
            class="btn-primary"
            string="Pack"
          />
                    <button special="cancel" string="Cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
