<odoo>
    <record id="view_module_tree_filter_inherit" model="ir.ui.view">
        <field name="name">ir.module.module.tree.filter.inherit</field>
        <field name="model">ir.module.module</field>
        <field name="inherit_id" ref="base.module_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='state']" position="after">
                <!-- Nouveau filtre pour Linked -->
                <filter name="linked" string="Linked" domain="[('state', '=', 'linked')]"/>
                <!-- Nouveau filtre pour Linkable -->
                <filter name="linkable" string="Linkable" domain="[('state', '=', 'linkable')]"/>
            </xpath>
        </field>
    </record>
</odoo>